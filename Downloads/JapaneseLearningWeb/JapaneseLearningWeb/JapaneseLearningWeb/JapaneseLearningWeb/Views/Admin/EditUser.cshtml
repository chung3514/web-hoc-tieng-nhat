@model EditUserViewModel

@{
    ViewData["Title"] = "Sửa Người dùng";
}

<style>
    :root {
        --teal: #17b6b7;
        --teal-hover: #0ba0a1;
    }

    .user-edit-container {
        max-width: 800px;
    }

    .card {
        border: none;
        border-radius: 16px;
        box-shadow: 0 4px 18px rgba(0,0,0,0.06);
    }

    .card-header {
        background: var(--teal);
        color: #fff;
        border-radius: 16px 16px 0 0;
        padding: 16px 22px;
        font-weight: 700;
    }

    .card-body {
        padding: 26px;
    }

    .form-label {
        font-weight: 600;
        color: #333;
    }

    .form-control,
    .form-select {
        border-radius: 10px;
        border: 1.5px solid #dbecec;
        font-size: 1.05rem;
        padding: 10px 14px;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: var(--teal);
            box-shadow: 0 0 0 0.15rem rgba(23,182,183,.25);
        }

    .btn-save {
        background: var(--teal);
        color: #fff;
        font-weight: 600;
        border-radius: 30px;
        padding: 8px 28px;
    }

        .btn-save:hover {
            background: var(--teal-hover);
            color: #fff;
        }

    .btn-back {
        background: #6c757d;
        color: #fff;
        font-weight: 600;
        border-radius: 30px;
        padding: 8px 28px;
    }

        .btn-back:hover {
            background: #565e64;
            color: #fff;
        }

    @@media (max-width: 576px) {
        .card-body {
            padding: 20px;
        }
    }
</style>

<div class="container user-edit-container my-4">
    <div class="card">

        <!-- HEADER -->
        <div class="card-header">
            <i class="fas fa-user-edit me-2"></i>Sửa Người dùng
        </div>

        <!-- BODY -->
        <div class="card-body">
            <form method="post" novalidate>
                @Html.AntiForgeryToken()

                <!-- Username -->
                <div class="mb-3">
                    <label for="UserName" class="form-label">
                        <i class="fas fa-user me-1 text-teal"></i>Tên đăng nhập
                    </label>
                    <input type="text"
                           id="UserName"
                           name="UserName"
                           value="@Model.UserName"
                           class="form-control"
                           required />
                </div>

                <!-- Email -->
                <div class="mb-3">
                    <label for="Email" class="form-label">
                        <i class="fas fa-envelope me-1 text-teal"></i>Email
                    </label>
                    <input type="email"
                           id="Email"
                           name="Email"
                           value="@Model.Email"
                           class="form-control"
                           required />
                </div>

                <!-- Role -->
                <div class="mb-4">
                    <label for="Role" class="form-label">
                        <i class="fas fa-user-shield me-1 text-teal"></i>Vai trò
                    </label>
                    <select id="Role"
                            name="Role"
                            class="form-select"
                            required>
                        <option value="Admin" selected="@(Model.Roles.Contains("Admin") ? "selected" : null)">Admin</option>
                        <option value="Employee" selected="@(Model.Roles.Contains("Employee") ? "selected" : null)">Nhân viên</option>
                        <option value="User" selected="@(Model.Roles.Contains("User") ? "selected" : null)">Người dùng</option>
                    </select>
                </div>

                <!-- ACTION -->
                <div class="d-flex justify-content-center gap-3 mt-4">
                    <button type="submit" class="btn btn-save">
                        <i class="fas fa-save me-1"></i>Lưu
                    </button>

                    <a href="@Url.Action("UserManagement", "Admin")" class="btn btn-back">
                        <i class="fas fa-arrow-left me-1"></i>Quay lại
                    </a>
                </div>
            </form>
        </div>

    </div>
</div>
