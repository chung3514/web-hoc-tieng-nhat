@model List<UserRoleViewModel>

@{
    ViewData["Title"] = "Quản lý người dùng";
}

@section Styles {
    <style>
        :root {
            --teal: #17b6b7;
            --teal-hover: #0ba0a1;
        }

        /* ⚠️ KHÔNG ĐỤNG body để tránh ảnh hưởng navbar */
        .user-page {
            font-family: 'Montserrat', sans-serif;
            font-size: 14.5px;
            font-weight: 400;
            color: #334155;
        }

        .main-content {
            max-width: 1100px;
            margin: 24px auto;
            background: #fff;
            border-radius: 20px;
            padding: 24px;
            box-shadow: 0 6px 24px rgba(23,182,183,0.12);
        }

        /* HEADER */
        .card-header {
            background: var(--teal);
            color: #fff;
            border-radius: 16px;
            padding: 14px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

            .card-header h2 {
                margin: 0;
                font-size: 18px;
                font-weight: 600;
            }

        .btn-add-user {
            background: #fff;
            color: var(--teal);
            border-radius: 999px;
            padding: 6px 14px;
            font-size: 13px;
            font-weight: 600;
            border: 2px solid var(--teal);
            text-decoration: none;
            transition: .2s;
        }

            .btn-add-user:hover {
                background: var(--teal);
                color: #fff;
            }

        /* TABLE */
        table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0 8px;
            margin-top: 16px;
            font-size: 14px;
        }

        thead th {
            font-weight: 600;
            color: #0f766e;
            padding: 8px 12px;
            text-align: left;
        }

        tbody tr {
            background: #f0fdfd;
            border-radius: 12px;
        }

        tbody td {
            padding: 10px 12px;
            vertical-align: middle;
            font-weight: 400;
        }

        /* ROLE BADGE */
        .role-pill {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 999px;
            font-size: 13px;
            font-weight: 500;
            line-height: 1;
            white-space: nowrap;
        }

        .role-admin {
            background: rgba(23,182,183,0.15);
            color: #0f766e;
        }

        .role-user {
            background: rgba(59,130,246,0.12);
            color: #1d4ed8;
        }

        .role-employee {
            background: rgba(234,179,8,0.18);
            color: #92400e;
        }

        /* FORM */
        select.form-select {
            font-size: 13px;
            border-radius: 10px;
            padding: 6px 10px;
            font-weight: 400;
        }

        /* BUTTONS */
        .btn-update {
            background: var(--teal);
            color: #fff;
            border: none;
            padding: 6px 12px;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 600;
        }

        .btn-edit {
            background: #facc15;
            border: none;
            padding: 6px 12px;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 600;
            color: #92400e;
        }

        .btn-delete {
            background: #ef4444;
            border: none;
            padding: 6px 12px;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 600;
            color: #fff;
        }
    </style>
}

<div class="user-page">
    <div class="main-content">

        <!-- HEADER -->
        <div class="card-header">
            <h2>👥 Quản lý người dùng</h2>
            <a href="/Admin/CreateUser" class="btn-add-user">+ Thêm người dùng</a>
        </div>

        <!-- TABLE -->
        <table>
            <thead>
                <tr>
                    <th>Tên đăng nhập</th>
                    <th>Email</th>
                    <th>Role hiện tại</th>
                    <th>Thay đổi role</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    var role = user.Roles.FirstOrDefault() ?? "User";

                    <tr>
                        <td>@user.UserName</td>
                        <td>@user.Email</td>
                        <td>
                            <span class="role-pill role-@role.ToLower()">@role</span>
                        </td>
                        <td>
                            <form method="post" asp-action="UpdateUserRole" class="d-flex gap-2">
                                <input type="hidden" name="userId" value="@user.UserId" />

                                <!-- ✅ FIX LỖI ADMIN HIỂN THỊ -->
                                <select name="role" class="form-select">
                                    <option value="Admin" selected="@(role == "Admin")">Admin</option>
                                    <option value="Employee" selected="@(role == "Employee")">Employee</option>
                                    <option value="User" selected="@(role == "User")">User</option>
                                </select>

                                <button type="submit" class="btn-update">Cập nhật</button>
                            </form>
                        </td>
                        <td class="d-flex gap-2">
                            <a class="btn-edit"
                               href="@Url.Action("EditUser","Admin",new { userId = user.UserId })">
                                Sửa
                            </a>

                            <form method="post"
                                  asp-action="DeleteUser"
                                  onsubmit="return confirm('Xóa người dùng này?')">
                                <input type="hidden" name="userId" value="@user.UserId" />
                                <button type="submit" class="btn-delete">Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </div>
</div>
