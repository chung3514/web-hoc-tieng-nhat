@using Microsoft.AspNetCore.Identity
@model IEnumerable<JapaneseLearningWeb.Models.Quiz>

@{
    ViewData["Title"] = "Danh sách bài kiểm tra";
}

<div class="card shadow-sm mb-4">
    <div class="card-header d-flex justify-content-between align-items-center bg-teal text-white">
        <h5 class="mb-0">
            <i class="fas fa-tasks me-2"></i> @ViewData["Title"]
        </h5>
        @if (User.IsInRole("Admin") || User.IsInRole("Employee"))
        {
            <a asp-controller="Quizzes"
               asp-action="Create"
               class="btn btn-light btn-sm shadow-sm rounded-pill">
                <i class="fas fa-plus-circle me-1"></i> Tạo bài kiểm tra mới
            </a>
        }
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table align-middle quiz-table mb-0">
                <thead class="bg-teal text-white">
                    <tr>
                        <th class="text-center" style="width: 50px;">#</th>
                        <th>Tên bài kiểm tra</th>
                        <th>Bài học</th>
                        <th>Khóa học</th>
                        <th style="width: 130px;">Ngày tạo</th>
                        <th class="text-center" style="width: 280px;">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        int i = 1;
                        foreach (var quiz in Model)
                        {
                            <tr>
                                <td class="text-center">@i</td>
                                <td>@quiz.Title</td>
                                <td>@(quiz.Lesson?.Title ?? "<span class='text-muted fst-italic'>Chưa có</span>")</td>
                                <td>@(quiz.Lesson?.Course?.Title ?? "<span class='text-muted fst-italic'>Chưa có</span>")</td>
                                <td>@quiz.CreatedAt.ToString("dd/MM/yyyy")</td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-2 flex-wrap">
                                        @if (User.IsInRole("Admin") || User.IsInRole("Employee"))
                                        {
                                            <a asp-action="Edit"
                                               asp-route-id="@quiz.QuizId"
                                               class="btn btn-sm btn-outline-warning rounded-pill px-3">
                                                <i class="fas fa-edit me-1"></i> Sửa
                                            </a>
                                            <a asp-action="Delete"
                                               asp-route-id="@quiz.QuizId"
                                               class="btn btn-sm btn-outline-danger rounded-pill px-3"
                                               onclick="return confirm('Bạn có chắc muốn xóa quiz này?');">
                                                <i class="fas fa-trash-alt me-1"></i> Xóa
                                            </a>
                                        }
                                        @if (User.Identity.IsAuthenticated)
                                        {
                                            <a asp-action="Take"
                                               asp-route-id="@quiz.QuizId"
                                               class="btn btn-sm btn-outline-success rounded-pill px-3">
                                                <i class="fas fa-clipboard-list me-1"></i> Làm bài
                                            </a>
                                        }
                                        else
                                        {
                                            <a asp-controller="Home"
                                               asp-action="Login"
                                               class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                                                <i class="fas fa-sign-in-alt me-1"></i> Đăng nhập để làm bài
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                            i++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center fst-italic text-muted py-4">Hiện chưa có bài kiểm tra nào.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    :root {
        --teal: #17b6b7;
        --teal-hover: #0ba0a1;
        --teal-bg: #e3f7fb;
        --teal-light: #f6fcfd;
    }

    .bg-teal {
        background: var(--teal) !important;
    }

    .text-teal {
        color: var(--teal) !important;
    }

    .quiz-table {
        border-radius: 14px;
        overflow: hidden;
        background: var(--teal-light);
        border-collapse: separate !important;
    }

        .quiz-table th, .quiz-table td {
            border: none !important;
            vertical-align: middle;
        }

        .quiz-table tbody tr:hover {
            background-color: var(--teal-bg);
            transition: background-color 0.3s;
        }

    .card-header.bg-teal {
        border-radius: 14px 14px 0 0;
    }

    .btn-outline-warning, .btn-outline-danger, .btn-outline-success, .btn-outline-secondary {
        border-radius: 30px;
        font-weight: 600;
        min-width: 100px;
        transition: background 0.2s, color 0.2s;
    }

        .btn-outline-warning:hover {
            background-color: #ffc107;
            color: #1d2124 !important;
            border-color: #ffc107;
        }

        .btn-outline-danger:hover {
            background-color: #dc3545;
            color: white !important;
            border-color: #dc3545;
        }

        .btn-outline-success:hover {
            background-color: #17b6b7;
            color: white !important;
            border-color: #17b6b7;
        }

        .btn-outline-secondary:hover {
            background-color: #6c757d;
            color: white !important;
            border-color: #6c757d;
        }

    .btn-light {
        background: #e3f7fb !important;
        color: #17b6b7 !important;
        font-weight: 600;
        border-radius: 30px;
    }

        .btn-light:hover {
            background: #17b6b7 !important;
            color: #fff !important;
        }
    @@media (max-width: 768px) {
        .quiz-table th, .quiz-table td

    {
        font-size: 0.93rem;
        padding: 8px 6px;
    }

    .btn-sm {
        font-size: 0.9rem;
        padding: 0.35rem 0.6rem;
        min-width: 70px;
    }

    }
</style>
