@{
    ViewData["Title"] = "Kết Quả Kiểm Tra";
}
@* 
<h2 class="text-danger mb-4">Kết Quả Kiểm Tra</h2>
 *@
<div class="card result-card" style="max-width: 600px; margin: 2rem auto;">
    <div class="card-header bg-turquoise text-white">
        <h4 class="mb-0">Kết Quả Bài Kiểm Tra</h4>
    </div>

    <div class="card-body">
        <div class="alert alert-info shadow-sm">
            <p><strong>Bài kiểm tra:</strong> <span class="text-danger">@ViewBag.QuizTitle</span></p>
            <p><strong>Điểm số của bạn:</strong> <span class="fw-semibold">@ViewBag.Score</span> / @ViewBag.Total</p>
        </div>

        <a asp-action="Index" class="btn btn-turquoise mt-3">
            <i class="fas fa-arrow-left me-1"></i> Quay về danh sách
        </a>
    </div>
</div>

<style>
    /* Card styling */
    .result-card {
        border-radius: 12px;
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
    }

    .card-header.bg-turquoise {
        background-color: #40E0D0; /* Turquoise */
        color: white;
    }

    /* Styling for alert-info */
    .alert-info {
        background-color: #e7f1ff;
        border-color: #a8c5ff;
        color: #084298;
        font-size: 1.1rem;
    }

    /* Button styling */
    .btn-turquoise {
        background-color: #40E0D0; /* Turquoise */
        color: white;
        border-radius: 30px;
        font-weight: 600;
        padding: 12px 36px;
        box-shadow: 0 4px 12px rgba(64, 224, 208, 0.4);
        transition: background-color 0.3s ease, box-shadow 0.3s ease;
        cursor: pointer;
        border: none;
        display: inline-block;
    }

        .btn-turquoise:hover {
            background-color: #1C8B87;
            box-shadow: 0 6px 18px rgba(28, 139, 135, 0.7);
        }
</style>
