@model JapaneseLearningWeb.Models.Quiz

@{
    ViewData["Title"] = "Sửa Bài Kiểm Tra";
}

@* <h1 class="mb-4 text-danger">Sửa Bài Kiểm Tra</h1>
 *@
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<hr />

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card edit-card" role="main" aria-labelledby="editQuizTitle">
            <!-- Card Header with Turquoise color -->
            <div class="edit-card-header">
                <i class="bi bi-pencil-square" aria-hidden="true"></i>
                <span>Sửa Bài Kiểm Tra</span>
            </div>
            <div class="edit-card-body">
                <form asp-action="Edit" method="post" id="quizForm" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="QuizId" />

                    <div asp-validation-summary="All" class="text-danger mb-4"></div>

                    <!-- Tiêu đề -->
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold text-danger">Tiêu đề</label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <!-- Dropdown Khóa học -->
                    <div class="mb-3">
                        <label asp-for="CourseId" class="form-label fw-semibold text-danger">Khóa học</label>
                        <select asp-for="CourseId"
                                class="form-select"
                                id="CourseId"
                                asp-items="@(ViewBag.Courses != null
                                    ? new SelectList((List<Course>)ViewBag.Courses, "CourseId", "Title")
                                    : new SelectList(new List<Course>(), "CourseId", "Title"))"
                                onchange="loadLessons()">
                            <option value="">-- Chọn khóa học --</option>
                        </select>
                        <span asp-validation-for="CourseId" class="text-danger"></span>
                    </div>

                    <!-- Dropdown Bài học -->
                    <div class="mb-3">
                        <label asp-for="LessonId" class="form-label fw-semibold text-danger">Bài học</label>
                        <select asp-for="LessonId"
                                class="form-select"
                                id="LessonId"
                                asp-items="@(ViewBag.Lessons != null
                                    ? new SelectList((List<Lesson>)ViewBag.Lessons, "LessonId", "Title")
                                    : new SelectList(new List<Lesson>(), "LessonId", "Title"))">
                            <option value="">-- Chọn bài học --</option>
                        </select>
                        <span asp-validation-for="LessonId" class="text-danger"></span>
                    </div>

                    <hr />

                    <!-- Các câu hỏi -->
                    <h4 class="mb-3 text-danger">Các câu hỏi</h4>
                    <div id="questionsContainer">
                        @if (Model.Questions != null && Model.Questions.Any())
                        {
                            @for (int qIndex = 0; qIndex < Model.Questions.Count; qIndex++)
                            {
                                <div class="question-item mb-4 border rounded p-3 shadow-sm">
                                    <label class="form-label fw-semibold">Câu hỏi @(qIndex + 1)</label>
                                    <input type="text"
                                           name="Questions[@qIndex].Text"
                                           class="form-control mb-2 question-text"
                                           placeholder="Nhập câu hỏi"
                                           value="@Model.Questions[qIndex].Text" />
                                    <span asp-validation-for="Questions[@qIndex].Text" class="text-danger"></span>

                                    <div class="mb-2">
                                        @for (int oIndex = 0; oIndex < 4; oIndex++)
                                        {
                                            var isChecked = (Model.Questions[qIndex].Options.Count > oIndex
                                            && Model.Questions[qIndex].Options[oIndex].IsCorrect)
                                            ? "checked"
                                            : "";
                                            var optionText = (Model.Questions[qIndex].Options.Count > oIndex)
                                            ? Model.Questions[qIndex].Options[oIndex].Text
                                            : "";

                                            <div class="form-check mb-1 d-flex align-items-center">
                                                <input class="form-check-input me-2 correct-answer"
                                                       type="radio"
                                                       name="Questions[@qIndex].SelectedCorrect"
                                                       value="@oIndex"
                                                @isChecked />

                                                <input type="hidden"
                                                       name="Questions[@qIndex].Options[@oIndex].IsCorrect"
                                                       class="hidden-correct"
                                                       value="false" />

                                                <input type="text"
                                                       name="Questions[@qIndex].Options[@oIndex].Text"
                                                       class="form-control w-75 option-text"
                                                       placeholder="Đáp án @((char)('A' + oIndex))"
                                                       value="@optionText" />
                                                <span asp-validation-for="Questions[@qIndex].Options[@oIndex].Text"
                                                      class="text-danger ms-2"></span>
                                            </div>
                                        }
                                        <span asp-validation-for="Questions[@qIndex].Options" class="text-danger"></span>
                                    </div>

                                    <button type="button"
                                            class="btn btn-danger btn-sm"
                                            onclick="removeQuestion(this)">
                                        Xóa câu hỏi
                                    </button>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="alert alert-warning">
                                Vui lòng thêm ít nhất một câu hỏi trước khi lưu.
                            </div>
                        }
                    </div>

                    <!-- Nút thêm câu hỏi -->
                    <div class="mb-3">
                        <button type="button" class="btn btn-secondary" onclick="addQuestion()">
                            <i class="fas fa-plus"></i> Thêm câu hỏi
                        </button>
                    </div>

                    <hr />

                    <!-- Nút Lưu và Quay lại -->
                    <div class="mb-4 d-flex gap-2">
                        <input type="submit"
                               value="Lưu thay đổi"
                               class="btn btn-danger flex-grow-1"
                               onclick="prepareForm()" />
                        <a asp-action="Index" class="btn btn-outline-secondary flex-grow-1">Quay lại danh sách</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let questionCount = @(Model.Questions?.Count ?? 0);

        document.addEventListener('DOMContentLoaded', function () {
            const courseSelect = document.getElementById("CourseId");
            if (courseSelect && courseSelect.options.length > 1 && !courseSelect.value) {
                courseSelect.value = courseSelect.options[1].value;
                loadLessons();
            }
        });

        function loadLessons() {
            const courseId = document.getElementById("CourseId").value;
            const lessonSelect = document.getElementById("LessonId");
            lessonSelect.innerHTML = '<option value="">Đang tải...</option>';

            if (!courseId) {
                lessonSelect.innerHTML = '<option value="">-- Chọn bài học --</option>';
                return;
            }

            fetch('/Quizzes/GetLessonsByCourse?courseId=' + courseId, {
                method: 'GET',
                headers: { 'Accept': 'application/json' }
            })
            .then(res => {
                if (!res.ok) throw new Error("Lỗi HTTP: " + res.status);
                return res.json();
            })
            .then(data => {
                lessonSelect.innerHTML = '<option value="">-- Chọn bài học --</option>';
                if (!data || data.length === 0) {
                    lessonSelect.innerHTML += '<option value="" disabled>Không có bài học</option>';
                } else {
                    data.forEach(item => {
                        const opt = document.createElement('option');
                        opt.value = item.lessonId;
                        opt.innerText = item.title;
                        lessonSelect.appendChild(opt);
                    });
                    lessonSelect.value = data[0].lessonId;
                }
            })
            .catch(err => {
                console.error('Lỗi tải Bài học:', err);
                lessonSelect.innerHTML = '<option value="">Không tải được bài học</option>';
                alert('Không thể tải danh sách bài học. Vui lòng thử lại.');
            });
        }

        function addQuestion() {
            const container = document.getElementById('questionsContainer');
            const warning = container.querySelector('.alert-warning');
            if (warning) warning.remove();

            const qIndex = questionCount++;
            const div = document.createElement('div');
            div.classList.add('question-item', 'mb-4', 'border', 'rounded', 'p-3', 'shadow-sm');

            div.innerHTML = `
                <label class="form-label fw-semibold">Câu hỏi</label>
                <input type="text"
                       name="Questions[${qIndex}].Text"
                       class="form-control mb-2 question-text"
                       placeholder="Nhập câu hỏi" />
                <span class="text-danger" data-valmsg-for="Questions[${qIndex}].Text"></span>

                <div class="mb-2">
                    ${[0,1,2,3].map(oIndex => `
                        <div class="form-check mb-1 d-flex align-items-center">
                            <input class="form-check-input me-2 correct-answer"
                                   type="radio"
                                   name="Questions[${qIndex}].SelectedCorrect"
                                   value="${oIndex}" />

                            <input type="hidden"
                                   name="Questions[${qIndex}].Options[${oIndex}].IsCorrect"
                                   class="hidden-correct"
                                   value="false" />

                            <input type="text"
                                   name="Questions[${qIndex}].Options[${oIndex}].Text"
                                   class="form-control w-75 option-text"
                                   placeholder="Đáp án ${String.fromCharCode(65 + oIndex)}" />
                            <span class="text-danger" data-valmsg-for="Questions[${qIndex}].Options[${oIndex}].Text"></span>
                        </div>
                    `).join('')}
                    <span class="text-danger" data-valmsg-for="Questions[${qIndex}].Options"></span>
                </div>

                <button type="button"
                        class="btn btn-danger btn-sm"
                        onclick="removeQuestion(this)">
                    Xóa câu hỏi
                </button>
            `;

            container.appendChild(div);
            $.validator.unobtrusive.parse(div);
        }

        function removeQuestion(btn) {
            const questionDiv = btn.closest('.question-item');
            questionDiv.remove();
            questionCount--;

            const container = document.getElementById('questionsContainer');
            if (!container.querySelector('.question-item')) {
                const warning = document.createElement('div');
                warning.classList.add('alert', 'alert-warning');
                warning.innerText = 'Vui lòng thêm ít nhất một câu hỏi trước khi lưu.';
                container.appendChild(warning);
            }
        }

        function prepareForm() {
            const items = document.querySelectorAll('.question-item');
            items.forEach((item, index) => {
                const qInput = item.querySelector('.question-text');
                qInput.name = `Questions[${index}].Text`;

                const optionTexts = item.querySelectorAll('.option-text');
                optionTexts.forEach((opt, optIdx) => {
                    opt.name = `Questions[${index}].Options[${optIdx}].Text`;
                });

                const radios = item.querySelectorAll(`input[name="Questions[${index}].SelectedCorrect"]`);
                let selectedIdx = -1;
                radios.forEach(radio => {
                    if (radio.checked) {
                        selectedIdx = parseInt(radio.value);
                    }
                });

                const hiddenInputs = item.querySelectorAll('.hidden-correct');
                hiddenInputs.forEach((hiddenInput, idx) => {
                    hiddenInput.value = (idx === selectedIdx).toString();
                    hiddenInput.name = `Questions[${index}].Options[${idx}].IsCorrect`;
                });
            });
        }
    </script>

    <partial name="_ValidationScriptsPartial" />
}

<style>
    .edit-card-header {
        background-color: #40E0D0; /* Turquoise background */
        color: white;
        font-size: 2rem; /* Increased font size */
        padding: 1.5rem 2rem; /* Added more padding */
        text-align: center; /* Center-align text */
        font-weight: 700; /* Make the header text bold */
        border-top-left-radius: 0.5rem;
        border-top-right-radius: 0.5rem;
    }

    .btn-danger {
        background-color: #40E0D0; /* Turquoise */
        border-color: #40E0D0;
    }

        .btn-danger:hover,
        .btn-danger:focus {
            background-color: #1C8B87;
            border-color: #1C8B87;
            color: white;
        }

    .btn-outline-danger {
        color: #40E0D0;
        border-color: #40E0D0;
    }

        .btn-outline-danger:hover,
        .btn-outline-danger:focus {
            background-color: #40E0D0;
            color: white;
            border-color: #40E0D0;
        }
</style>
