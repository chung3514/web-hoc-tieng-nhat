@model JapaneseLearningWeb.Models.Quiz
@{
    ViewData["Title"] = "Xóa bài kiểm tra";
}

<h2 class="text-danger">@ViewData["Title"]</h2>

<div class="alert alert-warning d-flex align-items-center">
    <i class="fas fa-exclamation-triangle me-2"></i>
    <div>
        Bạn có chắc chắn muốn xóa bài kiểm tra: <strong>@Model.Title</strong>?
    </div>
</div>

<form asp-action="Delete" method="post" class="d-flex gap-2">
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.QuizId)

    <button type="submit" class="btn btn-danger">
        <i class="fas fa-trash-alt me-1"></i> Xóa
    </button>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="fas fa-arrow-left me-1"></i> Hủy
    </a>
</form>
