@model JapaneseLearningWeb.Models.Quiz

@{
    ViewData["Title"] = "Làm bài kiểm tra: " + Model.Title;
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm rounded-4 border-0">
                <!-- Card Header with Turquoise background -->
                <div class="card-header bg-turquoise text-white d-flex align-items-center gap-2">
                    <i class="fas fa-clipboard-list fa-lg"></i>
                    <h3 class="card-title mb-0">@ViewData["Title"]</h3>
                </div>
                <div class="card-body">
                    <form asp-action="Submit" method="post" class="needs-validation" novalidate>
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="QuizId" value="@Model.QuizId" />

                        @for (int i = 0; i < Model.Questions.Count; i++)
                        {
                            var question = Model.Questions[i];
                            <div class="mb-4">
                                <p class="fw-semibold">
                                    <strong>Câu @(i + 1):</strong> @question.Text
                                </p>
                                <div>
                                    @for (int j = 0; j < question.Options.Count; j++)
                                    {
                                        var option = question.Options[j];
                                        <div class="form-check mb-2">
                                            <input class="form-check-input"
                                                   type="radio"
                                                   name="Answers[@i]"
                                                   id="q@(i)_op@(j)"
                                                   value="@j"
                                                   required />
                                            <label class="form-check-label" for="q@(i)_op@(j)">
                                                @option.Text
                                            </label>
                                            <div class="invalid-feedback">
                                                Vui lòng chọn đáp án.
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-turquoise px-4 fw-semibold">
                                <i class="fas fa-paper-plane me-1"></i> Nộp bài
                            </button>
                            <a asp-action="Index" class="btn btn-outline-turquoise px-4">
                                Hủy
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Bootstrap form validation
        (function () {
            'use strict';
            var forms = document.querySelectorAll('.needs-validation');
            Array.prototype.slice.call(forms)
                .forEach(function (form) {
                    form.addEventListener('submit', function (event) {
                        if (!form.checkValidity()) {
                            event.preventDefault();
                            event.stopPropagation();
                        }
                        form.classList.add('was-validated');
                    }, false);
                });
        })();
    </script>
}

@section Styles {
    <style>
        /* Turquoise header */
        .bg-turquoise {
            background-color: #40E0D0; /* Turquoise */
        }

        /* Turquoise Button Styles */
        .btn-turquoise {
            background-color: #40E0D0; /* Turquoise */
            color: white;
            border-radius: 30px;
            font-weight: 600;
            padding: 12px 36px;
            box-shadow: 0 4px 12px rgba(64, 224, 208, 0.4);
            transition: background-color 0.3s ease, box-shadow 0.3s ease;
            cursor: pointer;
            border: none;
        }

            .btn-turquoise:hover,
            .btn-turquoise:focus {
                background-color: #1C8B87; /* Darker turquoise */
                box-shadow: 0 6px 18px rgba(28, 139, 135, 0.7);
                outline: none;
            }

        /* Turquoise Outline Button */
        .btn-outline-turquoise {
            color: #40E0D0;
            border-color: #40E0D0;
            transition: background-color 0.3s ease, color 0.3s ease;
        }

            .btn-outline-turquoise:hover,
            .btn-outline-turquoise:focus {
                background-color: #40E0D0;
                color: white;
                border-color: #40E0D0;
            }
    </style>
}
