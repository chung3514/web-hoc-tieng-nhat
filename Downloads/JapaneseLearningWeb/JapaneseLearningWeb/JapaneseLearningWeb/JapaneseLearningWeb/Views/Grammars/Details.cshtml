@model JapaneseLearningWeb.Models.Grammar

@{
    ViewData["Title"] = "Chi tiết ngữ pháp";
}

<style>
    :root {
        --teal: #17b6b7;
        --teal-hover: #0ba0a1;
        --teal-bg: #e3f7fb;
    }

    .grammar-detail-container {
        max-width: 800px;
    }

    .card {
        border: none;
        border-radius: 16px;
        box-shadow: 0 4px 18px rgba(0,0,0,0.06);
    }

    .card-header {
        background: var(--teal);
        color: #fff;
        border-radius: 16px 16px 0 0;
        padding: 16px 22px;
    }

        .card-header h5 {
            margin: 0;
            font-weight: 700;
        }

    .card-body {
        padding: 24px;
    }

    dt {
        font-weight: 600;
        color: #555;
        margin-top: 10px;
    }

    dd {
        font-size: 1.05rem;
        color: #222;
        margin-bottom: 16px;
    }

    .info-icon {
        color: var(--teal);
        margin-right: 6px;
    }

    .btn-back {
        background: var(--teal);
        color: #fff;
        font-weight: 600;
        border-radius: 30px;
        padding: 8px 26px;
    }

        .btn-back:hover {
            background: var(--teal-hover);
            color: #fff;
        }

    @@media (max-width: 576px) {
        .card-body {
            padding: 18px;
        }
    }
</style>

<div class="container grammar-detail-container my-4">
    <div class="card">

        <!-- HEADER -->
        <div class="card-header">
            <h5>
                <i class="fas fa-book-reader me-2"></i>Chi tiết ngữ pháp
            </h5>
        </div>

        <!-- BODY -->
        <div class="card-body">
            <dl class="row mb-0">

                <dt class="col-sm-4">
                    <i class="fas fa-book info-icon"></i>Bài học
                </dt>
                <dd class="col-sm-8">
                    @(Model.Lesson?.Title ?? "Không có bài học")
                </dd>

                <dt class="col-sm-4">
                    <i class="fas fa-balance-scale info-icon"></i>Quy tắc
                </dt>
                <dd class="col-sm-8">
                    @Model.Rule
                </dd>

                <dt class="col-sm-4">
                    <i class="fas fa-lightbulb info-icon"></i>Ví dụ
                </dt>
                <dd class="col-sm-8">
                    @(string.IsNullOrEmpty(Model.Example) ? "—" : Model.Example)
                </dd>

                <dt class="col-sm-4">
                    <i class="fas fa-layer-group info-icon"></i>Cấp độ
                </dt>
                <dd class="col-sm-8">
                    @(string.IsNullOrEmpty(Model.Level) ? "—" : Model.Level)
                </dd>

                <dt class="col-sm-4">
                    <i class="fas fa-sticky-note info-icon"></i>Ghi chú
                </dt>
                <dd class="col-sm-8">
                    @(string.IsNullOrEmpty(Model.Notes) ? "—" : Model.Notes)
                </dd>

                <dt class="col-sm-4">
                    <i class="fas fa-calendar-alt info-icon"></i>Ngày tạo
                </dt>
                <dd class="col-sm-8">
                    @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                </dd>
            </dl>

            <!-- BACK -->
            <div class="text-end mt-4">
                <a asp-action="Index" class="btn btn-back">
                    <i class="fas fa-arrow-left me-1"></i> Quay lại danh sách
                </a>
            </div>
        </div>
    </div>
</div>
