@model JapaneseLearningWeb.Models.PagedListViewModel<JapaneseLearningWeb.Models.Grammar>

@{
    ViewData["Title"] = "Danh sách ngữ pháp";
    int totalPages = (int)Math.Ceiling((double)Model.TotalItems / Model.PageSize);
}

@{
    var courses = ViewBag.Courses as List<JapaneseLearningWeb.Models.Course>;
    int? selectedCourseId = ViewBag.SelectedCourseId as int?;
}

<style>
    /* ===== CHUẨN GIỐNG GRAMMAR ===== */

    .radical-container {
        max-width: 1100px;
    }

    :root {
        --teal: #17b6b7;
        --teal-hover: #0ba0a1;
        --teal-bg: #e3f7fb;
    }

    .card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 4px 18px rgba(0,0,0,0.06);
    }

    .card-header {
        background-color: var(--teal);
        color: #fff;
        border-radius: 12px 12px 0 0;
    }

    .card-body {
        background: #f7fcfd;
    }

    .search-bar-radical {
        background: #eafafc;
        border-radius: 8px;
    }

    .radical-item-card {
        background: #fcfdff;
        border-radius: 12px;
        min-height: 220px;
    }

    .btn-outline-info,
    .btn-outline-warning,
    .btn-outline-danger {
        min-width: 80px;
        font-weight: 600;
    }

    .btn-outline-info {
        border-color: var(--teal);
        color: var(--teal);
    }

        .btn-outline-info:hover {
            background: var(--teal);
            color: #fff;
        }

    .btn-outline-warning:hover {
        background: #e0a800;
        color: #fff;
    }

    .btn-outline-danger:hover {
        background: #dc3545;
        color: #fff;
    }

    .pagination .page-link {
        border-radius: 8px;
        margin: 0 4px;
    }

    .pagination .active .page-link {
        background: var(--teal);
        border-color: var(--teal);
        color: #fff;
    }

    @@media (max-width: 768px) {
        .radical-item-card {
            min-height: 180px;
        }
    }
</style>

<div class="container grammar-container my-4">
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                <i class="fas fa-language me-2"></i>Danh sách ngữ pháp
            </h5>
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Create" class="btn btn-light btn-sm">
                    <i class="fas fa-plus-circle"></i> Tạo mới
                </a>
            }
        </div>

        <div class="card-body">
            <!-- Tìm kiếm -->
            <form asp-action="Index" method="get" class="row g-3 mb-4">
                <div class="col-md-4">
                    <select name="courseId" class="form-control" onchange="this.form.submit()">
                        <option value="">-- Chọn khóa học --</option>
                        @foreach (var course in courses)
                        {
                            <option value="@course.CourseId"
                                    selected="@(selectedCourseId == course.CourseId ? "selected" : null)">
                                @course.Title @(course.IsFree ? "(Miễn phí)" : "")
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <input type="text"
                           name="keyword"
                           value="@Model.Keyword"
                           class="form-control"
                           placeholder="Nhập từ khóa..." />
                </div>

                <div class="col-md-2 d-grid">
                    <button type="submit" class="btn btn-info text-white">
                        Tìm kiếm
                    </button>
                </div>


            </form>

            <!-- Table -->
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Bài học</th>
                            <th>Quy tắc</th>
                            <th>Ví dụ</th>
                            <th>Cấp độ</th>
                            <th>Ghi chú</th>
                            <th class="text-end">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items.Any())
                        {
                            @foreach (var g in Model.Items)
                            {
                                <tr>
                                    <td>@(g.Lesson?.Title ?? "—")</td>
                                    <td>@g.Rule</td>
                                    <td>@g.Example</td>
                                    <td>@g.Level</td>
                                    <td>@g.Notes</td>
                                    <td class="text-end">
                                        <a asp-action="Details" asp-route-id="@g.GrammarId"
                                           class="btn btn-info btn-sm">Chi tiết</a>
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <a asp-action="Edit" asp-route-id="@g.GrammarId"
                                               class="btn btn-warning btn-sm">Sửa</a>
                                            <a asp-action="Delete" asp-route-id="@g.GrammarId"
                                               class="btn btn-danger btn-sm">Xóa</a>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted">
                                    Không có ngữ pháp nào.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (totalPages > 1)
            {
                <nav class="mt-4">
                    <ul class="pagination justify-content-center">
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                <a class="page-link"
                                   asp-route-pageNumber="@i"
                                   asp-route-pageSize="@Model.PageSize"
                                   asp-route-keyword="@Model.Keyword"
                                   asp-route-courseId="@selectedCourseId">
                                    @i
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>
