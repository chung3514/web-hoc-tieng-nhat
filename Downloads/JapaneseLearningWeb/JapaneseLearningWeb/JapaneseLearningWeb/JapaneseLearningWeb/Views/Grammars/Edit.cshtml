@model JapaneseLearningWeb.Models.Grammar

@{
    ViewData["Title"] = "Chỉnh sửa ngữ pháp";
}

<style>
    :root {
        --teal: #17b6b7;
        --teal-hover: #0ba0a1;
        --teal-bg: #e3f7fb;
    }

    .grammar-edit-container {
        max-width: 800px;
    }

    .card {
        border: none;
        border-radius: 16px;
        box-shadow: 0 4px 18px rgba(0,0,0,0.06);
    }

    .card-header {
        background: var(--teal);
        color: #fff;
        border-radius: 16px 16px 0 0;
        padding: 16px 22px;
        font-weight: 700;
    }

    .card-body {
        padding: 26px;
    }

    .form-label {
        font-weight: 600;
        color: #333;
    }

    .form-control,
    .form-select {
        border-radius: 10px;
        border: 1.5px solid #dbecec;
        font-size: 1.05rem;
        padding: 10px 14px;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: var(--teal);
            box-shadow: 0 0 0 0.15rem rgba(23,182,183,.25);
        }

    .text-danger.small {
        font-weight: 500;
    }

    .btn-save {
        background: var(--teal);
        color: #fff;
        font-weight: 600;
        border-radius: 30px;
        padding: 8px 28px;
    }

        .btn-save:hover {
            background: var(--teal-hover);
            color: #fff;
        }

    .btn-back {
        background: #6c757d;
        color: #fff;
        font-weight: 600;
        border-radius: 30px;
        padding: 8px 28px;
    }

        .btn-back:hover {
            background: #565e64;
            color: #fff;
        }

    @@media (max-width: 576px) {
        .card-body {
            padding: 20px;
        }
    }
</style>

<div class="container grammar-edit-container my-4">
    <div class="card">

        <!-- HEADER -->
        <div class="card-header">
            <i class="fas fa-edit me-2"></i>Chỉnh sửa ngữ pháp
        </div>

        <!-- BODY -->
        <div class="card-body">
            <form asp-action="Edit" method="post" novalidate>
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <input type="hidden" asp-for="GrammarId" />
                <input type="hidden" asp-for="CreatedAt" />

                <!-- Lesson -->
                <div class="mb-3">
                    <label asp-for="LessonId" class="form-label">
                        <i class="fas fa-book me-1 text-teal"></i>Bài học
                    </label>
                    <select asp-for="LessonId"
                            class="form-select"
                            asp-items="@(new SelectList(ViewBag.Lessons, "LessonId", "Title"))">
                        <option value="">-- Chọn bài học --</option>
                    </select>
                    <span asp-validation-for="LessonId" class="text-danger small"></span>
                </div>

                <!-- Rule -->
                <div class="mb-3">
                    <label asp-for="Rule" class="form-label">
                        <i class="fas fa-balance-scale me-1 text-teal"></i>Quy tắc
                    </label>
                    <input asp-for="Rule" class="form-control" />
                    <span asp-validation-for="Rule" class="text-danger small"></span>
                </div>

                <!-- Example -->
                <div class="mb-3">
                    <label asp-for="Example" class="form-label">
                        <i class="fas fa-lightbulb me-1 text-teal"></i>Ví dụ
                    </label>
                    <textarea asp-for="Example" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Example" class="text-danger small"></span>
                </div>

                <!-- Level -->
                <div class="mb-3">
                    <label asp-for="Level" class="form-label">
                        <i class="fas fa-layer-group me-1 text-teal"></i>Cấp độ
                    </label>
                    <input asp-for="Level" class="form-control" />
                    <span asp-validation-for="Level" class="text-danger small"></span>
                </div>

                <!-- Notes -->
                <div class="mb-4">
                    <label asp-for="Notes" class="form-label">
                        <i class="fas fa-sticky-note me-1 text-teal"></i>Ghi chú
                    </label>
                    <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Notes" class="text-danger small"></span>
                </div>

                <!-- ACTION -->
                <div class="d-flex justify-content-center gap-3 mt-4">
                    <button type="submit" class="btn btn-save">
                        <i class="fas fa-save me-1"></i>Lưu
                    </button>
                    <a asp-action="Index" class="btn btn-back">
                        <i class="fas fa-arrow-left me-1"></i>Quay lại
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
