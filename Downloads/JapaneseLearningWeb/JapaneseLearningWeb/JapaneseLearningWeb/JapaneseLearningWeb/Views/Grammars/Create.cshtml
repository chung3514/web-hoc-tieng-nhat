@model JapaneseLearningWeb.Models.Grammar
@{
    ViewData["Title"] = "Tạo mới ngữ pháp";
}

@section Styles {
    <style>
        :root {
            --teal: #17b6b7;
            --teal-hover: #0ba0a1;
        }

        .grammar-create-page {
            font-family: 'Montserrat', sans-serif;
            font-size: 14.5px;
            font-weight: 400;
            color: #334155;
        }

        .grammar-container {
            max-width: 600px;
            margin: 32px auto;
        }

        /* CARD */
        .card {
            border: none;
            border-radius: 16px;
            box-shadow: 0 6px 24px rgba(23,182,183,0.12);
            background: #fff;
        }

        .card-header {
            background: var(--teal);
            color: #fff;
            border-radius: 16px 16px 0 0;
            padding: 16px 22px;
            font-size: 18px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .card-body {
            padding: 26px;
            background: #f8fefe;
        }

        /* FORM */
        .form-label {
            font-weight: 600;
            color: var(--teal);
            margin-bottom: 6px;
        }

        .form-control,
        .form-select {
            border-radius: 10px;
            padding: 10px 14px;
            font-size: 14.5px;
            border: 1.5px solid var(--teal);
            background: #f8fefe;
            color: #334155;
        }

            .form-control:focus,
            .form-select:focus {
                border-color: var(--teal-hover);
                box-shadow: 0 0 0 0.15rem rgba(23,182,183,.25);
                background: #fff;
            }

        .text-danger {
            font-size: 0.9rem;
            font-weight: 500;
        }

        /* BUTTONS */
        .btn-primary {
            background: var(--teal);
            border: none;
            border-radius: 30px;
            padding: 10px 28px;
            font-weight: 600;
            font-size: 14.5px;
            box-shadow: 0 4px 12px rgba(23,182,183,0.35);
        }

            .btn-primary:hover {
                background: var(--teal-hover);
            }

        .btn-secondary {
            border-radius: 30px;
            padding: 10px 28px;
            font-weight: 600;
            font-size: 14.5px;
        }

        @@media (max-width: 576px) {
            .card-body

        {
            padding: 20px;
        }

        }
    </style>
}

<div class="grammar-create-page">
    <div class="grammar-container">
        <div class="card">

            <!-- HEADER -->
            <div class="card-header">
                <i class="fas fa-plus-circle"></i>
                Tạo mới ngữ pháp
            </div>

            <!-- BODY -->
            <div class="card-body">
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">@TempData["Error"]</div>
                }

                <form asp-action="Create" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="LessonId" class="form-label">Bài học</label>
                        <select asp-for="LessonId" class="form-select" asp-items="ViewBag.Lessons">
                            <option value="">-- Chọn bài học --</option>
                        </select>
                        <span asp-validation-for="LessonId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Rule" class="form-label">Quy tắc</label>
                        <input asp-for="Rule" class="form-control"
                               placeholder="Nhập quy tắc ngữ pháp" />
                        <span asp-validation-for="Rule" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Example" class="form-label">Ví dụ</label>
                        <input asp-for="Example" class="form-control"
                               placeholder="Nhập ví dụ minh họa" />
                        <span asp-validation-for="Example" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Level" class="form-label">Cấp độ</label>
                        <input asp-for="Level" class="form-control"
                               placeholder="Ví dụ: N5, N4..." />
                        <span asp-validation-for="Level" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Notes" class="form-label">Ghi chú</label>
                        <textarea asp-for="Notes" class="form-control" rows="3"
                                  placeholder="Nhập ghi chú nếu có"></textarea>
                        <span asp-validation-for="Notes" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-center gap-3">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save me-1"></i> Tạo
                        </button>

                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Quay lại
                        </a>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
