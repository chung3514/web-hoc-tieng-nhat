@model JapaneseLearningWeb.Models.Vocabulary

@{
    ViewData["Title"] = "Xóa từ vựng";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-teal text-white d-flex align-items-center gap-2">
                    <i class="fas fa-trash-alt fa-lg"></i>
                    <h3 class="card-title mb-0">Xóa từ vựng</h3>
                </div>
                <div class="card-body">
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger" role="alert">
                            @TempData["ErrorMessage"]
                        </div>
                    }

                    <div class="alert alert-warning" role="alert">
                        Bạn có chắc chắn muốn xóa từ vựng này? Hành động này không thể hoàn tác!
                    </div>

                    <h4 class="text-teal mb-3">Thông tin từ vựng</h4>
                    <dl class="row">
                        <dt class="col-sm-4 text-muted">Kanji</dt>
                        <dd class="col-sm-8 fw-bold text-teal">@Model.Kanji</dd>

                        <dt class="col-sm-4 text-muted">Hiragana</dt>
                        <dd class="col-sm-8">@Model.Hiragana</dd>

                        <dt class="col-sm-4 text-muted">Romaji</dt>
                        <dd class="col-sm-8">@Model.Romaji</dd>

                        <dt class="col-sm-4 text-muted">Nghĩa</dt>
                        <dd class="col-sm-8">@Model.Meaning</dd>
                    </dl>

                    <form asp-action="Delete" method="post" class="mt-4 d-flex justify-content-end gap-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <button type="submit" class="btn btn-teal px-4 fw-semibold">
                            <i class="fas fa-trash-alt me-1"></i> Xóa
                        </button>
                        <a asp-action="Index" class="btn btn-secondary px-4">
                            <i class="fas fa-arrow-left me-1"></i> Quay lại
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --teal: #17b6b7;
        --teal-hover: #0ba0a1;
    }

    .text-teal {
        color: var(--teal) !important;
    }

    .btn-teal {
        background: var(--teal) !important;
        color: #fff !important;
        border: none;
        border-radius: 30px;
        font-weight: 600;
        transition: background 0.2s, color 0.2s;
    }

        .btn-teal:hover, .btn-teal:focus {
            background: var(--teal-hover) !important;
            color: #fff !important;
        }

    .card-header {
        background: var(--teal) !important;
        color: #fff;
        font-weight: 600;
        font-size: 1.5rem;
    }

    /* Form fields */
    .form-control:focus {
        border-color: var(--teal) !important;
        box-shadow: 0 0 6px rgba(23, 182, 183, 0.21) !important;
    }

    .alert-warning {
        background-color: #ffe3e3;
        color: #b52c3b;
        border-color: #dc3545;
    }
</style>
