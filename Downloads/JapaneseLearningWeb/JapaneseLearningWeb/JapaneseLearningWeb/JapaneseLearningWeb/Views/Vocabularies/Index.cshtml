@model JapaneseLearningWeb.Models.PagedListViewModel<JapaneseLearningWeb.Models.Vocabulary>
@using JapaneseLearningWeb.Models

@{
    ViewData["Title"] = "Danh sách từ vựng";
    int totalPages = (int)Math.Ceiling((double)Model.TotalItems / Model.PageSize);
    var courses = ViewBag.Courses as List<Course>;
    int? selectedCourseId = ViewBag.SelectedCourseId as int?;
}

<style>
    /* ===== CHUẨN GIỐNG GRAMMAR ===== */

    .vocab-container {
        max-width: 1100px;
    }

    :root {
        --teal: #17b6b7;
        --teal-hover: #148f8f;
        --teal-bg: #e3f7fb;
    }

    .card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 4px 18px rgba(0,0,0,0.06);
    }

    .card-header {
        background-color: var(--teal);
        color: #fff;
        border-radius: 12px 12px 0 0;
    }

    .card-body {
        background: #f7fcfd;
    }

    .form-control:focus {
        box-shadow: none;
        border-color: var(--teal);
    }

    .btn-primary {
        background-color: var(--teal);
        border: none;
        font-weight: 600;
    }

        .btn-primary:hover {
            background-color: var(--teal-hover);
        }

    .table thead th {
        background: #f8f9fa;
        font-weight: 600;
    }

    .table tbody td {
        font-size: 0.95rem;
        color: #333;
    }

    .pagination .page-link {
        border-radius: 8px;
        color: var(--teal);
    }

    .pagination .active .page-link {
        background: var(--teal);
        border-color: var(--teal);
        color: #fff;
    }
</style>

<div class="container vocab-container my-4">
    <div class="card">

        <!-- HEADER -->
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                <i class="fas fa-book-open me-2"></i>@ViewData["Title"]
            </h5>

            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Create" class="btn btn-light btn-sm">
                    <i class="fas fa-plus-circle"></i> Tạo mới
                </a>
            }
        </div>

        <!-- BODY -->
        <div class="card-body">

            <!-- FILTER + SEARCH -->
            <form asp-action="Index" method="get" class="row g-3 mb-4">

                <!-- CHỌN KHÓA HỌC -->
                <div class="col-md-6">
                    <select name="courseId" class="form-select" onchange="this.form.submit()">
                        <option value="">-- Chọn khóa học --</option>
                        @foreach (var course in courses)
                        {
                            <option value="@course.CourseId"
                                    selected="@(selectedCourseId == course.CourseId ? "selected" : null)">
                                @course.Title @(course.IsFree ? "(Miễn phí)" : "")
                            </option>
                        }
                    </select>
                </div>

                <!-- TỪ KHÓA -->
                <div class="col-md-4">
                    <input type="text"
                           name="keyword"
                           value="@Model.Keyword"
                           class="form-control"
                           placeholder="Nhập Kanji hoặc ý nghĩa..." />
                    <input type="hidden" name="pageSize" value="@Model.PageSize" />
                    <input type="hidden" name="pageNumber" value="1" />
                </div>

                <!-- NÚT TÌM -->
                <div class="col-md-2 d-grid">
                    <button type="submit" class="btn btn-info text-white">
                        Tìm kiếm
                    </button>
                </div>


            </form>


            <!-- TABLE -->
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Kanji</th>
                            <th>Hiragana</th>
                            <th>Romaji</th>
                            <th>Ý nghĩa</th>
                            <th class="text-end">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items.Any())
                        {
                            @foreach (var vocab in Model.Items)
                            {
                                <tr>
                                    <td>@vocab.Kanji</td>
                                    <td>@vocab.Hiragana</td>
                                    <td>@vocab.Romaji</td>
                                    <td>@vocab.Meaning</td>
                                    <td class="text-end">
                                        <a asp-action="Details" asp-route-id="@vocab.Id"
                                           class="btn btn-info btn-sm">
                                            Chi tiết
                                        </a>

                                        @if (User.IsInRole("Admin") || User.IsInRole("Employee"))
                                        {
                                            <a asp-action="Edit" asp-route-id="@vocab.Id"
                                               class="btn btn-warning btn-sm">
                                                Sửa
                                            </a>
                                        }

                                        @if (User.IsInRole("Admin"))
                                        {
                                            <a asp-action="Delete" asp-route-id="@vocab.Id"
                                               class="btn btn-danger btn-sm">
                                                Xóa
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted">
                                    Không có từ vựng nào.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- PAGINATION -->
            @if (totalPages > 1)
            {
                <nav class="mt-4">
                    <ul class="pagination justify-content-center">
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                <a class="page-link"
                                   asp-route-courseId="@selectedCourseId"
                                   asp-route-pageNumber="@i"
                                   asp-route-pageSize="@Model.PageSize"
                                   asp-route-keyword="@Model.Keyword">
                                    @i
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            }

        </div>
    </div>
</div>
