@model JapaneseLearningWeb.Models.Vocabulary

@{
    ViewData["Title"] = "Tạo mới từ vựng";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-teal text-white d-flex align-items-center">
                    <i class="fas fa-plus-circle fa-lg me-2"></i>
                    <h3 class="card-title mb-0">Tạo mới từ vựng</h3>
                </div>
                <div class="card-body">
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">
                            @TempData["Error"]
                        </div>
                    }

                    <form asp-action="Create" method="post" class="needs-validation" novalidate>
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="LessonId" class="form-label fw-semibold text-teal">Bài học</label>
                            <select asp-for="LessonId" class="form-select" asp-items="ViewBag.Lessons" required>
                                <option value="">-- Chọn bài học --</option>
                            </select>
                            <div class="invalid-feedback">
                                Vui lòng chọn một bài học.
                            </div>
                            <span asp-validation-for="LessonId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Kanji" class="form-label fw-semibold text-teal">Kanji</label>
                            <input asp-for="Kanji" class="form-control" placeholder="Nhập Kanji..." required />
                            <div class="invalid-feedback">
                                Vui lòng nhập Kanji.
                            </div>
                            <span asp-validation-for="Kanji" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Hiragana" class="form-label fw-semibold text-teal">Hiragana</label>
                            <input asp-for="Hiragana" class="form-control" placeholder="Nhập Hiragana..." required />
                            <div class="invalid-feedback">
                                Vui lòng nhập Hiragana.
                            </div>
                            <span asp-validation-for="Hiragana" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Romaji" class="form-label fw-semibold text-teal">Romaji</label>
                            <input asp-for="Romaji" class="form-control" placeholder="Nhập Romaji..." required />
                            <div class="invalid-feedback">
                                Vui lòng nhập Romaji.
                            </div>
                            <span asp-validation-for="Romaji" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Meaning" class="form-label fw-semibold text-teal">Nghĩa</label>
                            <input asp-for="Meaning" class="form-control" placeholder="Nhập nghĩa..." required />
                            <div class="invalid-feedback">
                                Vui lòng nhập nghĩa.
                            </div>
                            <span asp-validation-for="Meaning" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <button type="submit" class="btn btn-teal px-4 fw-semibold">
                                <i class="fas fa-save me-1"></i> Tạo
                            </button>
                            <a asp-action="Index" class="btn btn-secondary px-4">
                                <i class="fas fa-arrow-left me-1"></i> Quay lại
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --teal: #17b6b7; /* Màu xanh ngọc */
        --teal-hover: #0ba0a1; /* Màu xanh ngọc khi hover */
    }

    .text-teal {
        color: var(--teal) !important;
    }

    .btn-teal {
        background: var(--teal) !important;
        color: #fff !important;
        border: none;
        border-radius: 30px;
        font-weight: 600;
        transition: background 0.2s, color 0.2s;
    }

        .btn-teal:hover, .btn-teal:focus {
            background: var(--teal-hover) !important;
            color: #fff !important;
        }

    .card-header {
        background: var(--teal) !important;
        color: #fff;
        font-weight: 600;
        font-size: 1.5rem;
    }

    /* Form fields */
    .form-control:focus {
        border-color: var(--teal) !important;
        box-shadow: 0 0 6px rgba(23, 182, 183, 0.21) !important;
    }

    .alert-warning {
        background-color: #ffe3e3;
        color: #b52c3b;
        border-color: #dc3545;
    }
</style>

@section Scripts {
    <script>
        // Bootstrap form validation
        (function () {
            'use strict';
            var forms = document.querySelectorAll('.needs-validation');
            Array.prototype.slice.call(forms)
                .forEach(function (form) {
                    form.addEventListener('submit', function (event) {
                        if (!form.checkValidity()) {
                            event.preventDefault();
                            event.stopPropagation();
                        }
                        form.classList.add('was-validated');
                    }, false);
                });
        })();
    </script>
}
