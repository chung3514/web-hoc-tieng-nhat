@model JapaneseLearningWeb.Models.Vocabulary

@{
    ViewData["Title"] = "Chi tiết từ vựng";
}

<style>
    :root {
        --teal: #17b6b7;
        --teal-hover: #0ba0a1;
        --teal-bg: #e3f7fb;
    }

    .vocab-detail-container {
        max-width: 800px;
    }

    .card {
        border: none;
        border-radius: 16px;
        box-shadow: 0 4px 18px rgba(0,0,0,0.06);
    }

    .card-header {
        background: var(--teal);
        color: #fff;
        border-radius: 16px 16px 0 0;
        padding: 16px 22px;
    }

        .card-header h5 {
            margin: 0;
            font-weight: 700;
        }

    .card-body {
        padding: 24px;
    }

    dt {
        font-weight: 600;
        color: #555;
    }

    dd {
        font-size: 1.05rem;
        color: #222;
        margin-bottom: 18px;
    }

    .info-icon {
        color: var(--teal);
        margin-right: 6px;
    }

    .btn-back {
        background: var(--teal);
        color: #fff;
        font-weight: 600;
        border-radius: 30px;
        padding: 8px 26px;
    }

        .btn-back:hover {
            background: var(--teal-hover);
            color: #fff;
        }
</style>

<div class="container vocab-detail-container my-4">
    <div class="card">

        <!-- HEADER -->
        <div class="card-header">
            <h5>
                <i class="fas fa-book-open me-2"></i>Chi tiết từ vựng
            </h5>
        </div>

        <!-- BODY -->
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-4">
                    <i class="fas fa-language info-icon"></i>Kanji
                </dt>
                <dd class="col-sm-8">
                    @Model.Kanji
                </dd>

                <dt class="col-sm-4">
                    <i class="fas fa-pencil-alt info-icon"></i>Hiragana
                </dt>
                <dd class="col-sm-8">
                    @Model.Hiragana
                </dd>

                <dt class="col-sm-4">
                    <i class="fas fa-font info-icon"></i>Romaji
                </dt>
                <dd class="col-sm-8">
                    @Model.Romaji
                </dd>

                <dt class="col-sm-4">
                    <i class="fas fa-comment-dots info-icon"></i>Nghĩa
                </dt>
                <dd class="col-sm-8">
                    @Model.Meaning
                </dd>
            </dl>

            <!-- BACK -->
            <div class="text-end mt-4">
                <a asp-action="Index" class="btn btn-back">
                    <i class="fas fa-arrow-left me-1"></i> Quay lại danh sách
                </a>
            </div>
        </div>
    </div>
</div>
