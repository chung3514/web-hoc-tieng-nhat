@model JapaneseLearningWeb.Models.Vocabulary

@{
    ViewData["Title"] = "Chỉnh sửa từ vựng";
}

<!-- Bootstrap CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<!-- Font Awesome -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />

<style>
    :root {
        --teal: #17b6b7;
        --teal-hover: #0ba0a1;
    }

    .card-header {
        background-color: var(--teal);
        color: white;
    }

        .card-header h4 {
            color: white;
        }

    .btn-danger {
        background-color: var(--teal);
        border-color: var(--teal);
        color: white;
        transition: background-color 0.3s ease;
    }

        .btn-danger:hover {
            background-color: var(--teal-hover);
            border-color: var(--teal-hover);
            color: white;
        }

    .btn-secondary {
        background-color: #6c757d;
        color: white;
        border-radius: 12px;
        padding: 8px 20px;
        transition: background-color 0.3s ease;
    }

        .btn-secondary:hover {
            background-color: #5a6268;
            text-decoration: none;
            color: white;
        }

    .form-select {
        border-color: var(--teal);
    }

    .form-control {
        border-color: var(--teal);
    }
</style>

<div class="container mt-5" style="max-width: 600px;">
    <!-- Card chính -->
    <div class="card shadow-sm rounded-4">
        <!-- Header của card -->
        <div class="card-header d-flex align-items-center gap-2">
            <i class="fas fa-edit fa-lg"></i>
            <h4 class="mb-0">Chỉnh sửa từ vựng</h4>
        </div>

        <!-- Body của card -->
        <div class="card-body">
            <form asp-action="Edit" method="post" novalidate>
                @Html.AntiForgeryToken()
                @* Hidden field cho Id của từ vựng *@
                <input type="hidden" asp-for="Id" />

                <!-- Dropdown chọn Bài học -->
                <div class="mb-3">
                    <label asp-for="LessonId" class="form-label fw-semibold text-danger">Bài học</label>
                    <select asp-for="LessonId"
                            class="form-select"
                            asp-items="@(ViewBag.Lessons as SelectList)">
                        <option value="">-- Chọn bài học --</option>
                    </select>
                    <span asp-validation-for="LessonId" class="text-danger small"></span>
                </div>

                <!-- Field Kanji -->
                <div class="mb-3">
                    <label asp-for="Kanji" class="form-label fw-semibold text-danger">Kanji</label>
                    <input asp-for="Kanji" class="form-control" />
                    <span asp-validation-for="Kanji" class="text-danger small"></span>
                </div>

                <!-- Field Hiragana -->
                <div class="mb-3">
                    <label asp-for="Hiragana" class="form-label fw-semibold text-danger">Hiragana</label>
                    <input asp-for="Hiragana" class="form-control" />
                    <span asp-validation-for="Hiragana" class="text-danger small"></span>
                </div>

                <!-- Field Romaji -->
                <div class="mb-3">
                    <label asp-for="Romaji" class="form-label fw-semibold text-danger">Romaji</label>
                    <input asp-for="Romaji" class="form-control" />
                    <span asp-validation-for="Romaji" class="text-danger small"></span>
                </div>

                <!-- Field Meaning -->
                <div class="mb-3">
                    <label asp-for="Meaning" class="form-label fw-semibold text-danger">Nghĩa</label>
                    <input asp-for="Meaning" class="form-control" />
                    <span asp-validation-for="Meaning" class="text-danger small"></span>
                </div>

                <!-- Nút Lưu / Quay lại -->
                <div class="d-flex justify-content-center mt-4 gap-3">
                    <button type="submit" class="btn btn-danger px-4 fw-semibold">
                        <i class="fas fa-save me-1"></i> Lưu
                    </button>
                    <a asp-action="Index" class="btn btn-secondary px-4">
                        <i class="fas fa-arrow-left me-1"></i> Quay lại
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Validation Scripts -->
    <partial name="_ValidationScriptsPartial" />
}

<!-- Bootstrap JS bundle -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
