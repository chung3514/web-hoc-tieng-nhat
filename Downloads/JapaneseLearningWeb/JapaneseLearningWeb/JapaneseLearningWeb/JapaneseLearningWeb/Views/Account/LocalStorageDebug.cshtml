@{
    ViewData["Title"] = "Kiểm tra localStorage";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
<div class="container mt-5">
    <div class="card shadow-sm border-0 rounded-3 mx-auto" style="max-width: 600px;">
        <div class="card-body p-4">
            <h3 class="text-center mb-4"><i class="bi bi-search"></i> Kiểm tra Local Storage</h3>
            php-template
            Sao chép
            Chỉnh sửa
            <table class="table table-bordered">
                <tbody>
                    <tr>
                        <th scope="row">User ID</th>
                        <td id="userId">Đang kiểm tra...</td>
                    </tr>
                    <tr>
                        <th scope="row">Selected Course IDs</th>
                        <td id="courseIds">Đang kiểm tra...</td>
                    </tr>
                </tbody>
            </table>

            <div class="text-center mt-4">
                <button class="btn btn-warning me-2" onclick="clearLocalStorageItem('userId')">
                    <i class="bi bi-trash"></i> Xóa userId
                </button>
                <button class="btn btn-danger" onclick="clearLocalStorageItem('selectedCourseIds')">
                    <i class="bi bi-x-circle"></i> Xóa selectedCourseIds
                </button>
            </div>
        </div>
    </div>
</div>
<script> function updateDisplay() { const userId = localStorage.getItem("userId"); const courseIds = JSON.parse(localStorage.getItem("selectedCourseIds") || "[]"); document.getElementById("userId").innerText = userId || "Không có"; document.getElementById("courseIds").innerText = courseIds.length > 0 ? courseIds.join(", ") : "Không có"; } function clearLocalStorageItem(key) { localStorage.removeItem(key); updateDisplay(); } document.addEventListener("DOMContentLoaded", updateDisplay); </script>