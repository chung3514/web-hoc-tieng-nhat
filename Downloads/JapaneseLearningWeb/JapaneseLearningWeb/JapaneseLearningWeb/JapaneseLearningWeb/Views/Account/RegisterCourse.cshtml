            <strong>Tổng tiền dự tính: </strong><span id="totalAmount">0</span> đ
        </div>

        <button type="submit" class="btn btn-primary mt-3">Tiếp tục thanh toán</button>
    </form>
}
else
{
    <p>Không có khóa học nào khả dụng để đăng ký.</p>
}

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var checkboxes = document.querySelectorAll(".course-checkbox");
            var totalSpan = document.getElementById("totalAmount");

            function updateTotal() {
                var total = 0;
                checkboxes.forEach(function (cb) {
                    if (cb.checked) {
                        total += parseInt(cb.dataset.price);
                    }
                });
                totalSpan.textContent = total.toLocaleString();
            }

            checkboxes.forEach(function (cb) {
                cb.addEventListener("change", updateTotal);
            });

            updateTotal();
        });
    </script>
}
  *@
 @using JapaneseLearningWeb.Models
@using JapaneseLearningWeb.Controllers

@{
    ViewData["Title"] = "Xác nhận thanh toán";
    var courses = ViewBag.Courses as List<Course>;
    var vouchers = ViewBag.UserVouchers as List<AccountController.VoucherPickVm>;
}

<style>
    /* ===== CHUẨN UI ĐỒNG BỘ TOÀN SITE ===== */

    .payment-container {
        max-width: 1100px;
    }

    body {
        background: #f7fcfd !important;
    }

    .payment-card {
        background: #fff;
        border-radius: 16px;
    }

    .payment-header {
        background: #17b6b7 !important;
        color: #fff;
        border-radius: 16px 16px 0 0;
        font-weight: 700;
        font-size: 1.15rem;
        text-align: center;
        padding: 16px;
    }

    .section-box {
        background: #fcfdff;
        border-radius: 14px;
        padding: 16px;
        border: 1px solid #e3f7fb;
        margin-bottom: 20px;
    }

    .table thead {
        background: #eafafc;
        color: #17b6b7;
        font-weight: 600;
    }

    .voucher-box {
        background: #e3f7fb;
        border-radius: 14px;
        padding: 16px;
    }

    .total-box {
        background: #fff;
        border-radius: 14px;
        padding: 16px;
        border: 1px dashed #17b6b7;
        text-align: center;
    }

        .total-box strong {
            color: #333;
        }

    .final-total {
        font-size: 1.3rem;
        font-weight: 700;
        color: #dc3545;
    }

    @@media (max-width: 768px) {
        .payment-header {
            font-size: 1rem;
        }
    }
</style>

<div class="container payment-container my-4">

    <!-- CARD -->
    <div class="card shadow-sm payment-card">

        <!-- HEADER -->
        <div class="payment-header">
            <i class="fas fa-credit-card me-2"></i>@ViewData["Title"]
        </div>

        <!-- BODY -->
        <div class="card-body px-4 py-4">

            @if (TempData["Message"] != null)
            {
                <div class="alert alert-info">@TempData["Message"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }

            @if (courses != null && courses.Any(c => !c.IsFree))
            {
                <form asp-controller="Account"
                      asp-action="Payment"
                      method="post"
                      id="paymentForm">

                    <!-- COURSE LIST -->
                    <div class="section-box">
                        <h6 class="fw-bold mb-3 text-danger">
                            <i class="fas fa-book me-2"></i>Khóa học trả phí
                        </h6>

                        <div class="table-responsive">
                            <table class="table table-bordered align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Khóa học</th>
                                        <th>Mô tả</th>
                                        <th>Giá</th>
                                        <th class="text-center">Chọn</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var course in courses.Where(c => !c.IsFree))
                                    {
                                        <tr>
                                            <td>@course.Title</td>
                                            <td>@course.Description</td>
                                            <td>@($"{course.Price:N0}đ")</td>
                                            <td class="text-center">
                                                <input type="checkbox"
                                                       name="selectedCourseIds"
                                                       value="@course.CourseId"
                                                       class="form-check-input course-checkbox"
                                                       data-price="@course.Price" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- VOUCHER -->
                    <div class="voucher-box mb-4">
                        <div class="fw-bold mb-2">
                            🎁 Voucher của bạn
                        </div>

                        <div class="form-check mb-1">
                            <input class="form-check-input voucher-radio"
                                   type="radio"
                                   name="voucherCode"
                                   id="vc_none"
                                   value=""
                                   checked
                                   data-discount="0" />
                            <label class="form-check-label" for="vc_none">
                                Không dùng voucher
                            </label>
                        </div>

                        @if (vouchers != null && vouchers.Count > 0)
                        {
                            var i = 0;
                            foreach (var v in vouchers)
                            {
                                i++;
                                var expText = v.ExpireAt.HasValue
                                ? v.ExpireAt.Value.ToLocalTime().ToString("dd/MM/yyyy")
                                : "Không hạn";

                                <div class="form-check mb-1">
                                    <input class="form-check-input voucher-radio"
                                           type="radio"
                                           name="voucherCode"
                                           id="vc_@i"
                                           value="@v.Code"
                                           data-discount="@v.DiscountAmount" />
                                    <label class="form-check-label" for="vc_@i">
                                        Giảm <b>@($"{v.DiscountAmount:N0}đ")</b>
                                        (@v.Code) – HSD: @expText
                                    </label>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-muted">Bạn chưa có voucher nào.</div>
                        }
                    </div>

                    <!-- TOTAL -->
                    <div class="total-box mb-4">
                        <div><strong>Tạm tính:</strong> <span id="subTotal">0</span> đ</div>
                        <div><strong>Giảm voucher:</strong> <span id="discount">0</span> đ</div>
                        <div class="final-total mt-1">
                            Cần thanh toán: <span id="finalTotal">0</span> đ
                        </div>
                    </div>

                    <!-- SUBMIT -->
                    <div class="text-center">
                        <button type="submit" class="btn btn-danger px-4 py-2 rounded-pill">
                            <i class="fas fa-arrow-right me-1"></i>Tiếp tục thanh toán
                        </button>
                    </div>

                </form>
            }
            else
            {
                <p class="text-center text-muted">
                    Không có khóa học nào khả dụng để đăng ký.
                </p>
            }

        </div>
    </div>
</div>

<!-- ===== JS GIỮ NGUYÊN ===== -->
<script>
    (function () {
        const checkboxes = Array.from(document.querySelectorAll(".course-checkbox"));
        const voucherRadios = Array.from(document.querySelectorAll(".voucher-radio"));

        const subTotalEl = document.getElementById("subTotal");
        const discountEl = document.getElementById("discount");
        const finalTotalEl = document.getElementById("finalTotal");

        const toInt = (v) => {
            const n = parseFloat(String(v || "0").replace(",", "."));
            if (isNaN(n)) return 0;
            return Math.round(n);
        };

        const formatVND = (n) => (n || 0).toLocaleString("vi-VN");

        function getSubTotal() {
            let total = 0;
            for (const cb of checkboxes) {
                if (cb.checked) total += toInt(cb.dataset.price);
            }
            return total;
        }

        function getSelectedVoucherDiscount() {
            const picked = voucherRadios.find(r => r.checked);
            if (!picked) return 0;
            return toInt(picked.dataset.discount);
        }

        function renderTotals() {
            const sub = getSubTotal();
            let dis = getSelectedVoucherDiscount();
            if (dis > sub) dis = sub;

            const final = Math.max(0, sub - dis);

            subTotalEl.textContent = formatVND(sub);
            discountEl.textContent = formatVND(dis);
            finalTotalEl.textContent = formatVND(final);
        }

        checkboxes.forEach(cb => cb.addEventListener("change", renderTotals));
        voucherRadios.forEach(r => r.addEventListener("change", renderTotals));

        renderTotals();
    })();
</script>
