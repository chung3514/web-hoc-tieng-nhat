@model UserProfileViewModel

<style>
    /* ===== CHUẨN UI GIỐNG CÁC TRANG INDEX ===== */

    .profile-container {
        max-width: 1100px;
    }

    body {
        background: #f7fcfd !important;
        font-family: 'Roboto', sans-serif;
    }

    .profile-card {
        background: #fff;
        border-radius: 16px;
    }

    .profile-header {
        background: #17b6b7 !important;
        color: #fff !important;
        border-radius: 16px 16px 0 0;
        font-weight: 700;
        font-size: 1.15rem;
        text-align: center;
        padding: 16px;
    }

    .profile-label {
        font-weight: 600;
        color: #444;
        margin-bottom: 4px;
    }

    .profile-value {
        color: #666;
        margin-bottom: 16px;
    }

    .profile-section-title {
        font-weight: 700;
        color: #17b6b7;
        margin-bottom: 12px;
    }

    .course-item {
        background: #fcfdff;
        border-radius: 12px;
        padding: 12px 16px;
        margin-bottom: 8px;
        border: 1px solid #e3f7fb;
        font-weight: 500;
    }

        .course-item:hover {
            background: #e3f7fb;
        }

    @@media (max-width: 768px) {
        .profile-header {
            font-size: 1rem;
        }
    }
</style>

<div class="container profile-container my-4">
    <div class="row justify-content-center">
        <main class="col-12">

            <div class="card shadow-sm profile-card">

                <!-- HEADER -->
                <div class="profile-header">
                    <i class="fas fa-id-badge me-2"></i>Hồ sơ cá nhân
                </div>

                <!-- BODY -->
                <div class="card-body px-4 py-4">

                    <div class="mb-3">
                        <div class="profile-label">Tên đăng nhập</div>
                        <div class="profile-value">@Model.UserName</div>
                    </div>

                    <div class="mb-3">
                        <div class="profile-label">Email</div>
                        <div class="profile-value">@Model.Email</div>
                    </div>

                    <div class="mb-4">
                        <div class="profile-label">Chức vụ</div>
                        <div class="profile-value">
                            @string.Join(", ", Model.Roles)
                        </div>
                    </div>

                    <!-- COURSES -->
                    <div>
                        <h5 class="profile-section-title">
                            <i class="fas fa-book-open me-2"></i>Khóa học đã đăng ký
                        </h5>

                        @if (Model.EnrolledCourses.Any())
                        {
                            @foreach (var course in Model.EnrolledCourses)
                            {
                                <div class="course-item">
                                    <i class="fas fa-check-circle text-success me-2"></i>
                                    @course
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted">Chưa đăng ký khóa học nào.</p>
                        }
                    </div>

                </div>
            </div>

        </main>
    </div>
</div>
