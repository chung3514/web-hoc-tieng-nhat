@{
    ViewData["Title"] = "Quên mật khẩu";
}

<style>
    /* ===== CHUẨN UI ĐỒNG BỘ TOÀN SITE ===== */

    body {
        background: #f7fcfd !important;
    }

    .forgot-container {
        max-width: 420px;
    }

    .forgot-card {
        background: #fff;
        border-radius: 16px;
    }

    .forgot-header {
        background: #17b6b7;
        color: #fff;
        border-radius: 16px 16px 0 0;
        font-weight: 700;
        font-size: 1.15rem;
        text-align: center;
        padding: 16px;
    }

    .forgot-desc {
        font-size: 0.95rem;
        color: #666;
        text-align: center;
        margin-bottom: 20px;
    }

    .form-label {
        font-weight: 600;
        color: #444;
    }

    .btn-primary {
        background: #17b6b7;
        border: none;
        font-weight: 600;
        border-radius: 30px;
        padding: 10px;
    }

        .btn-primary:hover {
            background: #0ba0a1;
        }

    .alert {
        border-radius: 12px;
        font-weight: 500;
    }
</style>

<div class="container forgot-container my-5">
    <div class="card shadow-sm forgot-card">

        <!-- HEADER -->
        <div class="forgot-header">
            <i class="fas fa-unlock-alt me-2"></i>@ViewData["Title"]
        </div>

        <!-- BODY -->
        <div class="card-body px-4 py-4">

            <p class="forgot-desc">
                Nhập email bạn đã đăng ký.
                Hệ thống sẽ gửi hướng dẫn đặt lại mật khẩu.
            </p>

            @* Thông báo gửi email thành công *@
            @if (TempData["Message"] != null)
            {
                <div class="alert alert-success text-center">
                    @TempData["Message"]
                </div>
            }

            @* Thông báo lỗi *@
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger text-center">
                    @TempData["Error"]
                </div>
            }

            <form asp-action="ForgotPassword" method="post" novalidate>

                <div class="mb-3">
                    <label for="email" class="form-label">Email đăng ký</label>
                    <input type="email"
                           id="email"
                           name="email"
                           class="form-control"
                           placeholder="example@email.com"
                           required />
                    <div class="invalid-feedback">
                        Vui lòng nhập email hợp lệ.
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100 mt-3">
                    <i class="fas fa-paper-plane me-1"></i>Gửi hướng dẫn
                </button>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
