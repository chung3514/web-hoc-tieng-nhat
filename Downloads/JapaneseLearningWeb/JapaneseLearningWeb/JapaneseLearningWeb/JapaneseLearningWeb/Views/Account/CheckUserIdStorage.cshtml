@{
    ViewData["Title"] = "Kiểm tra Local Storage";
    var userId = ViewBag.UserId as string;
}

<div class="container mt-5">
    <h3>Kiểm tra lưu UserId vào Local Storage</h3>

    <p><strong>UserId từ server:</strong> @userId</p>

    <p><strong>UserId trong Local Storage:</strong> <span id="localUserId">Chưa có</span></p>

    <button onclick="saveUserIdToLocalStorage()">Lưu userId vào Local Storage</button>
    <button onclick="clearLocalStorage()">Xóa Local Storage</button>
</div>

<script>
    function saveUserIdToLocalStorage() {
        const userId = '@userId';
        if (userId) {
            localStorage.setItem("userId", userId);
            document.getElementById("localUserId").textContent = userId;
        }
    }

    function clearLocalStorage() {
        localStorage.removeItem("userId");
        document.getElementById("localUserId").textContent = "Đã xóa";
    }

    // Kiểm tra nếu đã có userId trong localStorage
    document.addEventListener("DOMContentLoaded", function () {
        const localUserId = localStorage.getItem("userId");
        if (localUserId) {
            document.getElementById("localUserId").textContent = localUserId;
        }
    });
</script>
