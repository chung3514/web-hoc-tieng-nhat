@* @model List<JapaneseLearningWeb.Models.PurchaseHistoryViewModel> *@

@* @{ *@
@* 	ViewData["Title"] = "Lịch sử mua khóa học"; *@
@* } *@

@* <h2>Lịch sử mua khóa học</h2> *@
@* @if (Model != null && Model.Any()) *@
@* { *@
@* 	<table class="table table-striped"> *@
@* 		<thead> *@
@* 			<tr> *@
@* 				<th>Tên khóa học</th> *@
@* 				<th>Ngày mua</th> *@
@* 				<th>Giá</th> *@
@* 			</tr> *@
@* 		</thead> *@
@* 		<tbody> *@
@* 			@foreach (var item in Model) *@
@* 			{ *@
@* 				<tr> *@
@* 					<td>@item.CourseTitle</td> *@
@* 					<td>@item.EnrolledAt.ToString("dd/MM/yyyy HH:mm")</td> *@
@* 					<td>@item.Price.ToString("N0") đ</td> *@
@* 				</tr> *@
@* 			} *@
@* 		</tbody> *@
@* 	</table> *@
@* } *@
@* else *@
@* { *@
@* 	<p>Bạn chưa mua khóa học nào.</p> *@
@* } *@