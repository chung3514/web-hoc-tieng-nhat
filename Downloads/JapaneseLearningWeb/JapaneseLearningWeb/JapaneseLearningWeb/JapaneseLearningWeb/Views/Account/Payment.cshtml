 *@
@using JapaneseLearningWeb.Models
@{
    ViewData["Title"] = "Xác nhận thanh toán";

    var selectedCourses = ViewBag.SelectedCourses as List<Course> ?? new List<Course>();
    decimal subTotal = ViewBag.SubTotal != null ? (decimal)ViewBag.SubTotal : 0m;
    decimal discount = ViewBag.Discount != null ? (decimal)ViewBag.Discount : 0m;
    decimal finalTotal = ViewBag.FinalTotal != null ? (decimal)ViewBag.FinalTotal : subTotal;
    string voucherCode = ViewBag.VoucherCode as string ?? "";
}

<div class="container mt-5">
    <h2 class="text-center text-danger mb-4">@ViewData["Title"]</h2>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger text-center">@TempData["Error"]</div>
    }

    <div class="table-responsive mb-4" style="max-width:900px;margin:auto;">
        <table class="table table-bordered table-striped text-center align-middle">
            <thead class="table-danger">
                <tr>
                    <th>Tên khóa học</th>
                    <th>Giá</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var course in selectedCourses)
                {
                    <tr>
                        <td>@course.Title</td>
                        <td>@($"{course.Price:N0} đ")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div style="max-width:900px;margin:auto;" class="mb-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div><b>Tạm tính</b></div>
                    <div>@($"{subTotal:N0} đ")</div>
                </div>

                <div class="d-flex justify-content-between mt-2">
                    <div>
                        <b>Giảm voucher</b>
                        @if (!string.IsNullOrWhiteSpace(voucherCode))
                        {
                            <span class="badge bg-info text-dark ms-1">@voucherCode</span>
                        }
                    </div>
                    <div>- @($"{discount:N0} đ")</div>
                </div>

                <hr />

                <div class="d-flex justify-content-between" style="font-size:18px;">
                    <div><b>Cần thanh toán</b></div>
                    <div class="text-danger"><b>@($"{finalTotal:N0} đ")</b></div>
                </div>
            </div>
        </div>
    </div>

    <div class="text-center">
        <form asp-controller="Payment" asp-action="CreatePaymentMomo" method="post">
            <!-- Amount phải là số cuối sau khi trừ voucher -->
            <input type="hidden" name="Amount" value="@finalTotal" />

            <!-- để MoMo/Server biết đơn nào -->
            <input type="hidden" name="OrderId" value="@Guid.NewGuid().ToString("N")" />
            <input type="hidden" name="OrderInfo" value="Thanh toán MoMo cho khóa học" />
            <input type="hidden" name="FullName" value="Name" />

            <!-- gửi voucherCode qua PaymentController để mark IsUsed sau khi thanh toán OK -->
            <input type="hidden" name="VoucherCode" value="@voucherCode" />

            <!-- gửi danh sách courseId qua PaymentController -->
            @foreach (var c in selectedCourses)
            {
                <input type="hidden" name="CourseIds" value="@c.CourseId" />
            }

            <button class="btn btn-danger btn-lg" type="submit">
                Thanh toán với MoMo
            </button>
        </form>
    </div>
</div>

<script>
    // Lưu courseIds để sau khi MoMo callback về bạn ConfirmPaidCourses
    document.addEventListener("DOMContentLoaded", () => {
        const courseIds = [];
    @foreach (var course in selectedCourses)
    {
        <text>courseIds.push(@course.CourseId);</text>
    }

        localStorage.setItem("selectedCourseIds", JSON.stringify(courseIds));
        localStorage.setItem("voucherCode", "@voucherCode");
        console.log("Saved selectedCourseIds:", courseIds, "voucher:", "@voucherCode");
    });
</script>
