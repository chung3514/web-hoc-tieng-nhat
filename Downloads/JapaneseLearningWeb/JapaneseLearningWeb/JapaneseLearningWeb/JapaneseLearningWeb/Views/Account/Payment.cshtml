@using JapaneseLearningWeb.Models
@{
    ViewData["Title"] = "Xác nhận thanh toán";
    var selectedCourses = ViewBag.SelectedCourses as List<Course>;
    var total = (decimal)ViewBag.Total;
}

<h2>Xác nhận thanh toán</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table">
    <thead>
        <tr>
            <th>Tên khóa học</th>
            <th>Giá</th>
        </tr>
    </thead>
