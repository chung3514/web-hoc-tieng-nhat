        @foreach (var course in selectedCourses)
        {
            <tr>
                <td>@course.Title</td>
                <td>@course.Price.ToString("N0") đ</td>
            </tr>
        }
    </tbody>
</table>

<h4>Tổng tiền: <span class="text-danger">@total.ToString("N0") đ</span></h4>

