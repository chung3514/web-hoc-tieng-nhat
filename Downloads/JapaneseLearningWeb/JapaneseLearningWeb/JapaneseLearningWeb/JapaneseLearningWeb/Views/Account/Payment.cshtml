</form>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const courseIds = [];

        @foreach (var course in ViewBag.SelectedCourses)
        {
            <text>courseIds.push(@course.CourseId);</text>
        }

            localStorage.setItem("selectedCourseIds", JSON.stringify(courseIds));
            console.log("Đã lưu courseIds vào localStorage:", courseIds);
        });
    </script>
