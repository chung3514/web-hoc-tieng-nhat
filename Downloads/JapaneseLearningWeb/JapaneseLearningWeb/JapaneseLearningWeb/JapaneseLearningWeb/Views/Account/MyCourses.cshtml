@using JapaneseLearningWeb.Models
@model List<Course>

@{
    ViewData["Title"] = "Khóa học của tôi";
    var freeCourses = Model.Where(c => c.IsFree).ToList();
    var paidCourses = Model.Where(c => !c.IsFree).ToList();
}

<style>
    /* ===== CHUẨN UI GIỐNG CÁC TRANG INDEX ===== */

    .mycourse-container {
        max-width: 1100px;
    }

    body {
        background: #f7fcfd !important;
    }

    .mycourse-card {
        background: #fff;
        border-radius: 16px;
    }

    .mycourse-header {
        background: #17b6b7 !important;
        color: #fff !important;
        border-radius: 16px 16px 0 0;
        font-weight: 700;
        font-size: 1.15rem;
    }

    .course-section-title {
        font-weight: 700;
        color: #17b6b7;
        margin-bottom: 1rem;
    }

    .list-group-item {
        border-radius: 12px;
        margin-bottom: 8px;
        padding: 14px 18px;
        font-weight: 500;
        background: #fcfdff;
        border: 1px solid #e3f7fb;
    }

    .badge {
        font-size: 0.95rem;
        padding: 6px 12px;
        border-radius: 20px;
    }

    .btn-buy {
        background: #17b6b7;
        color: #fff;
        font-weight: 600;
        border-radius: 30px;
        padding: 12px 36px;
    }

        .btn-buy:hover {
            background: #0fa2a3;
            color: #fff;
        }

    @@media (max-width: 768px) {
        .list-group-item {
            font-size: 0.95rem;
        }

        .btn-buy {
            width: 100%;
        }
    }
</style>

<div class="container mycourse-container my-4">

    <!-- HEADER -->
    <div class="card shadow-sm mb-4 mycourse-card">
        <div class="card-header mycourse-header">
            <i class="fas fa-book-open me-2"></i>@ViewData["Title"]
        </div>
    </div>

    <!-- FREE COURSES -->
    <div class="mb-5">
        <h5 class="course-section-title">
            <i class="fas fa-unlock me-2"></i>Khóa học miễn phí
        </h5>

        @if (freeCourses.Any())
        {
            <ul class="list-group">
                @foreach (var course in freeCourses)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span>@course.Title</span>
                        <span class="badge bg-success">Miễn phí</span>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="text-muted">Không có khóa học miễn phí nào.</p>
        }
    </div>

    <!-- PAID COURSES -->
    <div class="mb-5">
        <h5 class="course-section-title">
            <i class="fas fa-lock me-2"></i>Khóa học đã mua
        </h5>

        @if (paidCourses.Any())
        {
            <ul class="list-group">
                @foreach (var course in paidCourses)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span>@course.Title</span>
                        <span class="badge bg-info">
                            @course.Price.ToString("N0") VND
                        </span>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="text-muted">Bạn chưa mua khóa học nào.</p>
        }
    </div>

    <!-- BUY MORE -->
    <div class="text-center">
        <a asp-controller="Account"
           asp-action="RegisterCourse"
           class="btn btn-buy btn-lg">
            <i class="fas fa-shopping-cart me-2"></i>Mua thêm khóa học
        </a>
    </div>

</div>
