@model JapaneseLearningWeb.Models.Kanji

@{
    ViewData["Title"] = "Xóa Kanji";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="card shadow-sm border-0 rounded-4">

                <!-- HEADER -->
                <div class="card-header bg-teal text-white d-flex align-items-center gap-2">
                    <i class="fas fa-trash-alt fa-lg"></i>
                    <h3 class="card-title mb-0">Xóa Kanji</h3>
                </div>

                <!-- BODY -->
                <div class="card-body">

                    <!-- WARNING -->
                    <div class="alert alert-warning">
                        Bạn có chắc chắn muốn xóa Kanji này?
                        Hành động này <strong>không thể hoàn tác</strong> và sẽ xóa
                        các liên kết từ vựng liên quan.
                    </div>

                    <!-- INFO -->
                    <h4 class="text-teal mb-3">Thông tin Kanji</h4>

                    <dl class="row">
                        <dt class="col-sm-4 text-muted">Ký tự</dt>
                        <dd class="col-sm-8 fw-bold text-teal">@Model.Character</dd>

                        <dt class="col-sm-4 text-muted">Âm On</dt>
                        <dd class="col-sm-8">
                            @(!string.IsNullOrWhiteSpace(Model.OnYomi) ? Model.OnYomi : "Không có")
                        </dd>

                        <dt class="col-sm-4 text-muted">Âm Kun</dt>
                        <dd class="col-sm-8">
                            @(!string.IsNullOrWhiteSpace(Model.KunYomi) ? Model.KunYomi : "Không có")
                        </dd>

                        <dt class="col-sm-4 text-muted">Nghĩa</dt>
                        <dd class="col-sm-8">@Model.Meaning</dd>

                        <dt class="col-sm-4 text-muted">Bài học</dt>
                        <dd class="col-sm-8">
                            @(Model.Lesson?.Title ?? "Chưa có bài học")
                        </dd>
                    </dl>

                    <!-- VOCAB -->
                    <h4 class="text-teal mt-4 mb-3">Từ vựng liên quan</h4>

                    @if (Model.VocabularyKanjis != null && Model.VocabularyKanjis.Any())
                    {
                        <div class="table-responsive mb-3">
                            <table class="table table-bordered align-middle">
                                <thead class="bg-teal text-white">
                                    <tr>
                                        <th>Kanji</th>
                                        <th>Hiragana</th>
                                        <th>Romaji</th>
                                        <th>Nghĩa</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var vk in Model.VocabularyKanjis)
                                    {
                                        <tr>
                                            <td>@vk.Vocabulary.Kanji</td>
                                            <td>@vk.Vocabulary.Hiragana</td>
                                            <td>@vk.Vocabulary.Romaji</td>
                                            <td>@vk.Vocabulary.Meaning</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <p class="text-danger fw-semibold">
                            <i class="fas fa-exclamation-circle me-1"></i>
                            Các liên kết từ vựng ở trên cũng sẽ bị xóa.
                        </p>
                    }
                    else
                    {
                        <p class="fst-italic text-muted">
                            Không có từ vựng nào liên quan.
                        </p>
                    }

                    <!-- ACTIONS -->
                    <form asp-action="DeleteConfirmed"
                          method="post"
                          class="mt-4 d-flex justify-content-end gap-2">

                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />

                        <button type="submit" class="btn btn-teal px-4 fw-semibold">
                            <i class="fas fa-trash-alt me-1"></i> Xóa
                        </button>

                        <a asp-action="Index" class="btn btn-secondary px-4">
                            <i class="fas fa-arrow-left me-1"></i> Quay lại
                        </a>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --teal: #17b6b7;
        --teal-hover: #0ba0a1;
    }

    .bg-teal {
        background: var(--teal) !important;
    }

    .text-teal {
        color: var(--teal) !important;
    }

    .btn-teal {
        background: var(--teal) !important;
        color: #fff !important;
        border: none;
        border-radius: 30px;
        font-weight: 600;
        transition: background 0.2s;
    }

        .btn-teal:hover,
        .btn-teal:focus {
            background: var(--teal-hover) !important;
            color: #fff !important;
        }

    .card-header {
        background: var(--teal) !important;
        color: #fff;
        font-weight: 600;
        font-size: 1.5rem;
    }

    .alert-warning {
        background-color: #ffe3e3;
        color: #b52c3b;
        border-color: #dc3545;
    }
</style>
