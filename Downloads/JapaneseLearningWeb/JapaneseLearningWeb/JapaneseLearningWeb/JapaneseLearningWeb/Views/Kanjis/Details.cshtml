@model JapaneseLearningWeb.Models.Kanji

@{
    ViewData["Title"] = "Chi tiết Kanji";
}

<div class="container">
    <div class="row justify-content-center">
        <main class="col-md-10">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-teal text-white text-center rounded-top">
                    <h3 class="card-title mb-0">
                        <i class="fas fa-language me-2"></i>
                        Kanji: @Model.Character
                    </h3>
                </div>

                <div class="card-body">
                    <div class="row g-3">
                        <!-- Cột trái -->
                        <div class="col-md-6">
                            <div class="d-flex align-items-center mb-3">
                                <i class="fas fa-pen-nib me-3 text-teal fa-2x"></i>
                                <div>
                                    <h6 class="text-muted mb-1">Ký tự</h6>
                                    <h4 class="text-teal">@Model.Character</h4>
                                </div>
                            </div>

                            <div class="d-flex align-items-center mb-3">
                                <i class="fas fa-volume-up me-3 text-teal fa-2x"></i>
                                <div>
                                    <h6 class="text-muted mb-1">Âm On</h6>
                                    <p>@(string.IsNullOrEmpty(Model.OnYomi) ? "Không có" : Model.OnYomi)</p>
                                </div>
                            </div>

                            <div class="d-flex align-items-center mb-3">
                                <i class="fas fa-volume-down me-3 text-teal fa-2x"></i>
                                <div>
                                    <h6 class="text-muted mb-1">Âm Kun</h6>
                                    <p>@(string.IsNullOrEmpty(Model.KunYomi) ? "Không có" : Model.KunYomi)</p>
                                </div>
                            </div>
                        </div>

                        <!-- Cột phải -->
                        <div class="col-md-6">
                            <div class="d-flex align-items-center mb-3">
                                <i class="fas fa-book-open me-3 text-teal fa-2x"></i>
                                <div>
                                    <h6 class="text-muted mb-1">Nghĩa</h6>
                                    <p>@Model.Meaning</p>
                                </div>
                            </div>

                            <div class="d-flex align-items-center mb-3">
                                <i class="fas fa-chalkboard-teacher me-3 text-teal fa-2x"></i>
                                <div>
                                    <h6 class="text-muted mb-1">Bài học</h6>
                                    <p>@(Model.Lesson?.Title ?? "Chưa có bài học")</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Bộ (Radicals) -->
                    <div class="row g-3 mt-3">
                        <div class="col-12">
                            <div class="d-flex align-items-center mb-3">
                                <i class="fas fa-puzzle-piece me-3 text-teal fa-2x"></i>
                                <div>
                                    <h6 class="text-muted mb-1">Bộ (Radicals)</h6>
                                    @if (Model.KanjiKanjiRadicals != null && Model.KanjiKanjiRadicals.Any())
                                    {
                                        <div>
                                            @foreach (var kkr in Model.KanjiKanjiRadicals)
                                            {
                                                <span class="badge bg-secondary me-1">@kkr.KanjiRadical.RadicalKanji</span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <p class="text-muted">Không có bộ nào.</p>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Từ vựng liên quan -->
                    <h4 class="mt-5 mb-3 text-teal">
                        <i class="fas fa-list-ul me-2"></i>
                        Từ vựng liên quan
                    </h4>

                    @if (Model.VocabularyKanjis != null && Model.VocabularyKanjis.Any())
                    {
                        <div class="row g-4">
                            @foreach (var vk in Model.VocabularyKanjis)
                            {
                                var vocabulary = vk.Vocabulary;
                                <div class="col-md-6">
                                    <div class="card h-100 shadow-sm border-0">
                                        <div class="card-body">
                                            <h5 class="card-title text-center text-teal">@vocabulary.Kanji</h5>
                                            <div class="mb-2">
                                                <i class="fas fa-spell-check me-2 text-teal"></i>
                                                <strong>Hiragana:</strong> @vocabulary.Hiragana
                                            </div>
                                            <div class="mb-2">
                                                <i class="fas fa-globe me-2 text-teal"></i>
                                                <strong>Romaji:</strong> @vocabulary.Romaji
                                            </div>
                                            <div class="mb-3">
                                                <i class="fas fa-book-open me-2 text-teal"></i>
                                                <strong>Nghĩa:</strong> @vocabulary.Meaning
                                            </div>
                                            <div class="text-center">
                                                <a asp-controller="Vocabularies" asp-action="Details" asp-route-id="@vocabulary.Id" class="btn btn-outline-info btn-sm">
                                                    <i class="fas fa-info-circle me-1"></i>Chi tiết
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-exclamation-circle fa-3x text-muted mb-3"></i>
                            <p class="text-muted">Không có từ vựng nào liên quan.</p>
                        </div>
                    }
                </div>

                <div class="card-footer bg-light text-center">
                    @if (User.IsInRole("Admin") || User.IsInRole("Employee"))
                    {
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-warning btn-sm me-2">
                            <i class="fas fa-edit me-1"></i>Sửa
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger btn-sm me-2">
                            <i class="fas fa-trash-alt me-1"></i>Xóa
                        </a>
                    }
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="fas fa-arrow-left me-1"></i>Quay lại
                    </a>
                </div>
            </div>
        </main>
    </div>
</div>

<style>
    .card-header {
        border-radius: 18px 18px 0 0;
        background-color: #17b6b7;
    }

    .text-teal {
        color: #17b6b7;
    }

    .btn-outline-info,
    .btn-outline-warning,
    .btn-outline-danger,
    .btn-outline-secondary {
        transition: background-color 0.2s, color 0.2s;
    }

        .btn-outline-info:hover {
            background-color: #0dcaf0;
            color: white;
        }

        .btn-outline-warning:hover {
            background-color: #ffc107;
            color: white;
        }

        .btn-outline-danger:hover {
            background-color: #dc3545;
            color: white;
        }

        .btn-outline-secondary:hover {
            background-color: #6c757d;
            color: white;
        }
</style>
