@model JapaneseLearningWeb.Models.PagedListViewModel<JapaneseLearningWeb.Models.Kanji>

@{
    ViewData["Title"] = "Danh sách Kanji";
    int currentPage = Model.PageNumber;
    int pageSize = Model.PageSize;
    int totalPages = (int)Math.Ceiling((double)Model.TotalItems / pageSize);
    var courses = ViewBag.Courses as List<Course>;
    int? selectedCourseId = ViewBag.SelectedCourseId as int?;
}

<style>
    /* ===== CHUẨN GIỐNG GRAMMAR ===== */

    .kanji-container {
        max-width: 1100px;
    }

    :root {
        --teal: #17b6b7;
        --teal-hover: #0ba0a1;
        --teal-bg: #e3f7fb;
    }

    .card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 4px 18px rgba(0,0,0,0.06);
    }

    .card-header {
        background-color: var(--teal);
        color: #fff;
        border-radius: 12px 12px 0 0;
    }

    .card-body {
        background: #f7fcfd;
    }

    .search-bar-kanji {
        background: #eafafc;
        border-radius: 8px;
    }

    .kanji-item-card {
        background: #fcfdff;
        border-radius: 12px;
        min-height: 330px;
    }

    .btn-outline-info,
    .btn-outline-warning,
    .btn-outline-danger {
        min-width: 80px;
        font-weight: 600;
    }

    .btn-outline-info {
        border-color: var(--teal);
        color: var(--teal);
    }

        .btn-outline-info:hover {
            background: var(--teal);
            color: #fff;
        }

    .btn-outline-warning:hover {
        background: #e0a800;
        color: #fff;
    }

    .btn-outline-danger:hover {
        background: #dc3545;
        color: #fff;
    }

    .pagination .page-link {
        border-radius: 8px;
        margin: 0 4px;
    }

    .pagination .active .page-link {
        background: var(--teal);
        border-color: var(--teal);
        color: #fff;
    }
</style>

<div class="container kanji-container my-4">
    <div class="card">

        <!-- HEADER -->
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                <i class="fas fa-book-open me-2"></i>@ViewData["Title"]
            </h5>

            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Create" class="btn btn-light btn-sm">
                    <i class="fas fa-plus-circle me-1"></i> Tạo Kanji
                </a>
            }
        </div>

        <!-- BODY -->
        <div class="card-body">

            <!-- FILTER -->
            <form asp-action="Index" method="get" class="row g-2 mb-4">
                <div class="col-md-4">
                    <select name="courseId" class="form-select" onchange="this.form.submit()">
                        <option value="">-- Chọn khóa học --</option>
                        @foreach (var course in courses)
                        {
                            <option value="@course.CourseId"
                                    selected="@(selectedCourseId == course.CourseId ? "selected" : null)">
                                @course.Title @(course.IsFree ? "(Miễn phí)" : "")
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <div class="input-group search-bar-kanji">
                        <span class="input-group-text bg-white border-0">
                            <i class="fas fa-search text-info"></i>
                        </span>
                        <input type="text"
                               name="keyword"
                               value="@Model.Keyword"
                               class="form-control border-0"
                               placeholder="Tìm Kanji hoặc nghĩa..." />
                    </div>
                </div>

                <div class="col-md-2 d-grid">
                    <button type="submit" class="btn btn-info text-white">
                        Tìm kiếm
                    </button>
                </div>
            </form>

            @if (!string.IsNullOrEmpty(Model.Keyword))
            {
                <div class="mb-3">
                    <a asp-action="Index"
                       asp-route-courseId="@selectedCourseId"
                       class="btn btn-outline-info btn-sm">
                        Xóa bộ lọc
                    </a>
                </div>
            }

            <!-- KANJI GRID -->
            <div class="row g-4">
                @if (Model.Items.Any())
                {
                    @foreach (var kanji in Model.Items)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card kanji-item-card h-100 shadow-sm">
                                <div class="card-body text-center">
                                    <h3 class="mb-3 text-danger fw-bold" style="font-size:2.5rem">
                                        @kanji.Character
                                    </h3>

                                    <div class="mb-2"><strong>Âm On:</strong> @kanji.OnYomi</div>
                                    <div class="mb-2"><strong>Âm Kun:</strong> @kanji.KunYomi</div>
                                    <div class="mb-2"><strong>Nghĩa:</strong> @kanji.Meaning</div>
                                    <div class="mb-3">
                                        <strong>Bài học:</strong> @(kanji.Lesson?.Title ?? "Chưa có")
                                    </div>

                                    <div class="d-flex justify-content-center gap-2">
                                        <a asp-action="Details" asp-route-id="@kanji.Id"
                                           class="btn btn-outline-info btn-sm">
                                            Chi tiết
                                        </a>

                                        @if (User.IsInRole("Admin") || User.IsInRole("Employee"))
                                        {
                                            <a asp-action="Edit" asp-route-id="@kanji.Id"
                                               class="btn btn-outline-warning btn-sm">
                                                Sửa
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@kanji.Id"
                                               class="btn btn-outline-danger btn-sm">
                                                Xóa
                                            </a>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-center py-5 text-muted">
                        Không tìm thấy Kanji nào.
                    </div>
                }
            </div>

            <!-- PAGINATION -->
            @if (totalPages > 1)
            {
                <nav class="mt-4">
                    <ul class="pagination justify-content-center">
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link"
                                   asp-route-pageNumber="@i"
                                   asp-route-pageSize="@pageSize"
                                   asp-route-keyword="@Model.Keyword"
                                   asp-route-courseId="@selectedCourseId">
                                    @i
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>
