@model JapaneseLearningWeb.Models.Kanji
@{
    ViewData["Title"] = "Tạo mới Kanji";
    var radicals = ViewBag.Radicals as List<SelectListItem>;
}

@section Styles {
    <style>
        :root {
            --teal: #17b6b7;
            --teal-hover: #0ba0a1;
            --teal-light: #f0fdfd;
        }

        .kanji-create-page {
            font-family: 'Montserrat', sans-serif;
            font-size: 14.5px;
            font-weight: 400;
            color: #334155;
        }

        .kanji-container {
            max-width: 900px;
            margin: 32px auto;
        }

        /* CARD */
        .card {
            border: none;
            border-radius: 16px;
            box-shadow: 0 6px 24px rgba(23,182,183,0.12);
            background: #fff;
        }

        .card-header {
            background: var(--teal);
            color: #fff;
            border-radius: 16px 16px 0 0;
            padding: 16px 22px;
            font-size: 18px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .card-body {
            padding: 26px;
            background: var(--teal-light);
        }

        /* FORM */
        .form-label {
            font-weight: 600;
            color: var(--teal);
            margin-bottom: 6px;
        }

        .form-control,
        .form-select {
            border-radius: 10px;
            padding: 10px 14px;
            font-size: 14.5px;
            border: 1.5px solid var(--teal);
            background: #fff;
            color: #334155;
        }

            .form-control:focus,
            .form-select:focus {
                border-color: var(--teal-hover);
                box-shadow: 0 0 0 0.15rem rgba(23,182,183,.25);
            }

        /* RADICAL TABLE */
        .radicals-wrapper {
            border: 1.5px solid var(--teal);
            border-radius: 12px;
            overflow: hidden;
        }

            .radicals-wrapper table {
                margin-bottom: 0;
                font-size: 13.5px;
            }

            .radicals-wrapper thead {
                background: var(--teal);
                color: #fff;
            }

            .radicals-wrapper tbody tr {
                background: #f0fdfd;
            }

        #radicalSearch {
            border-radius: 999px;
            border: 1.5px solid var(--teal);
            padding: 8px 14px;
            font-size: 13.5px;
        }

        /* SELECTED RADICALS */
        #selectedRadicals .list-group-item {
            border-radius: 999px;
            background: rgba(23,182,183,0.12);
            color: #0f766e;
            font-weight: 500;
            font-size: 13.5px;
        }

        /* BUTTONS */
        .btn-primary {
            background: var(--teal);
            border: none;
            border-radius: 30px;
            padding: 10px 30px;
            font-weight: 600;
            box-shadow: 0 4px 12px rgba(23,182,183,0.35);
        }

            .btn-primary:hover {
                background: var(--teal-hover);
            }

        .btn-outline-primary {
            border-radius: 30px;
            padding: 10px 30px;
            font-weight: 600;
            border: 2px solid var(--teal);
            color: var(--teal);
            background: #fff;
        }

            .btn-outline-primary:hover {
                background: var(--teal);
                color: #fff;
            }

        .btn-outline-teal {
            border: 1.5px solid var(--teal);
            color: var(--teal);
            background: #fff;
        }

            .btn-outline-teal:hover {
                background: var(--teal);
                color: #fff;
            }
    </style>
}

<div class="kanji-create-page">
    <div class="kanji-container">
        <div class="card">

            <!-- HEADER -->
            <div class="card-header">
                <i class="fas fa-plus-circle"></i>
                Tạo mới Kanji
            </div>

            <!-- BODY -->
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div class="row">

                        <!-- LEFT -->
                        <div class="col-md-7">
                            <div class="mb-3">
                                <label class="form-label">Kanji</label>
                                <input asp-for="Character" class="form-control" />
                                <span asp-validation-for="Character" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Onyomi</label>
                                <input asp-for="OnYomi" class="form-control" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Kunyomi</label>
                                <input asp-for="KunYomi" class="form-control" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Nghĩa</label>
                                <input asp-for="Meaning" class="form-control" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Bài học</label>
                                <select asp-for="LessonId" class="form-select" asp-items="ViewBag.Lessons">
                                    <option value="">-- Chọn bài học --</option>
                                </select>
                            </div>
                        </div>

                        <!-- RIGHT -->
                        <div class="col-md-5">
                            <label class="form-label">Chọn Bộ thủ</label>
                            <input type="text" id="radicalSearch" class="form-control mb-2" placeholder="Tìm bộ thủ..." />

                            <div class="radicals-wrapper mb-3" style="max-height:260px; overflow:auto;">
                                <table class="table table-sm">
                                    <thead>
                                        <tr>
                                            <th>Bộ</th>
                                            <th>Nghĩa</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody id="radicalsTable">
                                        @foreach (var r in radicals)
                                        {
                                            var parts = r.Text.Split(" - ");
                                            <tr data-search="@r.Text.ToLower()">
                                                <td class="fw-bold">@parts[0]</td>
                                                <td>@(parts.Length > 1 ? parts[1] : "")</td>
                                                <td class="text-end">
                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-teal add-radical"
                                                            data-id="@r.Value"
                                                            data-text="@r.Text">
                                                        <i class="fas fa-plus"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <label class="form-label">Đã chọn</label>
                            <ul id="selectedRadicals" class="list-group mb-3"></ul>
                            <input type="hidden" name="SelectedRadicalIds" id="SelectedRadicalIds" />
                        </div>
                    </div>

                    <div class="d-flex justify-content-center gap-3 mt-4">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-1"></i> Tạo
                        </button>
                        <a asp-action="Index" class="btn btn-outline-primary">
                            <i class="fas fa-arrow-left me-1"></i> Quay lại
                        </a>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        const selected = new Map();

        $('#radicalSearch').on('input', function () {
            const keyword = $(this).val().toLowerCase();
            $('#radicalsTable tr').each(function () {
                $(this).toggle($(this).data('search')?.includes(keyword));
            });
        });

        $('.add-radical').click(function () {
            const id = $(this).data('id');
            const text = $(this).data('text');
            if (!selected.has(id)) {
                selected.set(id, text);
                render();
            }
        });

        $('#selectedRadicals').on('click', '.remove-radical', function () {
            selected.delete($(this).data('id'));
            render();
        });

        function render() {
            const list = $('#selectedRadicals');
            const hidden = $('#SelectedRadicalIds');
            list.empty();

            const ids = [];
            selected.forEach((text, id) => {
                list.append(`
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        ${text}
                        <button type="button"
                                class="btn btn-sm btn-outline-danger remove-radical"
                                data-id="${id}">
                            <i class="fas fa-times"></i>
                        </button>
                    </li>`);
                ids.push(id);
            });
            hidden.val(ids.join(','));
        }
    </script>

    <partial name="_ValidationScriptsPartial" />
}
