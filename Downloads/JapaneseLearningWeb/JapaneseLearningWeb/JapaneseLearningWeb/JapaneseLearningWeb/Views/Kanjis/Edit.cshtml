@model JapaneseLearningWeb.Models.Kanji

@{
    ViewData["Title"] = "Chỉnh sửa Kanji";
}

<div class="card mx-auto mt-4" style="max-width: 600px; border-radius: 8px;">
    <div class="card-header bg-teal text-white fw-semibold d-flex align-items-center gap-2">
        <i class="bi bi-pencil-square"></i>
        <span>Chỉnh sửa Kanji</span>
    </div>
    <div class="card-body p-4">
        <form asp-action="Edit" method="post" novalidate>
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Character" class="form-label fw-semibold text-teal">Ký tự Kanji</label>
                <input asp-for="Character" class="form-control border-teal" placeholder="Nhập một ký tự Kanji" />
                <span asp-validation-for="Character" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="OnYomi" class="form-label fw-semibold text-teal">Âm On</label>
                <input asp-for="OnYomi" class="form-control border-teal" placeholder="Nhập âm On (nếu có)" />
                <span asp-validation-for="OnYomi" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="KunYomi" class="form-label fw-semibold text-teal">Âm Kun</label>
                <input asp-for="KunYomi" class="form-control border-teal" placeholder="Nhập âm Kun (nếu có)" />
                <span asp-validation-for="KunYomi" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Meaning" class="form-label fw-semibold text-teal">Nghĩa Kanji</label>
                <input asp-for="Meaning" class="form-control border-teal" placeholder="Nhập nghĩa của Kanji" />
                <span asp-validation-for="Meaning" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="LessonId" class="form-label fw-semibold text-teal">Bài học</label>
                <select asp-for="LessonId" asp-items="ViewBag.Lessons" class="form-select border-teal">
                    <option value="">Chọn bài học</option>
                </select>
                <span asp-validation-for="LessonId" class="text-danger"></span>
            </div>

            <!-- Phần chọn Radical -->
            <div class="mb-4">
                <label class="form-label fw-semibold text-teal">Chọn bộ (Radical)</label>
                <div class="d-flex flex-wrap gap-3">
                    @foreach (var r in (List<SelectListItem>)ViewBag.Radicals)
                    {
                        <div class="form-check">
                            <input class="form-check-input"
                                   type="checkbox"
                                   name="SelectedRadicalIds"
                                   value="@r.Value"
                                   id="radical_@r.Value"
                            @(r.Selected ? "checked" : "") />
                            <label class="form-check-label text-teal" for="radical_@r.Value">@r.Text</label>
                        </div>
                    }
                </div>
            </div>

            <!-- Từ vựng liên quan -->
            <h5 class="mt-4 mb-3 text-teal">Từ vựng liên quan</h5>
            @if (Model.VocabularyKanjis != null && Model.VocabularyKanjis.Any())
            {
                <table class="table table-bordered table-striped align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Kanji</th>
                            <th>Hiragana</th>
                            <th>Romaji</th>
                            <th>Nghĩa</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var vk in Model.VocabularyKanjis)
                        {
                            var vocabulary = vk.Vocabulary;
                            <tr>
                                <td>@vocabulary.Kanji</td>
                                <td>@vocabulary.Hiragana</td>
                                <td>@vocabulary.Romaji</td>
                                <td>@vocabulary.Meaning</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted fst-italic">Không có từ vựng nào liên quan.</p>
            }

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-teal flex-grow-1">
                    <i class="bi bi-save me-1"></i> Lưu thay đổi
                </button>
                <a asp-action="Index" class="btn btn-secondary flex-grow-1 text-white">
                    Hủy
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>
    .form-control.border-teal {
        border-color: #17b6b7 !important;
    }

        .form-control.border-teal:focus {
            box-shadow: 0 0 0 0.2rem rgba(23, 182, 183, 0.25);
            border-color: #17b6b7 !important;
        }

    label.text-teal {
        color: #17b6b7 !important;
    }

    .btn-teal {
        background-color: #17b6b7;
        border-color: #17b6b7;
    }

        .btn-teal:hover, .btn-teal:focus {
            background-color: #0ba0a1;
            border-color: #0ba0a1;
        }

    .card-header {
        border-radius: 18px 18px 0 0;
        background-color: #17b6b7;
    }

    .btn-outline-info,
    .btn-outline-warning,
    .btn-outline-danger,
    .btn-outline-secondary {
        transition: background-color 0.2s, color 0.2s;
    }

        .btn-outline-info:hover {
            background-color: #0dcaf0;
            color: white;
        }

        .btn-outline-warning:hover {
            background-color: #ffc107;
            color: white;
        }

        .btn-outline-danger:hover {
            background-color: #dc3545;
            color: white;
        }

        .btn-outline-secondary:hover {
            background-color: #6c757d;
            color: white;
        }
</style>
