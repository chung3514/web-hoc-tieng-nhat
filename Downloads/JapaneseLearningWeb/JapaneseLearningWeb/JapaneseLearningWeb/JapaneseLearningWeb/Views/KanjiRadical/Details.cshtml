@model JapaneseLearningWeb.Models.KanjiRadical

@{
    ViewData["Title"] = "Chi tiết Bộ thủ";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <main class="col-md-10">
            <div class="card shadow-sm border-0">
                <div class="card-header" style="background-color: #17b6b7; color: white; text-align: center; border-radius: 18px 18px 0 0;">
                    <h3 class="card-title mb-0"><i class="fas fa-language me-2"></i>Bộ thủ: @Model.RadicalKanji</h3>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="d-flex align-items-center mb-3">
                                <i class="fas fa-pen-nib me-3" style="color: #17b6b7;" class="fa-2x"></i>
                                <div>
                                    <h6 class="text-muted mb-1">Bộ thủ</h6>
                                    <h4 style="color: #17b6b7;">@Model.RadicalKanji</h4>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex align-items-center mb-3">
                                <i class="fas fa-book-open me-3" style="color: #17b6b7;" class="fa-2x"></i>
                                <div>
                                    <h6 class="text-muted mb-1">Ý nghĩa (Hanja)</h6>
                                    <p>@(string.IsNullOrEmpty(Model.RadicalHanjaMeaning) ? "Không có" : Model.RadicalHanjaMeaning)</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Related Kanji -->
                    <h4 class="mt-5 mb-3"><i class="fas fa-list-ul me-2" style="color: #17b6b7;"></i>Các chữ Kanji chứa bộ này</h4>
                    @if (Model.KanjiKanjiRadicals != null && Model.KanjiKanjiRadicals.Any())
                    {
                        <div class="row g-4">
                            @foreach (var item in Model.KanjiKanjiRadicals)
                            {
                                <div class="col-md-6 col-lg-4">
                                    <div class="card h-100 shadow-sm border-0">
                                        <div class="card-body">
                                            <h5 class="card-title text-center" style="color: #17b6b7;">@item.Kanji.Character</h5>
                                            <div class="mb-3">
                                                <i class="fas fa-book-open me-2" style="color: #17b6b7;"></i>
                                                <strong>Nghĩa:</strong> @(string.IsNullOrEmpty(item.Kanji.Meaning) ? "Không có" : item.Kanji.Meaning)
                                            </div>
                                            <div class="text-center">
                                                <a asp-controller="Kanjis" asp-action="Details" asp-route-id="@item.Kanji.Id" class="btn btn-outline-info btn-sm">
                                                    <i class="fas fa-info-circle me-1"></i>Chi tiết
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-exclamation-circle fa-3x" style="color: #17b6b7;"></i>
                            <p class="text-muted">Không có chữ Kanji nào thuộc bộ này.</p>
                        </div>
                    }
                </div>
                <div class="card-footer bg-light text-center">
                    @if (User.IsInRole("Admin") || User.IsInRole("Employee"))
                    {
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-warning btn-sm me-2">
                            <i class="fas fa-edit me-1"></i>Sửa
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger btn-sm me-2">
                            <i class="fas fa-trash-alt me-1"></i>Xóa
                        </a>
                    }
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="fas fa-arrow-left me-1"></i>Quay lại
                    </a>
                </div>
            </div>
        </main>
    </div>
</div>

<style>
    .card {
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 24px rgba(23, 182, 183, 0.15) !important;
        }

    .card-header {
        border-radius: 18px 18px 0 0;
    }

    .btn-outline-info, .btn-outline-warning, .btn-outline-danger, .btn-outline-secondary {
        transition: background-color 0.2s, color 0.2s;
    }

        .btn-outline-info:hover {
            background-color: #17b6b7; /* Thay đổi sang teal */
            color: white;
            border-color: #17b6b7;
        }

        .btn-outline-warning:hover {
            background-color: #17b6b7; /* Thay đổi sang teal */
            color: white;
            border-color: #17b6b7;
        }

        .btn-outline-danger:hover {
            background-color: #17b6b7; /* Thay đổi sang teal */
            color: white;
            border-color: #17b6b7;
        }

        .btn-outline-secondary:hover {
            background-color: #17b6b7; /* Thay đổi sang teal */
            color: white;
            border-color: #17b6b7;
        }

    @@media (max-width: 768px) {
        .card-title

    {
        font-size: 1.8rem;
    }

    .btn-sm {
        font-size: 0.8rem;
        padding: 0.4rem 0.8rem;
    }

    .fa-2x {
        font-size: 1.5rem;
    }

    }
</style>

@section Scripts {
    <!-- Đảm bảo Font Awesome được tải nếu chưa có -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
}