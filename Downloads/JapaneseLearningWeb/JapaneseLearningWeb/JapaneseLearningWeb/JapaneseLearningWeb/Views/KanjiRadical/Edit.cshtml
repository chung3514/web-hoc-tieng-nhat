@model JapaneseLearningWeb.Models.KanjiRadical

@{
    ViewData["Title"] = "Sửa Bộ thủ";
}

<style>
    :root {
        --teal: #17b6b7;
        --teal-hover: #0ba0a1;
        --teal-bg: #e3f7fb;
    }

    .radical-edit-container {
        max-width: 700px;
    }

    .card {
        border: none;
        border-radius: 16px;
        box-shadow: 0 4px 18px rgba(0,0,0,0.06);
    }

    .card-header {
        background: var(--teal);
        color: #fff;
        border-radius: 16px 16px 0 0;
        padding: 16px 22px;
        font-weight: 700;
        font-size: 1.2rem;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .card-body {
        padding: 28px;
        background: #fff;
    }

    .form-label {
        font-weight: 600;
        color: var(--teal);
    }

    .form-control {
        border-radius: 10px;
        padding: 10px 14px;
        font-size: 1.05rem;
        border: 1.5px solid var(--teal);
    }

        .form-control:focus {
            border-color: var(--teal-hover);
            box-shadow: 0 0 0 0.15rem rgba(23,182,183,.25);
        }

    .btn-primary {
        background: var(--teal);
        border: none;
        border-radius: 30px;
        padding: 8px 30px;
        font-weight: 600;
    }

        .btn-primary:hover {
            background: var(--teal-hover);
        }

    .btn-secondary {
        border-radius: 30px;
        padding: 8px 30px;
        font-weight: 600;
    }

    .text-danger {
        font-size: 0.9rem;
        font-weight: 500;
    }

    @@media (max-width: 576px) {
        .card-body {
            padding: 20px;
        }
    }
</style>

<div class="container radical-edit-container my-4">
    <div class="card">

        <!-- HEADER -->
        <div class="card-header">
            <i class="fas fa-puzzle-piece"></i>
            Sửa Bộ thủ
        </div>

        <!-- BODY -->
        <div class="card-body">
            <form asp-action="Edit" method="post" novalidate>
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="RadicalKanji" class="form-label">Ký tự bộ</label>
                    <input asp-for="RadicalKanji"
                           class="form-control"
                           placeholder="Ví dụ: 子, 氵, 心" />
                    <span asp-validation-for="RadicalKanji" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="RadicalHanjaMeaning" class="form-label">Nghĩa Hán-Việt</label>
                    <input asp-for="RadicalHanjaMeaning"
                           class="form-control"
                           placeholder="Ví dụ: con, nước, tâm" />
                    <span asp-validation-for="RadicalHanjaMeaning" class="text-danger"></span>
                </div>

                <!-- ACTIONS -->
                <div class="d-flex justify-content-center gap-3 mt-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i>Cập nhật
                    </button>

                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i>Hủy
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
