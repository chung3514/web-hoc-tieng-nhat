@model JapaneseLearningWeb.Models.PagedListViewModel<JapaneseLearningWeb.Models.KanjiRadical>

@{
    ViewData["Title"] = "Danh sách Bộ thủ";
    int currentPage = Model.PageNumber;
    int pageSize = Model.PageSize;
    int totalPages = (int)Math.Ceiling((double)Model.TotalItems / pageSize);
}

<style>
    /* ===== CHUẨN GIỐNG GRAMMAR ===== */

    .radical-container {
        max-width: 1100px;
    }

    :root {
        --teal: #17b6b7;
        --teal-hover: #0ba0a1;
        --teal-bg: #e3f7fb;
    }

    .card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 4px 18px rgba(0,0,0,0.06);
    }

    .card-header {
        background-color: var(--teal);
        color: #fff;
        border-radius: 12px 12px 0 0;
    }

    .card-body {
        background: #f7fcfd;
    }

    .search-bar-radical {
        background: #eafafc;
        border-radius: 8px;
    }

    .radical-item-card {
        background: #fcfdff;
        border-radius: 12px;
        min-height: 220px;
    }

    .btn-outline-info,
    .btn-outline-warning,
    .btn-outline-danger {
        min-width: 80px;
        font-weight: 600;
    }

    .btn-outline-info {
        border-color: var(--teal);
        color: var(--teal);
    }

        .btn-outline-info:hover {
            background: var(--teal);
            color: #fff;
        }

    .btn-outline-warning:hover {
        background: #e0a800;
        color: #fff;
    }

    .btn-outline-danger:hover {
        background: #dc3545;
        color: #fff;
    }

    .pagination .page-link {
        border-radius: 8px;
        margin: 0 4px;
    }

    .pagination .active .page-link {
        background: var(--teal);
        border-color: var(--teal);
        color: #fff;
    }

    @@media (max-width: 768px) {
        .radical-item-card {
            min-height: 180px;
        }
    }
</style>

<div class="container radical-container my-4">
    <div class="card">

        <!-- HEADER -->
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                <i class="fas fa-book-open me-2"></i>@ViewData["Title"]
            </h5>

            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Create" class="btn btn-light btn-sm">
                    <i class="fas fa-plus-circle me-1"></i> Tạo Bộ thủ
                </a>
            }
        </div>

        <!-- BODY -->
        <div class="card-body">

            <!-- SEARCH -->
            <form asp-action="Index" method="get" class="mb-4">
                <div class="input-group search-bar-radical">
                    <span class="input-group-text bg-white border-0">
                        <i class="fas fa-search text-info"></i>
                    </span>
                    <input type="text"
                           name="keyword"
                           value="@Model.Keyword"
                           class="form-control border-0"
                           placeholder="Tìm bộ thủ hoặc ý nghĩa..." />
                    <div class="col-md-2 d-grid">
                        <button type="submit" class="btn btn-info text-white">
                            Tìm kiếm
                        </button>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Keyword))
                    {
                        <a asp-action="Index" class="btn btn-outline-info ms-2">
                            Xóa bộ lọc
                        </a>
                    }
                </div>
            </form>

            <!-- RADICAL GRID -->
            <div class="row g-4">
                @if (Model.Items.Any())
                {
                    @foreach (var item in Model.Items)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card radical-item-card h-100 shadow-sm">
                                <div class="card-body text-center">
                                    <h3 class="text-danger fw-bold mb-3" style="font-size:2.5rem">
                                        @item.RadicalKanji
                                    </h3>

                                    <div class="mb-3">
                                        <strong>Ý nghĩa:</strong>
                                        @(string.IsNullOrEmpty(item.RadicalHanjaMeaning)
                                            ? "Không có"
                                            : item.RadicalHanjaMeaning)
                                    </div>

                                    <div class="d-flex justify-content-center gap-2">
                                        <a asp-action="Details" asp-route-id="@item.Id"
                                           class="btn btn-outline-info btn-sm">
                                            Chi tiết
                                        </a>

                                        @if (User.IsInRole("Admin") || User.IsInRole("Employee"))
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.Id"
                                               class="btn btn-outline-warning btn-sm">
                                                Sửa
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id"
                                               class="btn btn-outline-danger btn-sm">
                                                Xóa
                                            </a>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-center py-5 text-muted">
                        Không tìm thấy bộ thủ nào.
                    </div>
                }
            </div>

            <!-- PAGINATION -->
            @if (totalPages > 1)
            {
                <nav class="mt-4">
                    <ul class="pagination justify-content-center">
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link"
                                   asp-route-pageNumber="@i"
                                   asp-route-pageSize="@pageSize"
                                   asp-route-keyword="@Model.Keyword">
                                    @i
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            }

            <!-- TOTAL -->
            <div class="text-center mt-3 text-secondary">
                Tổng cộng: @Model.TotalItems bộ thủ
            </div>

        </div>
    </div>
</div>
