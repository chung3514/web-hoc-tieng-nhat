@model JapaneseLearningWeb.Models.KanjiRadical
@{
    ViewData["Title"] = "Thêm Bộ thủ";
}

@section Styles {
    <style>
        :root {
            --teal: #17b6b7;
            --teal-hover: #0ba0a1;
        }

        .radical-create-page {
            font-family: 'Montserrat', sans-serif;
            font-size: 14.5px;
            font-weight: 400;
            color: #334155;
        }

        .radical-container {
            max-width: 600px;
            margin: 32px auto;
        }

        /* CARD */
        .card {
            border: none;
            border-radius: 16px;
            box-shadow: 0 6px 24px rgba(23,182,183,0.12);
            background: #fff;
            transition: transform .2s ease, box-shadow .2s ease;
        }

            .card:hover {
                transform: translateY(-3px);
                box-shadow: 0 10px 30px rgba(23,182,183,0.18);
            }

        .card-header {
            background: var(--teal);
            color: #fff;
            border-radius: 16px 16px 0 0;
            padding: 16px 22px;
            font-size: 18px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .card-body {
            padding: 26px;
            background: #f8fefe;
        }

        /* FORM */
        .form-label {
            font-weight: 600;
            color: var(--teal);
            margin-bottom: 6px;
        }

        .form-control {
            border-radius: 10px;
            padding: 10px 14px;
            font-size: 14.5px;
            border: 1.5px solid var(--teal);
            background: #f8fefe;
            color: #334155;
        }

            .form-control:focus {
                border-color: var(--teal-hover);
                box-shadow: 0 0 0 0.15rem rgba(23,182,183,.25);
                background: #fff;
            }

        .text-danger {
            font-size: 0.9rem;
            font-weight: 500;
        }

        /* BUTTONS */
        .btn-primary {
            background: var(--teal);
            border: none;
            border-radius: 30px;
            padding: 10px 28px;
            font-weight: 600;
            font-size: 14.5px;
            box-shadow: 0 4px 12px rgba(23,182,183,0.35);
        }

            .btn-primary:hover {
                background: var(--teal-hover);
            }

        .btn-outline-primary {
            border-radius: 30px;
            padding: 10px 28px;
            font-weight: 600;
            font-size: 14.5px;
            border: 2px solid var(--teal);
            color: var(--teal);
            background: #fff;
        }

            .btn-outline-primary:hover {
                background: var(--teal);
                color: #fff;
            }

        @@media (max-width: 576px) {
            .card-body

        {
            padding: 20px;
        }

        }
    </style>
}

<div class="radical-create-page">
    <div class="radical-container">
        <div class="card">

            <!-- HEADER -->
            <div class="card-header">
                <i class="fas fa-puzzle-piece"></i>
                Thêm Bộ thủ
            </div>

            <!-- BODY -->
            <div class="card-body">
                <form asp-action="Create" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="RadicalKanji" class="form-label">Ký tự bộ</label>
                        <input asp-for="RadicalKanji"
                               class="form-control"
                               placeholder="Ví dụ: 子" />
                        <span asp-validation-for="RadicalKanji" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="RadicalHanjaMeaning" class="form-label">Nghĩa Hán–Việt</label>
                        <input asp-for="RadicalHanjaMeaning"
                               class="form-control"
                               placeholder="Ví dụ: Tử" />
                        <span asp-validation-for="RadicalHanjaMeaning" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-center gap-3">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-1"></i> Lưu
                        </button>

                        <a asp-action="Index" class="btn btn-outline-primary">
                            <i class="fas fa-arrow-left me-1"></i> Hủy
                        </a>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
