@model JapaneseLearningWeb.Models.KanjiTestViewModel
@{
    ViewData["Title"] = "Ghép Bộ Thành Kanji";
}

<h2 class="mb-3">🧩 Kéo các Bộ để tạo thành 1 Kanji</h2>

<form asp-action="SubmitTest" method="post">
    <input type="hidden" asp-for="LessonId" />

    <div class="row">
        <!-- Bộ thủ có thể kéo -->
        <div class="col-md-6">
            <h4>Bộ Thủ Có Thể Chọn:</h4>
            <ul id="available-radicals" class="list-group" style="min-height: 300px; background: #fff0f0; padding: 10px;">
                @foreach (var radical in Model.AllRadicals)
                {
                    <li class="list-group-item" data-id="@radical.Id" style="cursor: grab;">
                        <strong>@radical.RadicalKanji</strong> - @radical.RadicalHanjaMeaning
                    </li>
                }
            </ul>
        </div>

        <!-- Khu vực thả -->
        <div class="col-md-6">
            <h4>Kéo Bộ Vào Đây:</h4>
            <ul id="selected-radicals" class="list-group border border-primary" style="min-height: 300px; background: #f9f9f9; padding: 10px;">
                <li class="list-group-item text-muted" id="placeholder">Kéo bộ thủ vào đây</li>
            </ul>
        </div>
    </div>

    <!-- Danh sách hidden input để post dữ liệu -->
    <div id="hidden-radicals"></div>

    <button type="submit" class="btn btn-success mt-3">✅ Kiểm tra</button>
</form>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
    <script>
        const available = document.getElementById("available-radicals");
        const selected = document.getElementById("selected-radicals");
        const hiddenInputs = document.getElementById("hidden-radicals");
        const placeholder = document.getElementById("placeholder");

        // Sortable cho danh sách bộ thủ có thể kéo (clone)
        new Sortable(available, {
            group: {
                name: 'radicals',
                pull: 'clone',
                put: false
            },
            sort: false,
            animation: 150
        });

        // Sortable cho khu vực thả
        new Sortable(selected, {
            group: 'radicals',
            animation: 150,
            onSort: () => {
                updateHiddenInputs();
                togglePlaceholder();
            },
            onAdd: () => {
                updateHiddenInputs();
                togglePlaceholder();
            },
            onRemove: () => {
                updateHiddenInputs();
                togglePlaceholder();
            }
        });

        function updateHiddenInputs() {
            hiddenInputs.innerHTML = '';
            const items = selected.querySelectorAll("li:not(#placeholder)");
            items.forEach(item => {
                const id = item.getAttribute("data-id");
                hiddenInputs.innerHTML += `<input type="hidden" name="SelectedRadicalIds" value="${id}" />`;
            });
        }

        function togglePlaceholder() {
            const items = selected.querySelectorAll("li:not(#placeholder)");
            if (items.length === 0) {
                placeholder.style.display = 'block';
            } else {
                placeholder.style.display = 'none';
            }
        }

        // Khởi tạo
        togglePlaceholder();
        updateHiddenInputs();
    </script>
}
