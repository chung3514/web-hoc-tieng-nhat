@model JapaneseLearningWeb.Models.KanjiCompositionViewModel
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Tạo Kanji từ Bộ";
    var lessonSelectList = new SelectList(Model.Lessons, "LessonId", "Title");
}

<div class="card shadow-sm mb-4">
    <div class="card-header d-flex justify-content-between align-items-center bg-teal text-white">
        <h5 class="mb-0">
            <i class="fas fa-pen-nib me-2"></i>@ViewData["Title"]
        </h5>
    </div>
    <div class="card-body">
        <form asp-action="Generate" method="post" aria-label="Form tạo Kanji từ các bộ">
            <div class="mb-3">
                <label for="SelectedLessonId" class="form-label">Chọn bài học</label>
                <select asp-for="SelectedLessonId" asp-items="lessonSelectList" class="form-select" aria-required="true">
                    <option value="">-- Chọn bài học --</option>
                </select>
                <span asp-validation-for="SelectedLessonId" class="text-danger"></span>
            </div>

            @if (Model.AvailableRadicals != null && Model.AvailableRadicals.Any())
            {
                <fieldset class="mb-3">
                    <legend class="form-label">Chọn các bộ:</legend>
                    @foreach (var radical in Model.AvailableRadicals)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="SelectedRadicalIds" value="@radical.Id" id="radical_@radical.Id" />
                            <label class="form-check-label" for="radical_@radical.Id">@radical.RadicalKanji - @radical.RadicalHanjaMeaning</label>
                        </div>
                    }
                </fieldset>
            }

            <button type="submit" class="btn btn-teal">Tạo Kanji</button>
        </form>
    </div>
</div>

@if (Model.UsedRadicals?.Any() == true)
{
    <div class="card mb-3">
        <div class="card-header bg-teal text-white">
            <h6 class="mb-0"><i class="fas fa-th-large me-2"></i>Các Bộ Được Chọn</h6>
        </div>
        <div class="card-body py-2">
            <ul class="mb-0">
                @foreach (var radical in Model.UsedRadicals)
                {
                    <li>@radical.RadicalKanji - @radical.RadicalHanjaMeaning</li>
                }
            </ul>
        </div>
    </div>
}

@if (Model.GeneratedKanjis?.Any() == true)
{
    <div class="card mb-3">
        <div class="card-header bg-teal text-white">
            <h6 class="mb-0"><i class="fas fa-check-circle me-2"></i>Kanji Kết Quả</h6>
        </div>
        <div class="card-body py-2">
            <ul class="mb-0">
                @foreach (var kanji in Model.GeneratedKanjis)
                {
                    <li><strong>@kanji.Character</strong> - @kanji.Meaning</li>
                }
            </ul>
        </div>
    </div>
}
else if (Model.SelectedRadicalIds?.Any() == true)
{
    <div class="alert alert-warning mt-3 mb-0">
        <span>❌ Không tìm thấy Kanji nào khớp.</span>
    </div>
}

