@model JapaneseLearningWeb.Models.KanjiTestViewModel

<h2>Kết quả kiểm tra</h2>

@if (Model.MatchedKanji != null)
{
    <div class="alert alert-success">
        ✅ Bạn đã ghép đúng Kanji: <strong>@Model.MatchedKanji.Character</strong> - @Model.MatchedKanji.Meaning
    </div>
}
else
{
    <div class="alert alert-danger">
        ❌ Không khớp với Kanji nào trong bài học.
    </div>
}

<a asp-action="StartTest" asp-route-lessonId="@Model.LessonId" class="btn btn-secondary">
    🔁 Thử lại
</a>
