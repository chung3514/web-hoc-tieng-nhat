@using Newtonsoft.Json

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const flashcard = document.getElementById('flashcard');
            const kanjiText = document.getElementById('kanji-text');
            const radicalsForm = document.getElementById('radicals-form');
            const prevBtn = document.getElementById('prev-btn');
            const nextBtn = document.getElementById('next-btn');
            const cardCounter = document.getElementById('card-counter');

            const lessonKanjis = @Html.Raw(JsonConvert.SerializeObject(Model.LessonKanjis));
            const availableRadicals = @Html.Raw(JsonConvert.SerializeObject(Model.AvailableRadicals));

            // Khởi tạo biến để lưu đáp án người dùng
            let selectedAnswers = {};

            // Nếu có dữ liệu từ trước (trong trường hợp hiển thị lại), khởi tạo
          const initialUserAnswers = @Html.Raw(JsonConvert.SerializeObject(Model.UserAnswers ?? new Dictionary<int, List<int>>()));

            selectedAnswers = JSON.parse(JSON.stringify(initialUserAnswers));

            let currentIndex = 0;

            function renderCard(index) {
                if (index < 0 || index >= lessonKanjis.length) return;

                flashcard.classList.remove('flipped');

                const kanji = lessonKanjis[index];
                kanjiText.textContent = kanji.Character || 'Không có chữ Kanji';

                radicalsForm.innerHTML = '';

                availableRadicals.forEach(radical => {
                    if (!radical) return;

                    const div = document.createElement('div');
                    div.className = 'radical-item';

                    const checkbox = document.createElement('input');
                    checkbox.type = 'checkbox';
                    checkbox.id = `radical_${kanji.Id}_${radical.Id}`;
                    checkbox.name = `UserAnswers[${kanji.Id}]`;
                    checkbox.value = radical.Id;

                    // Check nếu user đã chọn bộ này trước đó
                    if (selectedAnswers[kanji.Id] && selectedAnswers[kanji.Id].includes(radical.Id)) {
                        checkbox.checked = true;
                    }

                    checkbox.addEventListener('click', function (event) {
                        event.stopPropagation(); // tránh lật card khi bấm

                        if (!selectedAnswers[kanji.Id]) {
                            selectedAnswers[kanji.Id] = [];
                        }

                        if (checkbox.checked) {
                            if (!selectedAnswers[kanji.Id].includes(radical.Id)) {
                                selectedAnswers[kanji.Id].push(radical.Id);
                            }
                        } else {
                            selectedAnswers[kanji.Id] = selectedAnswers[kanji.Id].filter(id => id !== radical.Id);
                        }
                    });

                    const label = document.createElement('label');
                    label.htmlFor = checkbox.id;
                    label.textContent = `${radical.RadicalKanji} - ${radical.RadicalHanjaMeaning}`;

                    div.appendChild(checkbox);
                    div.appendChild(label);
                    radicalsForm.appendChild(div);
                });

                cardCounter.textContent = (index + 1) + ' / ' + lessonKanjis.length;
                prevBtn.disabled = index === 0;
                nextBtn.disabled = index === lessonKanjis.length - 1;
            }

            flashcard.addEventListener('click', () => {
                flashcard.classList.toggle('flipped');
            });

            prevBtn.addEventListener('click', () => {
                if (currentIndex > 0) {
                    currentIndex--;
                    renderCard(currentIndex);
                }
            });

            nextBtn.addEventListener('click', () => {
                if (currentIndex < lessonKanjis.length - 1) {
                    currentIndex++;
                    renderCard(currentIndex);
                }
            });

            // Trước khi submit: tạo input ẩn cho các lựa chọn đã lưu
            const form = document.getElementById("flashcard-form");
            form.addEventListener("submit", function () {
                // Xóa các input cũ (nếu có)
                const oldInputs = document.querySelectorAll("input[name^='UserAnswers']");
                oldInputs.forEach(input => input.remove());

                // Tạo input mới từ selectedAnswers
                for (let kanjiId in selectedAnswers) {
                    selectedAnswers[kanjiId].forEach(radicalId => {
                        const input = document.createElement("input");
                        input.type = "hidden";
                        input.name = `UserAnswers[${kanjiId}]`;
                        input.value = radicalId;
                        form.appendChild(input);
                    });
                }
            });

            renderCard(currentIndex);
        });
    </script>
}