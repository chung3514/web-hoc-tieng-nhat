@{
    ViewData["Title"] = "Kiểm tra userId trong LocalStorage";
}

<div class="container mt-5">
    <div class="card shadow p-4 text-center">
        <h3 class="mb-3 text-primary">Kiểm tra userId trong LocalStorage</h3>
        php-template
        Sao chép
        Chỉnh sửa
        <p class="lead">Kết quả kiểm tra:</p>
        <div id="result" class="fs-5 fw-bold text-success">Đang kiểm tra...</div>

        <div class="mt-4">
            <button class="btn btn-secondary" onclick="clearUserId()">Xóa userId khỏi localStorage</button>
        </div>
    </div>
</div>
<script> document.addEventListener("DOMContentLoaded", function () { const userId = localStorage.getItem("userId"); const result = document.getElementById("result"); if (userId) { result.textContent = `userId: ${userId}`; result.classList.remove("text-danger"); result.classList.add("text-success"); } else { result.textContent = "Không tìm thấy userId trong localStorage."; result.classList.remove("text-success"); result.classList.add("text-danger"); } }); function clearUserId() { localStorage.removeItem("userId"); alert("Đã xóa userId khỏi localStorage."); location.reload(); } </script>