@{
    ViewData["Title"] = "Kết quả bài kiểm tra";
}

<div class="container mt-5" style="max-width: 600px;">
    <h2 class="mb-4 text-danger">Kết quả bài kiểm tra</h2>

    <div class="alert alert-success fs-5">
        <p><strong>Điểm của bạn:</strong> @ViewBag.Score / 3</p>
        <p><strong>Gợi ý từ AI:</strong> @ViewBag.AISuggestion</p>
    </div>

    <div class="d-flex gap-3">
        <a href="/Home/Quiz" class="btn btn-danger flex-fill" role="button" aria-label="Làm bài kiểm tra khác">
            <i class="fas fa-redo me-2"></i> Làm bài kiểm tra khác
        </a>
        <a href="/Home/Progress" class="btn btn-outline-secondary flex-fill" role="button" aria-label="Xem tiến độ học tập">
            <i class="fas fa-chart-line me-2"></i> Xem tiến độ
        </a>
    </div>
</div>
