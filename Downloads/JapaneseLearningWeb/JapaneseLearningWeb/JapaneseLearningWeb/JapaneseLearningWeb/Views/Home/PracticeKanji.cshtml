<input type="text" id="kanjiInput" placeholder="Nhập chữ Kanji" maxlength="1" style="width: 150px; padding: 5px;" />
<button onclick="loadKanji()">Hiển thị nét</button>

<svg id="kanjiSvg" width="200" height="200" style="border: 1px solid #ccc; margin-top: 10px;"></svg>

<script>
    async function loadKanji() {
        const character = document.getElementById('kanjiInput').value.trim();
        const svg = document.getElementById('kanjiSvg');
        svg.innerHTML = ""; // reset SVG mỗi lần gọi

        if (!character) {
            alert("Vui lòng nhập một chữ Kanji.");
            return;
        }

        try {
            const res = await fetch(`/KanjiStroke/GetStrokeData?character=${encodeURIComponent(character)}`);
            const json = await res.json();

            if (!json.success) {
                alert(json.message || "Không tìm thấy dữ liệu nét viết.");
                return;
            }

            let delay = 0;
            json.data.strokes.forEach((stroke, index) => {
                setTimeout(() => {
                    const path = document.createElementNS("http://www.w3.org/2000/svg", "path");
                    path.setAttribute("d", stroke.d);
                    path.setAttribute("stroke", stroke.color || "#000");
                    path.setAttribute("fill", "none");
                    path.setAttribute("stroke-width", "2");
                    path.setAttribute("stroke-linecap", "round");
                    path.setAttribute("stroke-linejoin", "round");

                    // Hiệu ứng vẽ nét
                    const length = path.getTotalLength();
                    path.style.strokeDasharray = length;
                    path.style.strokeDashoffset = length;
                    path.style.transition = "stroke-dashoffset 0.6s ease";
                    svg.appendChild(path);

                    requestAnimationFrame(() => {
                        path.style.strokeDashoffset = '0';
                    });

                    // Số thứ tự nét viết
                    const start = getStartPoint(stroke.d);
                    const text = document.createElementNS("http://www.w3.org/2000/svg", "text");
                    text.setAttribute("x", start.x);
                    text.setAttribute("y", start.y);
                    text.setAttribute("fill", "red");
                    text.setAttribute("font-size", "8");
                    text.setAttribute("font-family", "Arial, sans-serif");
                    text.textContent = (index + 1).toString();
                    svg.appendChild(text);
                }, delay);
                delay += 700;
            });
        } catch (error) {
            alert("Lỗi khi tải dữ liệu nét viết: " + error.message);
        }
    }

    // Lấy điểm bắt đầu nét từ lệnh "M" trong path d
    function getStartPoint(d) {
        const match = d.match(/M\s*([\d.]+)[,\s]+([\d.]+)/i);
        if (match) {
            return { x: parseFloat(match[1]), y: parseFloat(match[2]) };
        }
        return { x: 5, y: 5 };
    }
</script>
