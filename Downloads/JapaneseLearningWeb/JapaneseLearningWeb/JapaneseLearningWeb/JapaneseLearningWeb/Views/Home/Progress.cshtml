@model List<JapaneseLearningWeb.Models.QuizResult>

@{
    ViewData["Title"] = "Tiến độ học tập";
}

<div class="container mt-5" style="max-width: 700px;">
    <h2 class="mb-4 text-danger">Tiến độ học tập</h2>

    @if (Model.Any())
    {
        <table class="table table-striped table-hover shadow-sm rounded">
            <thead class="table-danger text-white">
                <tr>
                    <th>Ngày làm bài</th>
                    <th>Điểm số</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var result in Model)
                {
                    <tr>
                        <td>@result.DateTaken.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@result.Score / 3</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info">
            Bạn chưa làm bài kiểm tra nào!
        </div>
    }

    <a href="/Home/Quiz" class="btn btn-danger btn-lg mt-3" role="button" aria-label="Làm bài kiểm tra">
        <i class="fas fa-pencil-alt me-2"></i> Làm bài kiểm tra
    </a>
</div>
