@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="container mt-5" style="max-width: 400px;">
    <div class="card shadow-sm rounded-4 border-0">
        <div class="card-header bg-teal text-white text-center py-3 rounded-top-4">
            <h3 class="mb-0">Đăng nhập</h3>
        </div>
        <div class="card-body p-4">
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger" role="alert">@ViewBag.Error</div>
            }
            @if (ViewBag.Message != null)
            {
                <div class="alert alert-success" role="alert">@ViewBag.Message</div>
            }

            <!-- Form Đăng nhập -->
            <form method="post" action="/Home/Login" aria-label="Form đăng nhập" novalidate>
                <div class="mb-3">
                    <label for="email" class="form-label fw-semibold text-teal">Email</label>
                    <input type="email" class="form-control border-teal" id="email" name="email" required aria-required="true" placeholder="Nhập email của bạn" />
                    <div class="invalid-feedback">
                        Vui lòng nhập email hợp lệ.
                    </div>
                </div>
                <div class="mb-3">
                    <label for="password" class="form-label fw-semibold text-teal">Mật khẩu</label>
                    <input type="password" class="form-control border-teal" id="password" name="password" required aria-required="true" placeholder="Nhập mật khẩu" />
                    <div class="invalid-feedback">
                        Vui lòng nhập mật khẩu.
                    </div>
                </div>

                <button type="submit" class="btn btn-teal w-100 fw-semibold py-2 fs-5 rounded-4">
                    Đăng nhập
                </button>

                <div class="d-flex justify-content-between mt-4">
                    <a href="/Home/Register" class="btn btn-outline-teal rounded-4 px-4">
                        Đăng ký
                    </a>
                    <a href="/Account/ForgotPassword" class="link-teal align-self-center">
                        Quên mật khẩu?
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    :root {
        --teal: #17b6b7;
        --teal-hover: #0ba0a1;
        --teal-bg: #e3f7fb;
    }

    .bg-teal {
        background: var(--teal) !important;
    }

    .text-teal {
        color: var(--teal) !important;
    }

    .border-teal {
        border: 1.5px solid var(--teal) !important;
        box-shadow: none !important;
    }

    .form-control:focus {
        border-color: var(--teal) !important;
        box-shadow: 0 0 6px rgba(23, 182, 183, 0.21) !important;
    }

    .btn-teal {
        background: var(--teal) !important;
        color: #fff !important;
        border: none;
        border-radius: 30px;
        font-weight: 600;
        transition: background 0.2s, color 0.2s;
    }

        .btn-teal:hover, .btn-teal:focus {
            background: var(--teal-hover) !important;
            color: #fff !important;
        }

    .btn-outline-teal {
        border: 1.5px solid var(--teal) !important;
        color: var(--teal) !important;
        background: transparent !important;
        font-weight: 600;
        border-radius: 30px;
        transition: background 0.2s, color 0.2s;
    }

        .btn-outline-teal:hover, .btn-outline-teal:focus {
            background: var(--teal) !important;
            color: #fff !important;
        }

    .link-teal {
        color: var(--teal) !important;
        font-weight: 500;
        transition: color 0.2s;
    }

        .link-teal:hover, .link-teal:focus {
            color: var(--teal-hover) !important;
            text-decoration: underline;
        }

    .card-header.bg-teal {
        border-radius: 16px 16px 0 0 !important;
    }
</style>

@section Scripts {
    <script>
        // Bootstrap validation
        (function () {
            'use strict'
            var forms = document.querySelectorAll('form[novalidate]')
            Array.prototype.slice.call(forms).forEach(function (form) {
                form.addEventListener('submit', function (event) {
                    if (!form.checkValidity()) {
                        event.preventDefault()
                        event.stopPropagation()
                    }
                    form.classList.add('was-validated')
                }, false)
            })
        })()
    </script>
}
