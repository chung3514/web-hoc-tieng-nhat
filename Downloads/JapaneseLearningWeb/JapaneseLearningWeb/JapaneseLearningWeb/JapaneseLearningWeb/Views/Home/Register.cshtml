@{
    ViewData["Title"] = "Đăng ký";
}

<div class="container mt-5" style="max-width: 400px;">
    <div class="card shadow-sm rounded-4 border-0">
        <div class="card-header bg-teal text-white text-center py-3 rounded-top-4">
            <h3 class="mb-0">Đăng ký</h3>
        </div>
        <div class="card-body p-4">
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger" role="alert">@ViewBag.Error</div>
            }

            <!-- Form đăng ký -->
            <form method="post" action="/Home/Register" aria-label="Form đăng ký tài khoản">
                <div class="mb-3">
                    <label for="username" class="form-label text-teal">Tên người dùng</label>
                    <input type="text" class="form-control border-teal" id="username" name="Username" required aria-required="true" />
                </div>
                <div class="mb-3">
                    <label for="email" class="form-label text-teal">Email</label>
                    <input type="email" class="form-control border-teal" id="email" name="Email" required aria-required="true" />
                </div>
                <div class="mb-3">
                    <label for="password" class="form-label text-teal">Mật khẩu</label>
                    <input type="password" class="form-control border-teal" id="password" name="Password" required aria-required="true" />
                </div>

                <button type="submit" class="btn btn-teal w-100">Đăng ký</button>
            </form>
        </div>
    </div>
</div>

<style>
    :root {
        --teal: #17b6b7;
        --teal-hover: #0ba0a1;
    }

    .text-teal {
        color: var(--teal) !important;
    }

    .border-teal {
        border: 1.5px solid var(--teal) !important;
    }

    .form-control:focus {
        border-color: var(--teal) !important;
        box-shadow: 0 0 6px rgba(23, 182, 183, 0.21) !important;
    }

    .btn-teal {
        background: var(--teal) !important;
        color: #fff !important;
        border: none;
        border-radius: 30px;
        font-weight: 600;
        transition: background 0.2s, color 0.2s;
    }

        .btn-teal:hover, .btn-teal:focus {
            background: var(--teal-hover) !important;
            color: #fff !important;
        }

    /* Card Header */
    .card-header {
        background: var(--teal) !important;
        color: #fff;
        font-weight: 600;
        font-size: 1.5rem;
    }
</style>
