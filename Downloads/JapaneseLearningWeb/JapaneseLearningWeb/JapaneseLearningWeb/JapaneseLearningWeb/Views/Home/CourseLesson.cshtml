@model IEnumerable<JapaneseLearningWeb.Models.Course>

@{
    ViewData["Title"] = "Danh sách khóa học";
}

<style>
    body {
        background: #f7fcfd !important;
    }

    .course-container {
        max-width: 1100px;
    }

    .course-card-wrapper {
        background: #fff;
        border-radius: 16px;
    }

    .course-header {
        background: #17b6b7;
        color: #fff;
        border-radius: 16px 16px 0 0;
        font-weight: 700;
        font-size: 1.15rem;
        padding: 16px 20px;
    }

    .course-item {
        background: #fcfdff;
        border-radius: 14px;
        box-shadow: 0 4px 14px rgba(23,182,183,0.08);
        transition: transform .25s ease, box-shadow .25s ease;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

        .course-item:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 30px rgba(23,182,183,0.18);
        }

    .course-title {
        font-size: 1.2rem;
        font-weight: 700;
        color: #17b6b7;
    }

    .course-desc {
        font-size: .95rem;
        color: #555;
        min-height: 60px;
    }

    .course-meta {
        font-size: .9rem;
        color: #666;
    }

    .badge-free {
        background: #28a745;
        font-weight: 600;
    }

    .btn-enter {
        background: #17b6b7;
        color: #fff;
        border-radius: 30px;
        font-weight: 600;
        padding: 8px 22px;
        border: none;
    }

        .btn-enter:hover {
            background: #0ba0a1;
            color: #fff;
        }

    @@media (max-width: 768px) {
        .course-title {
            font-size: 1.05rem;
        }

        .course-desc {
            min-height: auto;
        }
    }
</style>

<div class="container course-container my-5">
    <div class="card shadow-sm course-card-wrapper">

        <!-- HEADER -->
        <div class="course-header text-center">
            <i class="fas fa-graduation-cap me-2"></i>@ViewData["Title"]
        </div>

        <!-- BODY -->
        <div class="card-body">
            <div class="row g-4">

                @foreach (var course in Model)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="course-item p-3">

                            <div>
                                <div class="course-title mb-2">
                                    @course.Title
                                </div>

                                <div class="course-desc mb-2">
                                    @{
                                        var desc = course.Description ?? "";
                                        if (desc.Length > 100)
                                        {
                                            @desc.Substring(0, 100)

                                            <text>...</text>
                                        }
                                        else
                                        {
                                            @desc
                                        }
                                    }
                                </div>

                                <div class="course-meta mb-2">
                                    <strong>Danh mục:</strong>
                                    @(course.Category?.Name ?? "Chưa có")
                                </div>

                                <div class="course-meta mb-3">
                                    <strong>Giá:</strong>
                                    @if (course.IsFree)
                                    {
                                        <span class="badge badge-free ms-1">Miễn phí</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger fw-semibold ms-1">
                                            @String.Format("{0:N0} VND", course.Price)
                                        </span>
                                    }
                                </div>
                            </div>

                            <div class="mt-auto text-center">
                                <a href="@Url.Action("LessonDetail", "Home", new { courseId = course.CourseId })"
                                   class="btn btn-enter"
                                   aria-label="Vào học khóa học @course.Title">
                                    <i class="fas fa-play me-1"></i>Vào học
                                </a>
                            </div>
                        </div>
                    </div>
                }

            </div>
        </div>
    </div>
</div>
