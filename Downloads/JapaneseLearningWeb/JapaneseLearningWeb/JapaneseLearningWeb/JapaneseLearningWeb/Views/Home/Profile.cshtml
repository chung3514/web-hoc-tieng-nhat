@model UserProfileViewModel

@{
    ViewData["Title"] = "Hồ sơ cá nhân";
}

<h2 class="mb-4 text-danger">Hồ sơ cá nhân</h2>

<div class="card p-4 shadow-sm" style="max-width: 500px;">
    <p><strong>Tên đăng nhập:</strong> @Model.UserName</p>
    <p><strong>Email:</strong> @Model.Email</p>
    <p><strong>Vai trò:</strong> @string.Join(", ", Model.Roles)</p>
</div>

<style>
    .card {
        border-radius: 12px;
        background-color: #fff;
    }

    p {
        font-size: 1.1rem;
        margin-bottom: 0.8rem;
    }

    strong {
        color: #dc3545;
    }
</style>
