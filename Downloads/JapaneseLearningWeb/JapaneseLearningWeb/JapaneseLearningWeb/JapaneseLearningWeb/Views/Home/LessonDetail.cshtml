

@model List<JapaneseLearningWeb.Models.Lesson>

@{
    ViewData["Title"] = "Chi tiết Khóa Học";
    bool isStaff = User.IsInRole("Admin") || User.IsInRole("Employee");
}

@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Anti
<meta name="request-verification-token" content="@Anti.GetAndStoreTokens(Context).RequestToken" />

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    .row.g-0 {
        height: 100vh;
        display: flex;
    }

    .sidebar {
        height: 100%;
        overflow-y: auto;
        border-left: 1px solid #dee2e6;
        padding: 20px;
        background: #fff0f0;
    }

    .accordion-button {
        font-weight: 600;
        color: #dc3545;
    }

        .accordion-button:not(.collapsed) {
            background: #f8d7da;
            color: #721c24;
        }

    .list-group-item {
        font-size: 15px;
        padding: 10px 15px;
        cursor: pointer;
        user-select: none;
    }

        .list-group-item:hover {
            background: #f8f9fa;
        }

    .main-content {
        height: 100%;
        overflow-y: auto;
        padding: 20px;
        background: #fff;
        border-radius: 0 8px 8px 0;
        box-shadow: 2px 0 6px rgba(0,0,0,.05);
        position: relative;
    }

    .main-content-placeholder {
        color: #666;
        font-size: 1.2rem;
        text-align: center;
        padding-top: 20%;
    }

    .video-container {
        margin-bottom: 20px;
    }

        .video-container iframe {
            width: 100%;
            height: 315px;
        }

    .add-video-btn {
        font-size: 12px;
        padding: 2px 6px;
        margin-left: 6px;
    }

    #translateBtn {
        position: absolute;
        display: none;
        z-index: 10001;
    }

    .option-line {
        display: flex;
        gap: 8px;
        margin-bottom: 6px;
    }

    /* ===== Lucky wheel ===== */
    .wheel-stage {
        position: relative;
        width: 340px;
        max-width: 100%;
        margin: 0 auto;
        padding-top: 8px;
        padding-bottom: 6px;
    }

    .wheel-wrap {
        position: relative;
        width: 320px;
        height: 320px;
        margin: 0 auto;
        border-radius: 50%;
        background: radial-gradient(circle at 30% 30%, #fff7d6 0%, #f2c94c 40%, #d4a62a 100%);
        padding: 10px;
        box-shadow: 0 10px 25px rgba(0,0,0,.15);
    }

    #wheelCanvas {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        background: #fff;
        box-shadow: inset 0 0 0 6px rgba(255,255,255,.8);
        transform: rotate(0deg);
    }

    .wheel-pointer {
        position: absolute;
        left: 50%;
        top: -2px;
        transform: translateX(-50%);
        width: 0;
        height: 0;
        border-left: 14px solid transparent;
        border-right: 14px solid transparent;
        border-top: 22px solid #ff6b6b;
        filter: drop-shadow(0 3px 2px rgba(0,0,0,.25));
        z-index: 5;
    }

        .wheel-pointer:after {
            content: '';
            position: absolute;
            left: 50%;
            top: -30px;
            transform: translateX(-50%);
            width: 10px;
            height: 10px;
            background: #ffd43b;
            border-radius: 50%;
            border: 2px solid #fff;
            box-shadow: 0 2px 6px rgba(0,0,0,.25);
        }

    /* ===== ASR Weekly UI (gọn + đẹp dạng bảng) ===== */
    .asr-wrap {
        max-width: 980px;
        margin: 0 auto;
    }

    .asr-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .asr-title {
        font-weight: 800;
        color: #dc3545;
        margin: 0;
    }

    .asr-sub {
        color: #6c757d;
        margin: 0;
        font-size: 13px;
    }

    .asr-cards {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
        margin-top: 12px;
    }

    .asr-card {
        border: 1px solid #f1c2c7;
        border-radius: 12px;
        background: #fff;
        padding: 12px 14px;
        box-shadow: 0 6px 16px rgba(0,0,0,.04);
    }

        .asr-card .label {
            font-size: 12px;
            color: #6c757d;
        }

        .asr-card .value {
            font-size: 20px;
            font-weight: 800;
            margin-top: 4px;
        }

        .asr-card .hint {
            font-size: 12px;
            color: #6c757d;
            margin-top: 6px;
        }

    .asr-table.card {
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid #f1c2c7;
    }

    .asr-table .card-header {
        background: #fff0f0;
        font-weight: 700;
        color: #721c24;
    }

    .asr-table table {
        margin: 0;
    }

    .asr-table th {
        font-size: 12px;
        color: #6c757d;
        text-transform: uppercase;
        letter-spacing: .4px;
    }

    .asr-table td {
        vertical-align: middle;
    }

    .asr-badge {
        font-size: 12px;
        padding: 6px 10px;
        border-radius: 999px;
    }

    .asr-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 8px;
    }

    .asr-mini {
        font-size: 12px;
        color: #6c757d;
    }

    .quiz-lesson {
        background: #f8fbff;
        border: 1px solid #e3e7ed;
        border-radius: 12px;
        padding: 20px;
    }

    .quiz-header {
        border-bottom: 1px solid #e9ecef;
        padding-bottom: 10px;
    }

    .quiz-footer {
        border-top: 1px solid #e9ecef;
        padding-top: 15px;
    }

    .admin-quiz-lesson {
        background: #f8fbff;
        border: 1px solid #e3e7ed;
        border-radius: 12px;
        padding: 20px;
    }

    @@media (max-width: 768px) {
        .asr-cards {
            grid-template-columns: 1fr;
        }
    }

    /* ===== ASR Widget liền khối, gọn ===== */
    #asrWidgetContainer {
        margin-top: 12px;
    }

        /* (tuỳ chọn) stick ở đáy khi scroll trong main-content */
        #asrWidgetContainer.sticky {
            position: sticky;
            bottom: 10px;
            z-index: 20;
        }

        /* giúp card trong widget gọn hơn chút */
        #asrWidgetContainer .asr-card,
        #asrWidgetContainer .card,
        #asrWidgetContainer .asr-widget,
        #asrWidgetContainer #asrWidget {
            border-radius: 12px !important;
        }
</style>

<div class="container-fluid">
    <div class="row g-0">

        <!-- Main -->
        <div class="col-md-9 main-content" id="lessonContent">

            <!-- Chỉ render nội dung động vào đây -->
            <div id="lessonBody">
                <div class="main-content-placeholder">
                    <h3>Chọn một bài học bên phải để bắt đầu</h3>
                    <p>Tiến độ tăng khi bạn: xem hết video, luyện phát âm đạt, và làm quiz ≥ 80.</p>
                </div>
            </div>

            <!-- Widget ASR nằm liền khối ngay dưới nội dung -->
            <div id="asrWidgetContainer" class="sticky" style="display:none;">
                @await Html.PartialAsync("_AsrWidget")
            </div>

        </div>

        <!-- Sidebar -->
        <div class="col-md-3 sidebar">
            <h4 class="text-danger">Danh sách bài học</h4>
            <div class="accordion" id="lessonAccordion">
                @foreach (var lesson in Model)
                {
                    <div class="accordion-item mb-2">
                        <h2 class="accordion-header" id="heading-@lesson.LessonId">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                    data-bs-target="#collapse-@lesson.LessonId" aria-expanded="false"
                                    aria-controls="collapse-@lesson.LessonId">
                                📖 Bài @(lesson.OrderInCourse) - @lesson.Title
                            </button>
                        </h2>

                        <div id="collapse-@lesson.LessonId" class="accordion-collapse collapse"
                             aria-labelledby="heading-@lesson.LessonId" data-bs-parent="#lessonAccordion">
                            <div class="accordion-body p-2">

                                <div class="list-group">
                                    <div class="d-flex align-items-center">
                                        <a href="#" class="list-group-item list-group-item-action lesson-content-link flex-grow-1"
                                           data-lesson-id="@lesson.LessonId" data-content-type="vocab">📚 Từ vựng</a>
                                        @if (isStaff)
                                        {
                                            <button class="btn btn-sm btn-outline-primary add-video-btn"
                                                    data-bs-toggle="modal" data-bs-target="#addVideoModal"
                                                    data-lesson-id="@lesson.LessonId" data-content-type="vocab">
                                                Thêm video
                                            </button>
                                        }
                                    </div>

                                    <div class="d-flex align-items-center">
                                        <a href="#" class="list-group-item list-group-item-action lesson-content-link flex-grow-1"
                                           data-lesson-id="@lesson.LessonId" data-content-type="grammar">📖 Ngữ pháp</a>
                                        @if (isStaff)
                                        {
                                            <button class="btn btn-sm btn-outline-primary add-video-btn"
                                                    data-bs-toggle="modal" data-bs-target="#addVideoModal"
                                                    data-lesson-id="@lesson.LessonId" data-content-type="grammar">
                                                Thêm video
                                            </button>
                                        }
                                    </div>

                                    <a href="#" class="list-group-item list-group-item-action lesson-content-link"
                                       data-lesson-id="@lesson.LessonId" data-content-type="kanji">🈶 Kanji</a>

                                    <a href="#" class="list-group-item list-group-item-action asr-weekly-link"
                                       data-lesson-id="@lesson.LessonId">🎤 Luyện nói (ASR)</a>

                                    <a href="#" class="list-group-item list-group-item-action lesson-quiz-link"
                                       data-lesson-id="@lesson.LessonId">📝 Kiểm tra (Quiz)</a>

                                    @if (isStaff)
                                    {
                                        <a href="#" class="list-group-item list-group-item-action lesson-admin-quiz"
                                           data-lesson-id="@lesson.LessonId">🛠️ Quản lý Quiz (Admin)</a>
                                    }
                                </div>

                                <div class="mt-3">
                                    <div class="d-flex justify-content-between mb-1">
                                        <small class="text-muted">Tiến độ</small>
                                        <small class="text-muted" id="progress-text-@lesson.LessonId">0%</small>
                                    </div>
                                    <div class="progress" style="height:8px;">
                                        <div id="progress-bar-@lesson.LessonId" class="progress-bar bg-danger" style="width:0%"></div>
                                    </div>
                                    <small class="text-muted d-block mt-1" id="progress-desc-@lesson.LessonId"></small>
                                </div>

                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

    </div>
</div>

<!-- Modal thêm video -->
<div class="modal fade" id="addVideoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Thêm video YouTube</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <label class="form-label">Link YouTube (embed hoặc youtu.be)</label>
                <input type="text" class="form-control" id="youtubeLink" placeholder="https://youtu.be/...">
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button class="btn btn-primary" id="saveVideoLink">Lưu</button>
            </div>
        </div>
    </div>
</div>




<!-- Nút dịch AI -->
<button id="translateBtn" class="btn btn-primary btn-sm">Dịch AI</button>

<!-- Modal Vòng quay may mắn -->
<div class="modal fade" id="luckyWheelModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">🎡 Vòng quay may mắn</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body text-center">
                <div class="wheel-stage">
                    <div class="wheel-pointer"></div>
                    <div class="wheel-wrap">
                        <canvas id="wheelCanvas" width="320" height="320"></canvas>
                    </div>
                </div>

                <div class="mt-3">
                    <button class="btn btn-danger" id="spinWheelBtn">
                        <i class="fa-solid fa-rotate-right"></i> Quay
                    </button>
                </div>

                <div class="mt-3" id="wheelResultBox" style="display:none;">
                    <div class="alert alert-info mb-0" id="wheelResultText"></div>
                </div>

                <small class="text-muted d-block mt-2">
                    *Mỗi tuần chỉ quay 1 lần khi bạn đạt chỉ tiêu.
                </small>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://www.youtube.com/iframe_api"></script>

<script>
    (function () {
        const token = document.querySelector('meta[name="request-verification-token"]')?.content || '';

        let currentLessonId = null;
        let currentContentType = null;
        let ytPlayers = {};

        // ===== utils =====
        function ensureEnableJsApi(url) {
            if (!url) return '';
            return url.includes('enablejsapi=1') ? url : (url + (url.includes('?') ? '&' : '?') + 'enablejsapi=1');
        }
        function escapeHtml(s) {
            return String(s ?? '').replace(/[&<>"']/g, m => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m]));
        }
        function setAsrWidgetVisible(visible) {
            const cont = document.getElementById('asrWidgetContainer');
            if (!cont) return;
            cont.style.display = visible ? 'block' : 'none';
        }

        // ===== content loader =====
        function loadLesson(lessonId, contentType) {
            setAsrWidgetVisible(false);

            $.get('/Lessons/GetLessonContent', { id: lessonId, type: contentType })
                .done(function (html) {
                    $.get('/Lessons/GetYouTubeLink', { lessonId, contentType })
                        .done(function (res) {
                            let videoHtml = '';
                            if (res?.youtubeLink) {
                                const safe = ensureEnableJsApi(res.youtubeLink);
                                const iframeId = `yt_${lessonId}_${contentType}`;
                                videoHtml = `
                                    <div class="video-container">
                                        <iframe id="${iframeId}" src="${safe}" frameborder="0"
                                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                            allowfullscreen></iframe>
                                    </div>`;
                                setTimeout(() => attachYT(iframeId, lessonId, contentType), 150);
                            }

                            $('#lessonBody').html(videoHtml + html);

                            // Kanji draw (demo)
                            if (contentType === 'kanji' && $('#kanjiDrawCanvas').length === 0) {
                                const drawHtml = `
                                    <hr/><h4>Viết Kanji của bạn</h4>
                                    <canvas id="kanjiDrawCanvas" width="300" height="300" style="border:1px solid #ccc; touch-action:none;"></canvas><br/>
                                    <button id="clearDrawBtn" class="btn btn-sm btn-secondary mt-2">Xoá</button>
                                    <button id="checkKanjiBtn" class="btn btn-sm btn-primary mt-2 ms-2">Kiểm tra chữ</button>
                                    <p id="drawResult" class="mt-2"></p>`;
                                $('#lessonBody').append(drawHtml);
                                initKanjiDraw();
                            }
                        })
                        .fail(() => $('#lessonBody').html(html));
                })
                .fail(() => $('#lessonBody').html('<div class="text-danger text-center">Đã có lỗi xảy ra.</div>'));
        }

        function attachYT(iframeId, lessonId, contentType) {
            try {
                ytPlayers[iframeId]?.destroy?.();
                ytPlayers[iframeId] = new YT.Player(iframeId, {
                    events: {
                        onStateChange: function (e) {
                            if (e.data === YT.PlayerState.ENDED) {
                                const eventType =
                                    (contentType === 'vocab') ? 'video_vocab_done' :
                                    (contentType === 'grammar') ? 'video_grammar_done' : null;
                                if (eventType) markEvent(lessonId, eventType);
                            }
                        }
                    }
                });
            } catch { }
        }

        // click tab nội dung
        $(document).on('click', '.lesson-content-link', function (e) {
            e.preventDefault();
            currentLessonId = $(this).data('lesson-id');
            currentContentType = $(this).data('content-type');
            loadLesson(currentLessonId, currentContentType);
        });

        // mở accordion thì refresh progress
        $(document).on('show.bs.collapse', function (e) {
            const id = $(e.target).attr('id');
            const lessonId = parseInt(id?.split('-')[1] || 0);
            if (lessonId) refreshProgress(lessonId);
        });

        // ===== video modal (Admin) =====
        $(document).on('click', '.add-video-btn', function () {
            currentLessonId = $(this).data('lesson-id');
            currentContentType = $(this).data('content-type');
            setAsrWidgetVisible(false);

            $.get('/Lessons/GetYouTubeLink', { lessonId: currentLessonId, contentType: currentContentType }, function (res) {
                $('#youtubeLink').val(res?.youtubeLink || '');
                $('#addVideoModal').modal('show');
            });
        });

        $('#saveVideoLink').on('click', function () {
            const link = $('#youtubeLink').val().trim();
            if (!link || !currentLessonId || !currentContentType) { alert('Thiếu dữ liệu.'); return; }

            $.ajax({
                url: '/Lessons/UpdateYouTubeLink',
                method: 'POST',
                headers: { 'RequestVerificationToken': token },
                data: { lessonId: currentLessonId, contentType: currentContentType, youtubeLink: link }
            })
            .done(res => {
                $('#addVideoModal').modal('hide');
                loadLesson(currentLessonId, currentContentType);
                alert(res?.message || 'Đã lưu');
            })
            .fail(xhr => alert('Lỗi khi lưu link: ' + (xhr.responseText || 'Unknown')));
        });

        // ===== Progress =====
        async function markEvent(lessonId, eventType) {
            try {
                await fetch('/Lessons/MarkEvent', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8',
                        'RequestVerificationToken': token
                    },
                    body: new URLSearchParams({ lessonId, eventType })
                });
                refreshProgress(lessonId);
            } catch { }
        }

        async function refreshProgress(lessonId) {
            try {
                const res = await fetch(`/Lessons/GetProgress?lessonId=${lessonId}`, { headers: { 'RequestVerificationToken': token } });
                const data = await res.json();

                const bar = document.getElementById(`progress-bar-${lessonId}`);
                const txt = document.getElementById(`progress-text-${lessonId}`);
                const desc = document.getElementById(`progress-desc-${lessonId}`);

                if (bar && txt) {
                    bar.style.width = data.percent + '%';
                    txt.textContent = data.percent + '%';
                    if (data.percent === 100) {
                        bar.classList.remove('bg-danger');
                        bar.classList.add('bg-success');
                    }
                }
                if (desc) desc.textContent = `Đã hoàn thành ${data.done}/${data.required} mục (Video/ASR/Quiz).`;
            } catch { }
        }

        // ===== Quiz (student) =====
        let quizCurrentLessonId = null;
        let quizAnswers = {};
        let totalQuizQuestions = 0;
               $(document).on('click', '.lesson-quiz-link', async function (e) {
        e.preventDefault();

        quizCurrentLessonId = $(this).data('lesson-id');
        setAsrWidgetVisible(false);

        const [statusRes, historyRes] = await Promise.all([
            fetch(`/Quizzes/GetQuizStatus?lessonId=${quizCurrentLessonId}`),
            fetch(`/Quizzes/GetQuizHistory?lessonId=${quizCurrentLessonId}`)
        ]);

        const status = await statusRes.json();
        const history = await historyRes.json();

        let historyHtml = `
            <h5 class="text-danger mb-2">📊 Lịch sử làm Quiz</h5>
        `;

        if (!history || history.length === 0) {
            historyHtml += `<div class="alert alert-info">Chưa làm lần nào.</div>`;
        } else {
            historyHtml += `
                <table class="table table-sm table-bordered align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th class="text-center">Điểm</th>
                            <th class="text-center">Kết quả</th>
                            <th class="text-center">Ngày làm</th>
                        </tr>
                    </thead>
                    <tbody>
            `;

            history.forEach((h, i) => {
                historyHtml += `
                    <tr>
                        <td>${i + 1}</td>
                        <td class="text-center">${h.score}</td>
                        <td class="text-center">
                            ${h.score >= 80
                                ? '<span class="badge bg-success">✔ Đạt</span>'
                                : '<span class="badge bg-danger">✘ Chưa đạt</span>'}
                        </td>
                        <td class="text-center">
                            ${new Date(h.dateTaken).toLocaleString()}
                        </td>
                    </tr>
                `;
            });

            historyHtml += `</tbody></table>`;
        }

        // ===== ĐÃ PASS → KHÔNG CHO LÀM LẠI =====
        if (status.hasDone && status.passed) {
            $('#lessonBody').html(`
                <div class="quiz-lesson">
                    <div class="alert alert-success mb-3">
                        ✅ Bạn đã hoàn thành bài này<br/>
                        <b>Điểm cao nhất:</b> ${status.score}
                    </div>
                    ${historyHtml}
                </div>
            `);
            return;
        }

        // ===== CHƯA PASS → CÓ NÚT LÀM BÀI =====
        $('#lessonBody').html(`
            <div class="quiz-lesson">
                ${historyHtml}
                <div class="text-end mt-3">
                    <button class="btn btn-danger" id="startQuizBtn">
                        📝 Làm bài kiểm tra
                    </button>
                </div>
            </div>
        `);
    });
        function renderBackToQuizHistoryBtn() {
        return `
            <div class="mb-3">
                <button class="btn btn-outline-secondary btn-sm" id="backToQuizHistoryBtn">
                    ⬅ Quay lại
                </button>
            </div>
        `;
    }

        async function renderQuizHistory(lessonId) {
        quizCurrentLessonId = lessonId;
        setAsrWidgetVisible(false);

        const [statusRes, historyRes] = await Promise.all([
            fetch(`/Quizzes/GetQuizStatus?lessonId=${lessonId}`),
            fetch(`/Quizzes/GetQuizHistory?lessonId=${lessonId}`)
        ]);

        const status = await statusRes.json();
        const history = await historyRes.json();

        let historyHtml = `<h5 class="text-danger mb-2">📊 Lịch sử làm Quiz</h5>`;

        if (!history || history.length === 0) {
            historyHtml += `<div class="alert alert-info">Chưa làm lần nào.</div>`;
