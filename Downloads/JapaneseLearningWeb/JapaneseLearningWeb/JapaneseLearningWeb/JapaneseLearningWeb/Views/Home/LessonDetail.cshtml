            const cx = W / 2, cy = H / 2;
            const r = Math.min(cx, cy) - 10;

            const n = wheelPrizes.length;
            const slice = (Math.PI * 2) / n;
            const startOffset = -Math.PI / 2;

            ctx.clearRect(0, 0, W, H);

            for (let i = 0; i < n; i++) {
                const start = startOffset + i * slice;
                const end = start + slice;

                ctx.beginPath();
                ctx.moveTo(cx, cy);
                ctx.arc(cx, cy, r, start, end);
                ctx.closePath();

                ctx.fillStyle = (i % 2 === 0) ? '#e7f5ff' : '#fff4e6';
                ctx.fill();

                ctx.strokeStyle = '#c92a2a';
                ctx.lineWidth = 2;
                ctx.stroke();

                ctx.save();
                ctx.translate(cx, cy);
                ctx.rotate(start + slice / 2);
                ctx.fillStyle = '#333';
                ctx.font = 'bold 14px Arial';
                ctx.textAlign = 'right';

                const lines = String(wheelPrizes[i].label).split('\n');
                const baseX = r - 16;
                let y = -8 * (lines.length - 1);
                for (const line of lines) {
                    ctx.fillText(line, baseX, y);
                    y += 16;
                }
                ctx.restore();
            }

            ctx.beginPath();
            ctx.arc(cx, cy, 42, 0, Math.PI * 2);
            ctx.fillStyle = '#228be6';
            ctx.fill();
            ctx.lineWidth = 6;
            ctx.strokeStyle = '#ffffff';
            ctx.stroke();

            ctx.fillStyle = '#fff';
            ctx.font = 'bold 18px Arial';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText('Quay', cx, cy);
        }

        function setWheelToIndex(index) {
            const canvas = document.getElementById('wheelCanvas');
            const n = wheelPrizes.length;
            const sliceDeg = 360 / n;
            const rotDeg = -(index * sliceDeg + sliceDeg / 2);
            canvas.style.transition = 'none';
            canvas.style.transform = `rotate(${rotDeg}deg)`;
            void canvas.offsetWidth;
        }

        function animateToIndex(index) {
            const canvas = document.getElementById('wheelCanvas');
            const n = wheelPrizes.length;
            const sliceDeg = 360 / n;
            const rotDeg = -(index * sliceDeg + sliceDeg / 2);
            const target = 360 * 6 + rotDeg;

            canvas.style.transition = 'transform 4s cubic-bezier(.12,.85,.15,1)';
            canvas.style.transform = `rotate(${target}deg)`;

            return new Promise(resolve => setTimeout(resolve, 4200));
        }

        function openWheelModal() {
            $('#wheelResultBox').hide();
            $('#wheelResultText').html('');
            $('#spinWheelBtn').prop('disabled', false);

            drawWheel();
            setWheelToIndex(0);
            $('#luckyWheelModal').modal('show');
        }

        async function spinWeeklyOnServer() {
            const res = await fetch('/Asr/SpinWeekly', {
                method: 'POST',
                headers: { 'RequestVerificationToken': token }
            });
            if (!res.ok) {
                const t = await res.text();
                throw new Error(t || 'Spin failed');
            }
            return await res.json();
        }

        function parseAmountFromTitle(title) {
            const s = String(title || '');
            const m = s.replace(/\./g, '').match(/(\d[\d,]*)\s*đ/i);
            if (!m) return null;
            const num = m[1].replace(/,/g, '');
            const val = parseInt(num, 10);
            return Number.isFinite(val) ? val : null;
        }

        function pickIndexFromServer(data) {
            if (!data) return 0;
            if (String(data.rewardKey).toUpperCase() === 'LOSE') return 0;

            const amt = (data.rewardAmount != null) ? Number(data.rewardAmount) : parseAmountFromTitle(data.rewardTitle);
            if (!amt) return 1;

            const idx = wheelPrizes.findIndex(p => p.key === 'VOUCHER' && p.amount === amt);
            return idx >= 0 ? idx : 1;
        }

        $(document).on('click', '.spin-weekly-btn', function () {
            openWheelModal();
        });

        $('#spinWheelBtn').on('click', async function () {
            if (isSpinning) return;
            isSpinning = true;
            $('#spinWheelBtn').prop('disabled', true);

            try {
                const data = await spinWeeklyOnServer();
                const idx = pickIndexFromServer(data);

                await animateToIndex(idx);

                let msg = data.rewardTitle || 'Chúc bạn may mắn lần sau 😊';
                const code = data.voucherCode || data.rewardCode;
                if (code) msg += `<br><b>Mã voucher:</b> ${escapeHtml(code)}`;

                $('#wheelResultText').html(msg);
                $('#wheelResultBox').show();

                if (currentContentType === 'asr_weekly') showAsrWeekly();
            } catch (e) {
                alert('Không quay được: ' + (e?.message || 'Lỗi không xác định'));
            } finally {
                isSpinning = false;
                $('#spinWheelBtn').prop('disabled', false);
            }
        });

