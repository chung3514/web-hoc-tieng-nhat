        window.addEventListener('asr:passed', async function (e) {
            const lessonId = e.detail?.lessonId || currentLessonId;

            if (lessonId) markEvent(lessonId, 'asr_passed');

            try {
                await fetch('/Asr/IncreaseWeekly', { method: 'POST', headers: { 'RequestVerificationToken': token } });
            } catch (err) {
                console.error('IncreaseWeekly failed', err);
