        // ===== Kanji draw =====
        function initKanjiDraw() {
            const canvas = document.getElementById('kanjiDrawCanvas');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');

            let strokes = [], cur = [], isDrawing = false;

            canvas.addEventListener('pointerdown', e => { isDrawing = true; cur = []; addPoint(e); });
            canvas.addEventListener('pointermove', e => { if (!isDrawing) return; addPoint(e); redraw(); });
            canvas.addEventListener('pointerup', e => { if (!isDrawing) return; isDrawing = false; strokes.push(cur); });

            function addPoint(e) {
                const r = canvas.getBoundingClientRect();
                cur.push({ x: e.clientX - r.left, y: e.clientY - r.top });
            }
            function drawStroke(s) {
                if (!s.length) return;
                ctx.beginPath();
                ctx.moveTo(s[0].x, s[0].y);
                for (let i = 1; i < s.length; i++) ctx.lineTo(s[i].x, s[i].y);
                ctx.stroke();
            }
            function redraw() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                ctx.lineWidth = 3;
                ctx.lineCap = 'round';
                ctx.strokeStyle = '#000';
                strokes.forEach(s => drawStroke(s));
                drawStroke(cur);
            }

            $('#clearDrawBtn').off('click').on('click', () => { strokes = []; cur = []; redraw(); $('#drawResult').text(''); });

            $('#checkKanjiBtn').off('click').on('click', async () => {
                if (!strokes.length) { alert('Hãy viết Kanji trước!'); return; }
                try {
                    const res = await fetch('/KanjiStroke/CheckKanji', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                        body: JSON.stringify({ strokes })
                    });
                    const result = await res.json();
                    $('#drawResult').text(result.message || 'Không có kết quả.');
                } catch {
                    $('#drawResult').text('Lỗi khi kiểm tra chữ.');
                }
            });
        }

