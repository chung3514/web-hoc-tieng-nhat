
 
@{
    ViewData["Title"] = "Trang chủ";
}

@section Styles {
    <style>
        .hero {
            text-align: center;
            padding: 80px 20px 60px;
            background: linear-gradient(135deg, #17b6b7 70%, #b0ecec 100%);
            color: #fff;
            border-radius: 0 0 30px 30px;
            margin-bottom: 50px;
            box-shadow: 0 4px 15px rgba(23, 182, 183, 0.12);
            font-family: 'Montserrat', sans-serif;
        }

            .hero h1 {
                font-size: 3rem;
                font-weight: 700;
                margin-bottom: 20px;
                line-height: 1.2;
                letter-spacing: 1.2px;
                color: #fff;
                text-shadow: 0 2px 10px #17b6b7a1;
            }

            .hero p {
                font-size: 1.3rem;
                margin-bottom: 35px;
                font-weight: 500;
                opacity: 0.97;
                color: #e6fafa;
            }

        .btn-custom {
            background: #fff;
            color: #17b6b7;
            border: none;
            font-size: 1.25rem;
            font-weight: 700;
            padding: 14px 38px;
            border-radius: 30px;
            box-shadow: 0 4px 16px #17b6b72b;
            transition: background 0.3s, color 0.3s, box-shadow 0.3s;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

            .btn-custom:hover, .btn-custom:focus {
                background: #e9fafb;
                color: #149091;
                box-shadow: 0 8px 24px #17b6b744;
                text-decoration: none;
                outline: none;
            }

            .btn-custom i {
                margin-right: 8px;
                font-size: 1.4rem;
                color: #17b6b7 !important;
                /* Đảm bảo icon cũng màu xanh */
            }
        /* Responsive */
        @@media (max-width: 576px) {
            .hero h1 {
                font-size: 2rem;
            }

            .hero p {
                font-size: 1rem;
                margin-bottom: 25px;
            }

            .btn-custom {
                font-size: 1rem;
                padding: 12px 28px;
            }
        }
    </style>
}

<div class="hero" role="banner" aria-label="Banner giới thiệu học tiếng Nhật">
    <h1>Chào mừng đến với Học Tiếng Nhật</h1>
    <p>Học tiếng Nhật dễ dàng với công nghệ AI!</p>
    <a class="btn btn-custom btn-lg" href="/Home/CourseLesson" role="button" aria-label="Bắt đầu học tiếng Nhật">
        <i class="fas fa-book-open" aria-hidden="true"></i> Bắt đầu học
    </a>

</div>

@section Scripts {
    @* Nếu cần JavaScript riêng, đặt ở đây *@
}
