@model JapaneseLearningWeb.Models.Category

@{
    ViewData["Title"] = "Chi tiết danh mục";
}

<style>
    :root {
        --teal: #17b6b7;
        --teal-hover: #0ba0a1;
        --teal-bg: #e3f7fb;
    }

    .category-detail-container {
        max-width: 700px;
    }

    .card {
        border: none;
        border-radius: 16px;
        box-shadow: 0 4px 18px rgba(0,0,0,0.06);
    }

    .card-header {
        background: var(--teal);
        color: #fff;
        border-radius: 16px 16px 0 0;
        padding: 16px 22px;
        font-weight: 700;
        font-size: 1.2rem;
    }

    .card-body {
        padding: 26px;
    }

    dt {
        font-weight: 600;
        color: var(--teal);
        margin-bottom: 4px;
    }

    dd {
        margin-bottom: 18px;
        font-size: 1.05rem;
        color: #333;
    }

    .btn-primary {
        background: var(--teal);
        border: none;
        border-radius: 30px;
        padding: 8px 26px;
        font-weight: 600;
    }

        .btn-primary:hover {
            background: var(--teal-hover);
        }

    .btn-danger {
        border-radius: 30px;
        padding: 8px 26px;
        font-weight: 600;
    }

    .btn-secondary {
        border-radius: 30px;
        padding: 8px 26px;
        font-weight: 600;
    }

    @@media (max-width: 576px) {
        .card-body {
            padding: 20px;
        }
    }
</style>

<div class="container category-detail-container my-4" role="main">
    <div class="card">

        <!-- HEADER -->
        <div class="card-header">
            <i class="fas fa-folder-open me-2"></i>Chi tiết danh mục
        </div>

        <!-- BODY -->
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-4">Tên danh mục</dt>
                <dd class="col-sm-8">@Model.Name</dd>

                <dt class="col-sm-4">Mô tả</dt>
                <dd class="col-sm-8">
                    @(string.IsNullOrWhiteSpace(Model.Description)
                        ? "Không có mô tả"
                        : Model.Description)
                </dd>

                <dt class="col-sm-4">Ngày tạo</dt>
                <dd class="col-sm-8">
                    @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                </dd>
            </dl>

            <!-- ACTIONS -->
            <div class="d-flex justify-content-center gap-3 mt-4 flex-wrap">
                @if (User.IsInRole("Admin") || User.IsInRole("Employee"))
                {
                    <a asp-action="Edit"
                       asp-route-id="@Model.CategoryId"
                       class="btn btn-primary">
                        <i class="fas fa-edit me-1"></i>Chỉnh sửa
                    </a>
                }

                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="Delete"
                       asp-route-id="@Model.CategoryId"
                       class="btn btn-danger">
                        <i class="fas fa-trash-alt me-1"></i>Xóa
                    </a>
                }

                <a asp-action="Index"
                   class="btn btn-secondary">
                    <i class="fas fa-arrow-left me-1"></i>Quay lại
                </a>
            </div>
        </div>
    </div>
</div>
