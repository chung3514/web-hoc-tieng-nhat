@model JapaneseLearningWeb.Models.Category

@{
    ViewData["Title"] = "Chỉnh sửa danh mục";
}

<style>
    :root {
        --teal: #17b6b7;
        --teal-hover: #0ba0a1;
        --teal-bg: #e3f7fb;
    }

    .category-edit-container {
        max-width: 600px;
    }

    .card {
        border: none;
        border-radius: 16px;
        box-shadow: 0 4px 18px rgba(0,0,0,0.06);
    }

    .card-header {
        background: var(--teal);
        color: #fff;
        border-radius: 16px 16px 0 0;
        padding: 16px 22px;
        font-weight: 700;
        font-size: 1.2rem;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .card-body {
        padding: 26px;
    }

    .form-label {
        font-weight: 600;
        color: var(--teal);
    }

    .form-control {
        border-radius: 10px;
        padding: 10px 14px;
        font-size: 1.05rem;
        border: 1.5px solid var(--teal);
    }

        .form-control:focus {
            border-color: var(--teal-hover);
            box-shadow: 0 0 0 0.15rem rgba(23,182,183,.25);
        }

    .text-danger {
        font-size: 0.9rem;
        font-weight: 500;
    }

    .btn-primary {
        background: var(--teal);
        border: none;
        border-radius: 30px;
        padding: 8px 26px;
        font-weight: 600;
    }

        .btn-primary:hover {
            background: var(--teal-hover);
        }

    .btn-secondary {
        border-radius: 30px;
        padding: 8px 26px;
        font-weight: 600;
    }

    @@media (max-width: 576px) {
        .card-body {
            padding: 20px;
        }
    }
</style>

<div class="container category-edit-container my-4" role="main">
    <div class="card">

        <!-- HEADER -->
        <div class="card-header">
            <i class="fas fa-edit"></i>
            Chỉnh sửa danh mục
        </div>

        <!-- BODY -->
        <div class="card-body">
            <form asp-action="Edit" method="post" novalidate>
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="CategoryId" />
                <input type="hidden" asp-for="CreatedAt" />

                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Tên danh mục</label>
                    <input asp-for="Name" class="form-control" placeholder="Nhập tên danh mục" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label">Mô tả</label>
                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4"
                              placeholder="Nhập mô tả (không bắt buộc)"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <!-- ACTIONS -->
                <div class="d-flex justify-content-center gap-3">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i>Lưu
                    </button>

                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i>Quay lại
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
