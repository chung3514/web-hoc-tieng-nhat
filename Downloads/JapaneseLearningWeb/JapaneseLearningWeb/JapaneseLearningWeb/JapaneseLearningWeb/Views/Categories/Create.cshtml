@model JapaneseLearningWeb.Models.Category

@{
    ViewData["Title"] = "Tạo mới danh mục";
}

@section Styles {
<style>
    :root {
        --teal: #17b6b7;
        --teal-hover: #0ba0a1;
    }

    /* Wrapper riêng – KHÔNG ảnh hưởng layout chung */
    .category-create-page {
        font-family: 'Montserrat', sans-serif;
        font-size: 14.5px;
        font-weight: 400;
        color: #334155;
    }

    .category-container {
        max-width: 600px;
        margin: 32px auto;
    }

    .card {
        border: none;
        border-radius: 16px;
        box-shadow: 0 6px 22px rgba(23,182,183,0.12);
        background: #fff;
    }

    /* HEADER */
    .card-header {
        background: var(--teal);
        color: #fff;
        border-radius: 16px 16px 0 0;
        padding: 16px 22px;
        font-size: 18px;
        font-weight: 600;
        text-align: center;
    }

    /* BODY */
    .card-body {
        padding: 26px;
    }

    /* FORM */
    .form-label {
        font-weight: 600;
        color: var(--teal);
        margin-bottom: 6px;
    }

    .form-control {
        border-radius: 10px;
        padding: 10px 14px;
        font-size: 14.5px;
        border: 1.5px solid var(--teal);
        background: #f8fefe;
    }

    .form-control:focus {
        border-color: var(--teal-hover);
        box-shadow: 0 0 0 0.15rem rgba(23,182,183,.25);
        background: #fff;
    }

    .text-danger {
        font-size: 0.9rem;
        font-weight: 500;
    }

    /* ACTIONS */
    .btn-primary {
        background: var(--teal);
        border: none;
        border-radius: 30px;
        padding: 8px 26px;
        font-weight: 600;
        font-size: 14px;
    }

    .btn-primary:hover {
        background: var(--teal-hover);
    }

    .btn-secondary {
        border-radius: 30px;
        padding: 8px 26px;
        font-weight: 600;
        font-size: 14px;
    }

    /* MOBILE */
    @@media (max-width: 576px) {
        .card-body {
            padding: 20px;
        }
    }
</style>
}

<div class="category-create-page">
    <div class="category-container">
        <div class="card">

            <!-- HEADER -->
            <div class="card-header">
                ➕ Tạo mới danh mục
            </div>

            <!-- BODY -->
            <div class="card-body">
                <form asp-action="Create" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Tên danh mục</label>
                        <input asp-for="Name" class="form-control"
                               placeholder="Nhập tên danh mục" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label">Mô tả</label>
                        <textarea asp-for="Description" class="form-control"
                                  rows="4"
                                  placeholder="Nhập mô tả (không bắt buộc)"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-center gap-3">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-1"></i> Tạo
                        </button>

                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-1"></i> Quay lại
                        </a>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
