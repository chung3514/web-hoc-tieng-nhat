@model PagedListViewModel<JapaneseLearningWeb.Models.Category>

@{
    ViewData["Title"] = "Danh sách danh mục";
    int currentPage = Model.PageNumber;
    int pageSize = Model.PageSize;
    int totalPages = Model.TotalPages;
}

<style>
    /* ===== CHUẨN GIỐNG GRAMMAR ===== */

    .category-container {
        max-width: 1100px;
    }

    :root {
        --teal: #17b6b7;
        --teal-hover: #0ba0a1;
        --teal-bg: #e3f7fb;
    }

    .card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 4px 18px rgba(0,0,0,0.06);
    }

    .card-header {
        background-color: var(--teal);
        color: #fff;
        border-radius: 12px 12px 0 0;
    }

    .btn-teal {
        background: var(--teal);
        color: #fff;
        border-radius: 30px;
        font-weight: 600;
    }

        .btn-teal:hover {
            background: var(--teal-hover);
        }

    /* Accordion FIX */
    .accordion-item {
        border: none;
        border-radius: 10px;
        overflow: hidden;
        margin-bottom: 10px;
        background: #f8f9fa;
    }

    .accordion-button {
        font-size: 0.95rem; /* 🔥 FIX CHỮ TO */
        font-weight: 600;
        padding: 0.9rem 1.25rem;
        background: #fff;
        color: #333;
    }

        .accordion-button:not(.collapsed) {
            background: var(--teal-bg);
            color: var(--teal);
        }

    .accordion-body {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        align-items: center;
        font-size: 0.95rem;
    }

    .pagination .page-link {
        border-radius: 50px;
        color: var(--teal);
    }

    .pagination .page-item.active .page-link {
        background: var(--teal);
        border-color: var(--teal);
        color: #fff;
    }
</style>

<div class="container category-container my-4">
    <div class="card">
        <!-- HEADER -->
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                <i class="fas fa-folder-open me-2"></i>@ViewData["Title"]
            </h5>

            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Create" class="btn btn-light btn-sm">
                    <i class="fas fa-plus-circle me-1"></i> Tạo danh mục
                </a>
            }
        </div>

        <!-- BODY -->
        <div class="card-body">

            <!-- SEARCH -->
            <form asp-action="Search" method="get" class="row g-3 mb-4">
                <div class="col-md-8">
                    <input type="search"
                           name="keyword"
                           value="@Model.Keyword"
                           class="form-control"
                           placeholder="Tìm kiếm theo tên hoặc mô tả..." />
                </div>

                <div class="col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-info text-white w-100">
                        Tìm kiếm
                    </button>

                    @if (!string.IsNullOrEmpty(Model.Keyword))
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary w-100">
                            Xóa lọc
                        </a>
                    }
                </div>
            </form>


            <!-- LIST -->
            <div class="accordion" id="categoryAccordion">
                @if (Model.Items.Any())
                {
                    @foreach (var item in Model.Items)
                    {
                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed"
                                        type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#cat-@item.CategoryId">
                                    <i class="fas fa-folder me-2"></i>@item.Name
                                </button>
                            </h2>

                            <div id="cat-@item.CategoryId"
                                 class="accordion-collapse collapse"
                                 data-bs-parent="#categoryAccordion">
                                <div class="accordion-body">
                                    <div class="flex-grow-1 text-secondary">
                                        <strong>Mô tả:</strong>
                                        @(string.IsNullOrEmpty(item.Description)
                                            ? "Không có mô tả"
                                            : item.Description)
                                    </div>

                                    <a asp-action="Details"
                                       asp-route-id="@item.CategoryId"
                                       class="btn btn-outline-info btn-sm">
                                        Chi tiết
                                    </a>

                                    @if (User.IsInRole("Admin") || User.IsInRole("Employee"))
                                    {
                                        <a asp-action="Edit"
                                           asp-route-id="@item.CategoryId"
                                           class="btn btn-outline-warning btn-sm">
                                            Sửa
                                        </a>
                                    }

                                    @if (User.IsInRole("Admin"))
                                    {
                                        <a asp-action="Delete"
                                           asp-route-id="@item.CategoryId"
                                           class="btn btn-outline-danger btn-sm">
                                            Xóa
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center text-muted py-4">
                        Không có danh mục nào.
                    </div>
                }
            </div>

            <!-- PAGINATION -->
            @if (totalPages > 1)
            {
                <nav class="mt-4">
                    <ul class="pagination justify-content-center">
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link"
                                   asp-route-pageNumber="@i"
                                   asp-route-pageSize="@pageSize"
                                   asp-route-keyword="@Model.Keyword">
                                    @i
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            }

            <div class="text-center mt-3 text-secondary">
                Tổng cộng: @Model.TotalItems danh mục
            </div>
        </div>
    </div>
</div>
