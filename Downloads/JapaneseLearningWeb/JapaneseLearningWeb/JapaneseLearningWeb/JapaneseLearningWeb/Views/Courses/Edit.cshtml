@model JapaneseLearningWeb.Models.Course

@{
    ViewData["Title"] = "Chỉnh sửa khóa học";
}

<style>
    :root {
        --teal: #17b6b7;
        --teal-hover: #0ba0a1;
        --teal-bg: #e3f7fb;
    }

    .course-edit-container {
        max-width: 800px;
    }

    .card {
        border: none;
        border-radius: 16px;
        box-shadow: 0 4px 18px rgba(0,0,0,0.06);
    }

    .card-header {
        background: var(--teal);
        color: #fff;
        border-radius: 16px 16px 0 0;
        padding: 16px 22px;
        font-weight: 700;
        font-size: 1.2rem;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .card-body {
        padding: 28px;
        background: #fff;
    }

    .form-label {
        font-weight: 600;
        color: var(--teal);
    }

    .form-control,
    .form-select {
        border-radius: 10px;
        padding: 10px 14px;
        font-size: 1.05rem;
        border: 1.5px solid var(--teal);
    }

        .form-control:focus,
        .form-select:focus {
            border-color: var(--teal-hover);
            box-shadow: 0 0 0 0.15rem rgba(23,182,183,.25);
        }

    .form-check-input {
        width: 1.25rem;
        height: 1.25rem;
        cursor: pointer;
    }

    .form-check-label {
        font-weight: 600;
        cursor: pointer;
    }

    .btn-primary {
        background: var(--teal);
        border: none;
        border-radius: 30px;
        padding: 8px 30px;
        font-weight: 600;
    }

        .btn-primary:hover {
            background: var(--teal-hover);
        }

    .btn-secondary {
        border-radius: 30px;
        padding: 8px 30px;
        font-weight: 600;
    }

    .text-danger {
        font-size: 0.9rem;
        font-weight: 500;
    }

    @@media (max-width: 576px) {
        .card-body {
            padding: 20px;
        }
    }
</style>

<div class="container course-edit-container my-4">
    <div class="card">

        <!-- HEADER -->
        <div class="card-header">
            <i class="fas fa-edit"></i>
            Chỉnh sửa khóa học
        </div>

        <!-- BODY -->
        <div class="card-body">
            <form asp-action="Edit" method="post" novalidate>
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="CourseId" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label">Tiêu đề khóa học</label>
                    <input asp-for="Title" class="form-control" placeholder="Nhập tiêu đề khóa học" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Mô tả khóa học</label>
                    <textarea asp-for="Description"
                              class="form-control"
                              rows="3"
                              placeholder="Nhập mô tả khóa học"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="form-check mb-3">
                    <input class="form-check-input" asp-for="IsFree" id="IsFreeCheck" />
                    <label class="form-check-label" for="IsFreeCheck">
                        Khóa học miễn phí
                    </label>
                </div>

                <div class="mb-3">
                    <label asp-for="Price" class="form-label">Giá khóa học (VNĐ)</label>
                    <input asp-for="Price"
                           type="number"
                           min="0"
                           step="1000"
                           class="form-control"
                           placeholder="Nhập giá khóa học" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="CategoryId" class="form-label">Danh mục</label>
                    <select asp-for="CategoryId"
                            class="form-select"
                            asp-items="@(new SelectList(ViewBag.Categories, "CategoryId", "Name"))">
                        <option value="">-- Chọn danh mục --</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                </div>

                <!-- ACTIONS -->
                <div class="d-flex justify-content-center gap-3 mt-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i>Lưu
                    </button>

                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i>Quay lại
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
