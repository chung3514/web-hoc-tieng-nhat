@model JapaneseLearningWeb.Models.Course
@{
    ViewData["Title"] = "Tạo khóa học mới";
}

@section Styles {
    <style>
        :root {
            --teal: #17b6b7;
            --teal-hover: #0ba0a1;
        }

        /* ===== PAGE WRAPPER ===== */
        .course-create-page {
            font-family: 'Montserrat', sans-serif;
            font-size: 14.5px;
            font-weight: 400;
            color: #334155;
        }

        .course-container {
            max-width: 600px;
            margin: 32px auto;
        }

        /* ===== CARD ===== */
        .card {
            border: none;
            border-radius: 16px;
            box-shadow: 0 6px 24px rgba(23,182,183,0.12);
            background: #fff;
        }

        .card-header {
            background: var(--teal);
            color: #fff;
            border-radius: 16px 16px 0 0;
            padding: 16px 22px;
            font-size: 18px;
            font-weight: 600;
            text-align: center;
        }

        .card-body {
            padding: 26px;
            background: #f8fefe;
        }

        /* ===== FORM ===== */
        .form-label {
            font-weight: 600;
            color: var(--teal);
            margin-bottom: 6px;
        }

        .form-control,
        .form-select {
            border-radius: 10px;
            padding: 10px 14px;
            font-size: 14.5px;
            border: 1.5px solid var(--teal);
            background: #f8fefe;
            color: #334155;
        }

            .form-control:focus,
            .form-select:focus {
                border-color: var(--teal-hover);
                box-shadow: 0 0 0 0.15rem rgba(23,182,183,.25);
                background: #fff;
            }

        .form-check-label {
            font-weight: 500;
            font-size: 14.5px;
            color: #334155;
        }

        .text-danger {
            font-size: 0.9rem;
            font-weight: 500;
        }

        /* ===== BUTTONS ===== */
        .btn-primary {
            background: var(--teal);
            border: none;
            border-radius: 30px;
            padding: 10px 28px;
            font-weight: 600;
            font-size: 14.5px;
            box-shadow: 0 4px 12px rgba(23,182,183,0.35);
        }

            .btn-primary:hover {
                background: var(--teal-hover);
            }

        .btn-secondary {
            border-radius: 30px;
            padding: 10px 28px;
            font-weight: 600;
            font-size: 14.5px;
        }

        /* ===== MOBILE ===== */
        @@media (max-width: 576px) {
            .card-body

        {
            padding: 20px;
        }

        }
    </style>
}

<div class="course-create-page">
    <div class="course-container">
        <div class="card">

            <!-- HEADER -->
            <div class="card-header">
                ➕ Tạo khóa học mới
            </div>

            <!-- BODY -->
            <div class="card-body">
                <div id="errorSummary" class="text-danger mb-3"></div>

                <form id="createCourseForm" method="post" asp-action="Create" novalidate>
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label">Tiêu đề khóa học</label>
                        <input asp-for="Title" class="form-control" maxlength="100"
                               placeholder="Nhập tiêu đề khóa học" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Mô tả khóa học</label>
                        <textarea asp-for="Description" class="form-control" rows="3"
                                  placeholder="Nhập mô tả khóa học"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input class="form-check-input" asp-for="IsFree" id="IsFreeCheck" />
                        <label class="form-check-label" for="IsFreeCheck">
                            Khóa học miễn phí
                        </label>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Price" class="form-label">Giá khóa học</label>
                        <input asp-for="Price" type="number" step="0.01" min="0"
                               class="form-control" />
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="CategoryId" class="form-label">Danh mục khóa học</label>
                        <select asp-for="CategoryId" class="form-select">
                            <option value="">-- Chọn danh mục --</option>
                            @foreach (var category in ViewBag.Categories)
                            {
                                <option value="@category.CategoryId">@category.Name</option>
                            }
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-center gap-3">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save me-1"></i> Tạo
                        </button>

                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Quay lại
                        </a>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.getElementById('createCourseForm')
            .addEventListener('submit', function (e) {
                e.preventDefault();
                const form = this;
                const data = new FormData(form);

                fetch(form.action, {
                    method: form.method,
                    body: data,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                })
                .then(res => res.json())
                .then(res => {
                    if (res.success) {
                        window.location.href = '@Url.Action("Index", "Courses")'
                            + '?successMessage=' + encodeURIComponent(res.message);
                    } else {
                        document.getElementById('errorSummary').innerHTML =
                            '<ul>' + res.errors.map(e => `<li>${e}</li>`).join('') + '</ul>';
                    }
                })
                .catch(() => alert('Có lỗi xảy ra, vui lòng thử lại.'));
            });
    </script>
}
