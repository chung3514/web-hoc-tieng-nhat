@model List<JapaneseLearningWeb.Models.Course>

@{
    ViewData["Title"] = "Danh sách khóa học";
}

<style>
    /* ===== CHUẨN GIỐNG GRAMMAR ===== */

    .course-container {
        max-width: 1100px;
    }

    :root {
        --teal: #17b6b7;
        --teal-hover: #0ba0a1;
        --teal-bg: #e3f7fb;
    }

    .card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 4px 18px rgba(0,0,0,0.06);
    }

    .card-header {
        background-color: var(--teal);
        color: #fff;
        border-radius: 12px 12px 0 0;
    }

    .table thead th {
        background: #f8f9fa;
        font-weight: 600;
        font-size: 0.95rem;
    }

    .table tbody tr:hover {
        background-color: var(--teal-bg);
    }

    .btn-outline-info,
    .btn-outline-warning,
    .btn-outline-danger,
    .btn-outline-success {
        min-width: 85px;
        font-weight: 600;
    }

    .btn-outline-info {
        border-color: var(--teal);
        color: var(--teal);
    }

        .btn-outline-info:hover {
            background: var(--teal);
            color: #fff;
        }

    .btn-outline-warning:hover {
        background: #e0a800;
        color: #fff;
    }

    .btn-outline-danger:hover {
        background: #dc3545;
        color: #fff;
    }

    .btn-outline-success:hover {
        background: #28a745;
        color: #fff;
    }
</style>

<div class="container course-container my-4">
    <div class="card">

        <!-- HEADER -->
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                <i class="fas fa-book-open me-2"></i>@ViewData["Title"]
            </h5>

            @if (User.IsInRole("Admin") || User.IsInRole("Employee"))
            {
                <a asp-action="Create" class="btn btn-light btn-sm">
                    <i class="fas fa-plus-circle me-1"></i> Tạo khóa học
                </a>
            }
        </div>

        <!-- BODY -->
        <div class="card-body">

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Tiêu đề</th>
                            <th>Mô tả</th>
                            <th>Loại</th>
                            <th>Giá</th>
                            <th>Danh mục</th>
                            <th>Ngày tạo</th>
                            <th class="text-end">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Title</td>
                                <td>@item.Description</td>
                                <td>
                                    @if (item.IsFree)
                                    {
                                        <span class="badge bg-success">Miễn phí</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger fw-semibold">
                                            @item.Price.ToString("N0")đ
                                        </span>
                                    }
                                </td>
                                <td>
                                    @(item.IsFree
                                        ? "N/A"
                                        : item.Price.ToString("C0",
                                        System.Globalization.CultureInfo.GetCultureInfo("vi-VN")))
                                </td>
                                <td>@item.Category?.Name</td>
                                <td>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-end">

                                    <!-- Chi tiết -->
                                    <a asp-action="Details"
                                       asp-route-id="@item.CourseId"
                                       class="btn btn-outline-info btn-sm me-1">
                                        Chi tiết
                                    </a>

                                    <!-- 🔥 CHỈ HIỆN TRUY CẬP KHI KHÔNG PHẢI FREE -->
                                    @if (User.Identity.IsAuthenticated)
                                    {
                                        <a asp-controller="Home"
                                           asp-action="LessonDetail"
                                           asp-route-courseId="@item.CourseId"
                                           class="btn btn-outline-success btn-sm me-1">
                                            Truy cập
                                        </a>
                                    }

                                    <!-- Admin / Employee -->
                                    @if (User.IsInRole("Admin") || User.IsInRole("Employee"))
                                    {
                                        <a asp-action="Edit"
                                           asp-route-id="@item.CourseId"
                                           class="btn btn-outline-warning btn-sm me-1">
                                            Sửa
                                        </a>
                                        <a asp-action="Delete"
                                           asp-route-id="@item.CourseId"
                                           class="btn btn-outline-danger btn-sm">
                                            Xóa
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>
