@model JapaneseLearningWeb.Models.Course

@{
    ViewData["Title"] = "Chi tiết khóa học - " + Model.Title;
}

<style>
    :root {
        --teal: #17b6b7;
        --teal-hover: #0ba0a1;
        --teal-bg: #e3f7fb;
    }

    .course-detail-container {
        max-width: 1000px;
    }

    .card {
        border: none;
        border-radius: 16px;
        box-shadow: 0 4px 18px rgba(0,0,0,0.06);
    }

    .card-header {
        background: var(--teal);
        color: #fff;
        border-radius: 16px 16px 0 0;
        padding: 18px 24px;
    }

        .card-header h4 {
            font-weight: 700;
            margin: 0;
        }

    .card-body {
        background: #fff;
        padding: 24px;
    }

    .course-description {
        font-size: 1.05rem;
        color: #333;
        line-height: 1.7;
        margin-bottom: 32px;
    }

    .section-title {
        color: var(--teal);
        font-weight: 700;
        margin-bottom: 18px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .lesson-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .lesson-item {
        background: #f8f9fa;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        padding: 14px 18px;
        margin-bottom: 12px;
        transition: background-color 0.25s ease;
    }

        .lesson-item:hover {
            background: var(--teal-bg);
        }

    .lesson-link {
        text-decoration: none;
        color: var(--teal);
        font-weight: 600;
        font-size: 1.05rem;
        display: block;
    }

        .lesson-link:hover {
            color: var(--teal-hover);
            text-decoration: underline;
        }

    .btn-back {
        background: var(--teal);
        color: #fff;
        font-weight: 600;
        border-radius: 30px;
        padding: 8px 26px;
    }

        .btn-back:hover {
            background: var(--teal-hover);
            color: #fff;
        }
</style>

<div class="container course-detail-container my-4">
    <div class="card">

        <!-- HEADER -->
        <div class="card-header">
            <h4>
                <i class="fas fa-book-open me-2"></i>@Model.Title
            </h4>
        </div>

        <!-- BODY -->
        <div class="card-body">

            <!-- DESCRIPTION -->
            <div class="course-description">
                @Model.Description
            </div>

            <!-- LESSON LIST -->
            <h5 class="section-title">
                <i class="fas fa-chalkboard-teacher"></i> Danh sách bài học
            </h5>

            @if (Model.Lessons != null && Model.Lessons.Any())
            {
                <ul class="lesson-list">
                    @foreach (var lesson in Model.Lessons.OrderBy(l => l.OrderInCourse))
                    {
                        <li class="lesson-item">
                            <a asp-controller="Lessons"
                               asp-action="Details"
                               asp-route-id="@lesson.LessonId"
                               class="lesson-link">
                                Bài @lesson.OrderInCourse – @lesson.Title
                            </a>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="text-muted fst-italic">Chưa có bài học nào trong khóa học này.</p>
            }

            <!-- BACK -->
            <div class="text-center mt-4">
                <a asp-action="Index" class="btn btn-back">
                    <i class="fas fa-arrow-left me-1"></i> Quay lại danh sách
                </a>
            </div>

        </div>
    </div>
</div>
