@* Views/Shared/_AsrWidget.cshtml *@
@{
    var target = (ViewData["TargetText"] as string) ?? "";
}
<style>
    .asr-card {
        border: 1px solid rgba(0,0,0,.08);
        border-radius: 12px;
        padding: 16px;
        background: #fff
    }

    .asr-title {
        font-weight: 700;
        color: #0d6efd;
        margin-bottom: 8px
    }

    .asr-sub {
        color: #666;
        font-size: .95rem;
        margin-bottom: 12px
    }

    .asr-row {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        align-items: center;
    }

        .asr-row .form-control {
            flex: 1 1 240px
        }

    .asr-btn {
        min-width: 120px
    }

    .asr-meter {
        height: 8px;
        background: #eee;
        border-radius: 999px;
        overflow: hidden
    }

        .asr-meter > div {
            height: 100%;
            width: 0%;
            background: #0d6efd;
            transition: width .25s ease
        }

    .asr-badge {
        display: inline-block;
        background: #e7f1ff;
        color: #0d6efd;
        border: 1px solid rgba(13,110,253,.15);
        padding: 2px 8px;
        border-radius: 999px;
        margin: 2px 4px 0 0;
        font-size: .85rem
    }

    .asr-bubble {
        background: #f8f9fa;
        border: 1px dashed #ddd;
        border-radius: 10px;
        padding: 10px 12px;
        white-space: pre-wrap
    }

    .asr-small {
        font-size: .9rem;
        color: #555
    }
</style>

<div class="asr-card" id="asrWidget">
    <div class="asr-title">🎙️ Luyện phát âm Nhật (ASR)</div>
    <div class="asr-sub">Nhận diện phát âm, phát hiện <b>trường âm</b>（長音）và <b>mora</b>（モーラ）. Thử đọc theo câu mẫu nhé!</div>

    <div class="asr-row mb-2">
        <input id="asrTarget" class="form-control" placeholder="Nhập câu mẫu tiếng Nhật (kana/kanji)..." value="@target" />
        <button id="asrSpeakBtn" class="btn btn-outline-secondary asr-btn" type="button" title="Phát mẫu (TTS)">
            <i class="fa-solid fa-volume-high"></i> Nghe mẫu
        </button>
    </div>

    <div class="asr-row mb-2">
        <button id="asrRecBtn" class="btn btn-primary asr-btn" type="button">
            <i class="fa-solid fa-microphone"></i> Bắt đầu nói
        </button>
        <button id="asrStopBtn" class="btn btn-outline-danger asr-btn" type="button" disabled>
            <i class="fa-solid fa-square"></i> Dừng
        </button>
        <div class="flex-grow-1">
            <div class="asr-meter"><div id="asrLevel"></div></div>
            <div class="asr-small mt-1" id="asrHint">Tip: giữ khoảng cách 15–20cm, môi trường yên tĩnh.</div>
        </div>
    </div>

    <div class="mb-2">
        <div class="fw-bold">Bạn vừa nói (認識結果):</div>
        <div id="asrRecognized" class="asr-bubble">—</div>
    </div>

    <div class="mb-1">
        <span class="asr-badge" id="asrMoraCount">Mora: —</span>
        <span class="asr-badge" id="asrChoon">Trường âm: —</span>
        <span class="asr-badge" id="asrMatch">Khớp mẫu: —</span>
    </div>

    <div class="mb-2">
        <div class="fw-bold">Ngắt nhịp mora (ước lượng):</div>
        <div id="asrMoraSeq" class="asr-bubble">—</div>
    </div>
</div>

<script>
    (function () {
        if (window.__ASR_INIT__) return; window.__ASR_INIT__ = true;

        // ====== CẤU HÌNH ======
        // Ngưỡng coi là "đạt" để tính vào chỉ tiêu & tiến độ
        const PASS_THRESHOLD = 80;

        // ====== Utils: Kana normalize & Mora segmentation ======
        function kataToHira(s) {
            // Katakana → Hiragana
            return (s || "").replace(/[ァ-ン]/g, ch => String.fromCharCode(ch.charCodeAt(0) - 0x60));
        }
        function normalizeJa(s) {
            return kataToHira((s || "")
                .replace(/[！!。．\.、，,？?・「」『』\s]/g, '')
                .replace(/ー/g, 'ー')  // giữ trường âm
            );
        }
        // tách thành ký tự kana (bao gồm ー và small kana)
        function splitKana(s) { return Array.from(normalizeJa(s)); }

        const HIRA_SMALL = new Set(['ゃ', 'ゅ', 'ょ', 'ぁ', 'ぃ', 'ぅ', 'ぇ', 'ぉ', 'ゎ', 'ゕ', 'ゖ']);
        function moraSegment(hiraStr) {
            const chars = Array.from(hiraStr);
            const segs = [];
            for (let i = 0; i < chars.length; i++) {
                const c = chars[i];
                if (c === 'っ') { segs.push('っ'); continue; } // sokuon
                if (c === 'ん') { segs.push('ん'); continue; } // moraic n
                if (c === 'ー') { segs.push('ー'); continue; } // trường âm tách riêng
                if (HIRA_SMALL.has(c)) {
                    if (segs.length > 0) segs[segs.length - 1] += c;
                    else segs.push(c);
                    continue;
                }
                segs.push(c);
            }
            return segs;
        }
        function countMoraFromSeg(segs) {
            return segs.length;
        }
        function hasChoon(hiraStr) {
            return hiraStr.includes('ー') || /おう|えい/g.test(hiraStr);
        }
        function hira(s) {
            return kataToHira(s || "");
        }
        function percentMatch(a, b) {
            if (!a || !b) return 0;
            const sa = normalizeJa(a), sb = normalizeJa(b);
            if (!sa.length || !sb.length) return 0;
            let same = 0, len = Math.max(sa.length, sb.length);
            for (let i = 0; i < Math.min(sa.length, sb.length); i++) {
                if (sa[i] === sb[i]) same++;
            }
            return Math.round(100 * same / len);
        }

        // ====== DOM ======
        const $rec = document.getElementById('asrRecBtn');
        const $stop = document.getElementById('asrStopBtn');
        const $speak = document.getElementById('asrSpeakBtn');
        const $target = document.getElementById('asrTarget');
        const $lvl = document.getElementById('asrLevel');
        const $hint = document.getElementById('asrHint');
        const $recog = document.getElementById('asrRecognized');
        const $moraCount = document.getElementById('asrMoraCount');
        const $choon = document.getElementById('asrChoon');
        const $match = document.getElementById('asrMatch');
        const $moraSeq = document.getElementById('asrMoraSeq');

        // ====== Audio level meter (analyzer) ======
        let audioCtx, mediaStream, analyser, raf;
        async function startMeter() {
            mediaStream = await navigator.mediaDevices.getUserMedia({ audio: true });
            audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            const src = audioCtx.createMediaStreamSource(mediaStream);
            analyser = audioCtx.createAnalyser();
            analyser.fftSize = 512;
            src.connect(analyser);
            const data = new Uint8Array(analyser.frequencyBinCount);
            function tick() {
                analyser.getByteTimeDomainData(data);
                let sum = 0; for (let i = 0; i < data.length; i++) { const v = (data[i] - 128) / 128; sum += v * v; }
                const rms = Math.sqrt(sum / data.length);
                $lvl.style.width = Math.min(100, (rms * 200)).toFixed(0) + '%';
                raf = requestAnimationFrame(tick);
            }
            tick();
        }
        function stopMeter() {
            cancelAnimationFrame(raf);
            $lvl.style.width = '0%';
            if (mediaStream) { mediaStream.getTracks().forEach(t => t.stop()); }
            if (audioCtx) { audioCtx.close(); }
            analyser = audioCtx = mediaStream = null;
        }

        // ====== Web Speech API (primary path) ======
        const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
        let recog;
        function setupSR() {
            if (!SR) return null;
            const r = new SR();
            r.lang = 'ja-JP';
            r.interimResults = false;
            r.maxAlternatives = 1;
            r.continuous = false;
            r.onresult = (ev) => {
                const text = (ev.results?.[0]?.[0]?.transcript || '').trim();
                handleRecognized(text);
            };
            r.onerror = (e) => { $hint.textContent = 'ASR lỗi: ' + e.error; };
            r.onend = () => {
                $rec.disabled = false; $stop.disabled = true;
                stopMeter();
            };
            return r;
        }
        recog = setupSR();

        // Xử lý chung khi đã có text nhận diện được (trường hợp Web Speech)
        function handleRecognized(text) {
            const norm = normalizeJa(text);
            $recog.textContent = text || '—';
            const hiraStr = hira(norm);
            const segs = moraSegment(hiraStr);
            const cnt = countMoraFromSeg(segs);
            const choon = hasChoon(hiraStr);

            $moraCount.textContent = 'Mora: ' + (cnt || '—');
            $choon.textContent = 'Trường âm: ' + (choon ? 'Có' : 'Không');
            $moraSeq.textContent = segs.length ? segs.join('・') : '—';

            const tgt = $target.value || '';
            const pm = percentMatch(norm, tgt);
            $match.textContent = 'Khớp mẫu: ' + (tgt ? (pm + '%') : '—');

            if (tgt) {
                if (choon === false && /ー|おう|えい/.test(normalizeJa(tgt))) {
                    $hint.textContent = 'Gợi ý: Câu mẫu có trường âm, hãy kéo dài âm phù hợp (ー/おう/えい).';
                } else {
                    $hint.textContent = 'Tip: phát âm đều nhịp theo các mora ở trên.';
                }
            }

            // >>>> NẾU ĐẠT NGƯỠNG THÌ BẮN SỰ KIỆN ĐỂ LƯU TIẾN ĐỘ <<<<
            if (tgt && pm >= PASS_THRESHOLD) {
                window.dispatchEvent(new CustomEvent('asr:passed'));
                $hint.textContent = `👍 Khớp ${pm}% — Lần này đã được tính vào chỉ tiêu luyện nói.`;
            }
        }

        // ====== WAV fallback (no Web Speech) ======
        let mr, chunks = [], mime = 'audio/webm';
        async function startRecordFallback() {
            const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
            mr = new MediaRecorder(stream);
            mime = mr.mimeType || 'audio/webm';
            chunks = [];
            mr.ondataavailable = e => { if (e.data.size > 0) chunks.push(e.data); };
            mr.onstop = async () => {
                const blob = new Blob(chunks, { type: mime });
                const fd = new FormData();
                fd.append('audio', blob, 'audio.webm');
                fd.append('target', $target.value || '');
                try {
                    const res = await fetch('@Url.Content("~/Asr/Assess")', { method: 'POST', body: fd });
                    if (!res.ok) { $hint.textContent = 'Server ASR lỗi: ' + res.status; return; }
                    const data = await res.json();
                    // data.transcript, data.moraCount, data.moraSeq, data.longVowel, data.matchPercent
                    $recog.textContent = data.transcript || '—';
                    $moraCount.textContent = 'Mora: ' + (data.moraCount ?? '—');
                    $choon.textContent = 'Trường âm: ' + (data.longVowel ? 'Có' : 'Không');
                    $moraSeq.textContent = (data.moraSeq && data.moraSeq.length) ? data.moraSeq.join('・') : '—';
                    $match.textContent = 'Khớp mẫu: ' + ((data.matchPercent != null) ? (data.matchPercent + '%') : '—');

                    // >>>> NẾU ĐẠT NGƯỠNG THÌ BẮN SỰ KIỆN ĐỂ LƯU TIẾN ĐỘ & CHỈ TIÊU TUẦN <<<<
                    const mp = data.matchPercent ?? 0;
                    if (mp >= PASS_THRESHOLD) {
                        window.dispatchEvent(new CustomEvent('asr:passed'));
                        $hint.textContent = `👍 Khớp ${mp}% — Lần này đã được tính vào chỉ tiêu luyện nói.`;
                    } else {
                        $hint.textContent = `Khớp ${mp}% — Cố gắng đọc gần giống câu mẫu hơn nhé.`;
                    }

                } catch (e) {
                    console.error(e);
                    $hint.textContent = 'Gửi server thất bại.';
                }
            };
            mr.start();
        }
        function stopRecordFallback() {
            if (mr && mr.state !== 'inactive') mr.stop();
        }

        // ====== Events ======
        document.getElementById('asrRecBtn').addEventListener('click', async () => {
            $rec.disabled = true; $stop.disabled = false;
            $hint.textContent = SR ? 'Đang nghe… Hãy nói rõ ràng.' : 'Đang ghi âm (fallback)…';
            await startMeter();
            if (recog) { try { recog.start(); } catch { } }
            else { await startRecordFallback(); }
        });
        document.getElementById('asrStopBtn').addEventListener('click', () => {
            $rec.disabled = false; $stop.disabled = true;
            stopMeter();
            if (recog) { try { recog.stop(); } catch { } }
            else { stopRecordFallback(); }
        });

        // TTS (nhắc mẫu)
        document.getElementById('asrSpeakBtn').addEventListener('click', () => {
            const u = new SpeechSynthesisUtterance(($target.value || '').trim() || 'こんにちは');
            u.lang = 'ja-JP'; u.rate = 1.0; u.pitch = 1.0;
            window.speechSynthesis.cancel(); window.speechSynthesis.speak(u);
        });
    })();
</script>
