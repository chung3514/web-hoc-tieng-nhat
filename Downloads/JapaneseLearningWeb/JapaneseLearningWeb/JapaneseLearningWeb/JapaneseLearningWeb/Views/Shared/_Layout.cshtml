@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery Xsrf
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Học Tiếng Nhật</title>

    <meta name="request-verification-token"
          content="@Xsrf.GetAndStoreTokens(Context).RequestToken" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700&family=Roboto:wght@400;500&display=swap" rel="stylesheet">

    <style>
        html, body { height: 100%; }

        body {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            font-family: 'Roboto', sans-serif;
            background: linear-gradient(120deg, #f8f9fa 0%, #ffe3e3 100%);
            margin: 0;
        }

        /* ===== GIỚI HẠN CHIỀU RỘNG (GIỐNG RIKI) ===== */
        .page-wrapper {
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 20px;
            width: 100%;
        }

        .main-container {
            flex: 1 0 auto;
        }

        .row.main-layout-row {
            min-height: 600px;
        }

        /* ===== NAVBAR ===== */
        .navbar-custom {
            background: #fff;
            border-bottom: 2px solid #17b6b7;
        }

        .navbar-custom .navbar-brand {
            font-family: 'Montserrat', sans-serif;
            font-size: 2rem;
            font-weight: 700;
            color: #17b6b7 !important;
        }

        .navbar-custom .nav-link {
            color: #444;
            font-weight: 500;
            font-size: 1.05rem;
            padding: 8px 16px !important;
            border-radius: 10px;
        }

        .navbar-custom .nav-link:hover {
            background: #e3f7fb;
            color: #17b6b7 !important;
        }

        /* ===== SIDEBAR ===== */
        .sidebar-custom {
            background: #fff;
            border-radius: 18px;
            box-shadow: 0 2px 16px rgba(23,182,183,0.07);
            padding: 24px 18px;
            height: 100%;
        }

        .sidebar-title {
            color: #17b6b7;
            font-size: 1.16rem;
            font-family: 'Montserrat', sans-serif;
            font-weight: 700;
            margin-bottom: 14px;
        }

        .sidebar-custom .nav-link {
            color: #444;
            font-size: 1.05rem;
            border-radius: 8px;
            margin-bottom: 6px;
            padding: 7px 10px;
            display: flex;
            align-items: center;
        }

        .sidebar-custom .nav-link:hover,
        .sidebar-custom .nav-link.active {
            background: #e3f7fb;
            color: #17b6b7;
            font-weight: 700;
        }

        .sidebar-custom .nav-link i { width: 22px; }

        /* ===== MAIN ===== */
        main {
            background: #fff;
            border-radius: 22px;
            box-shadow: 0 2px 16px rgba(23,182,183,0.07);
            padding: 36px;
            min-height: 500px;
        }

        /* ===== FOOTER ===== */
        footer.custom-footer {
            background-color: #f8f9fa;
            border-top: 1px solid #ddd;
            text-align: center;
            font-size: 0.95rem;
            color: #666;
            padding: 16px 0;
            margin-top: 40px;
        }

        /* ===== AI CHAT (GIỮ NGUYÊN) ===== */
        .ai-chat-fab {
            position: fixed;
            right: 24px;
            bottom: 24px;
            width: 54px;
            height: 54px;
            border-radius: 50%;
            z-index: 1050;
        }

        .ai-chat-widget {
            position: fixed;
            right: 24px;
            bottom: 90px;
            width: 380px;
            height: 520px;
            display: none;
            background: #fff;
            border-radius: 14px;
            border: 1px solid rgba(0,0,0,.1);
            z-index: 1051;
        }

        .ai-chat-header {
            height: 52px;
            background: #e3f7fb;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 8px 12px;
            border-bottom: 1px solid rgba(0,0,0,.08);
        }

        .ai-chat-body {
            height: calc(100% - 52px - 82px);
            overflow-y: auto;
            padding: 12px;
            background: #fafafa;
        }

        .ai-chat-input {
            padding: 10px;
            border-top: 1px solid rgba(0,0,0,.08);
        }

        .ai-msg { display: flex; margin-bottom: 8px; }
        .ai-msg-user { justify-content: flex-end; }
        .ai-msg-bot { justify-content: flex-start; }

        .ai-bubble {
            max-width: 85%;
            padding: 10px 12px;
            border-radius: 12px;
            background: #fff;
            border: 1px solid rgba(0,0,0,.08);
            white-space: pre-wrap;
        }

        .ai-msg-user .ai-bubble {
            background: #e3f7fb;
            border-color: rgba(23,182,183,.3);
        }
    </style>

    @RenderSection("Styles", required: false)
</head>
<body>

    <!-- ===== NAVBAR ===== -->
    <nav class="navbar navbar-expand-lg navbar-light navbar-custom">
        <div class="page-wrapper d-flex align-items-center">
            <a class="navbar-brand me-4" href="/">
                <i class="fas fa-language me-2"></i> Học Tiếng Nhật
            </a>

            <div class="collapse navbar-collapse show">
                <ul class="navbar-nav ms-auto">
                    @if (!User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item"><a class="nav-link" href="/Home/Login">Đăng nhập</a></li>
                        <li class="nav-item"><a class="nav-link" href="/Home/Register">Đăng ký</a></li>
                    }
                    else
                    {
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="/Admin/UserManagement">
                                    Quản lý người dùng
                                </a>
                            </li>
                        }
                        <li class="nav-item"><a class="nav-link" href="/Account/Profile">Hồ sơ</a></li>
                        <li class="nav-item"><a class="nav-link" href="/Account/MyCourses">Khóa học</a></li>
                        <li class="nav-item">
                            <form method="post" action="/Home/Logout">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="nav-link btn btn-link">Đăng xuất</button>
                            </form>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- ===== BODY ===== -->
    <div class="main-container page-wrapper mt-4">
        <div class="row main-layout-row g-4">
            <aside class="col-lg-3">
                <nav class="sidebar-custom">
                    <div class="sidebar-title"><i class="fas fa-book-open"></i> Học tập</div>
                    <a class="nav-link" href="/Vocabularies/Index">Từ vựng</a>
                    <a class="nav-link" href="/Grammars/Index">Ngữ pháp</a>
                    <a class="nav-link" href="/Kanjis/Index">Kanji</a>
                    <a class="nav-link" href="/KanjiRadical/Index">Bộ</a>
                    <a class="nav-link" href="/Lessons/Index">Bài học</a>
                    <a class="nav-link" href="/Courses/Index">Khóa học</a>
                    <a class="nav-link" href="/Categories/Index">Danh mục</a>
                </nav>
            </aside>

            <main class="col-lg-9">
                @RenderBody()
            </main>
        </div>
    </div>

    <footer class="custom-footer">
        &copy; @DateTime.Now.Year - JapaneseLearningWeb
    </footer>

    <!-- ===== AI CHAT ===== -->
    <div id="aiChatWidget" class="ai-chat-widget shadow">
        <div class="ai-chat-header">
            <strong><i class="fa-solid fa-robot"></i> Trợ lý AI</strong>
            <button class="btn btn-sm btn-light" id="aiChatMinBtn"><i class="fa-solid fa-chevron-down"></i></button>
        </div>
        <div id="aiChatBody" class="ai-chat-body">
            <div class="ai-msg ai-msg-bot">
                <div class="ai-bubble">Xin chào! Hỏi mình về tiếng Nhật N5 nhé 🇯🇵</div>
            </div>
        </div>
        <div class="ai-chat-input">
            <div class="input-group">
                <input id="aiChatInput" class="form-control" placeholder="Nhập câu hỏi..." />
                <button id="aiChatSendBtn" class="btn btn-primary"><i class="fa-solid fa-paper-plane"></i></button>
            </div>
        </div>
    </div>

    <button id="aiChatFab" class="ai-chat-fab btn btn-primary">
        <i class="fa-solid fa-robot"></i>
    </button>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        (function () {
            if (window.__AI_INIT__) return;
            window.__AI_INIT__ = true;

            const AI_ENDPOINT = '@Url.Content("~/api/ai/translate")';
            const $fab = document.getElementById('aiChatFab');
            const $widget = document.getElementById('aiChatWidget');
            const $body = document.getElementById('aiChatBody');
            const $input = document.getElementById('aiChatInput');
            const $send = document.getElementById('aiChatSendBtn');
            const $min = document.getElementById('aiChatMinBtn');

            function bubble(text, who) {
                const row = document.createElement('div');
                row.className = `ai-msg ai-msg-${who}`;
                const b = document.createElement('div');
                b.className = 'ai-bubble';
                b.innerHTML = (text || '')
                    .replace(/\*\*/g, '')
                    .replace(/\*/g, '')
                    .replace(/\n/g, '<br>');
                row.appendChild(b);
                $body.appendChild(row);
                $body.scrollTop = $body.scrollHeight;
            }

                    async function send() {
            const text = $input.value.trim();
            if (!text) return;

            $input.value = '';
            bubble(text, 'user');

            try {
                const res = await fetch('/api/ai/chat', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken':
                            document.querySelector('meta[name="request-verification-token"]')?.content
                    },
                    body: JSON.stringify({
                        message: text,
                        level: 'N5'
                    })
                });

                if (!res.ok) throw new Error(res.status);

                const data = await res.json();
                bubble(data.reply, 'bot');
            }
            catch (err) {
                bubble('⚠️ Không gọi được AI.', 'bot');
                console.error(err);
            }
        }


            $fab.onclick = () => $widget.style.display = $widget.style.display === 'block' ? 'none' : 'block';
            $min.onclick = () => $widget.style.display = 'none';
            $send.onclick = send;
            $input.onkeydown = e => { if (e.key === 'Enter') { e.preventDefault(); send(); } };
        })();
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
