@* @model JapaneseLearningWeb.Models.MoMo.MomoExecuteResponseModel

@{
    var currentUrl = Context.Request?.Path + Context.Request?.QueryString;
    var isSuccess = !currentUrl.ToString().Contains("message=Bad", StringComparison.OrdinalIgnoreCase);
    ViewData["Title"] = isSuccess ? "Kết quả thanh toán thành công" : "Thanh toán thất bại";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded-4 mx-auto" style="max-width: 700px;">
        <div class="card-body text-center p-5">
            @if (isSuccess)
            {
                <div class="text-success mb-3">
                    <i class="bi bi-check-circle-fill" style="font-size: 3rem;"></i>
                    <h3 class="mt-3">Thanh toán thành công</h3>
                </div>
            }
            else
            {
                <div class="text-danger mb-3">
                    <i class="bi bi-x-circle-fill" style="font-size: 3rem;"></i>
                    <h3 class="mt-3">Thanh toán thất bại</h3>
                </div>
            }

            <table class="table table-bordered mt-4 text-start">
                <tbody>
                    <tr>
                        <th scope="row" style="width: 40%;">Họ tên</th>
                        <td>@Model.FullName</td>
                    </tr>
                    <tr>
                        <th scope="row">Mã đơn hàng</th>
                        <td>@Model.OrderId</td>
                    </tr>
                    <tr>
                        <th scope="row">Thông tin đơn hàng</th>
                        <td>@Model.OrderInfo</td>
                    </tr>
                    <tr>
                        <th scope="row">Tổng tiền</th>
                        <td><strong>@Model.Amount ₫</strong></td>
                    </tr>
                    <tr>
                        <th scope="row">User ID (localStorage)</th>
                        <td id="userIdDisplay">Đang kiểm tra...</td>
                    </tr>
                    <tr>
                        <th scope="row">Course ID (localStorage)</th>
                        <td id="courseIdsDisplay">Đang kiểm tra...</td>
                    </tr>
                    <tr>
                        <th scope="row">Kết quả lưu</th>
                        <td id="confirmStatus" class="fw-bold text-primary">Đang xử lý...</td>
                    </tr>
                </tbody>
            </table>

            <div class="mt-4">
                <a asp-controller="Account" asp-action="History" class="btn btn-outline-primary btn-lg">
                    <i class="bi bi-clock-history me-2"></i> Xem lịch sử đơn hàng
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", async () => {
        const url = window.location.href;
        if (url.includes("message=Bad")) {
            document.getElementById("confirmStatus").innerText = "Giao dịch thất bại - không lưu khóa học.";
            return;
        }

        const userId = localStorage.getItem("userId");
        const courseIds = JSON.parse(localStorage.getItem("selectedCourseIds") || "[]");

        document.getElementById("userIdDisplay").innerText = userId || "Không có";
        document.getElementById("courseIdsDisplay").innerText = courseIds.length > 0 ? courseIds.join(", ") : "Không có";

        if (!userId || courseIds.length === 0) {
            document.getElementById("confirmStatus").innerText = "Thiếu thông tin để xác nhận.";
            return;
        }

        try {
            const response = await fetch("/Account/ConfirmPaidCourses", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({
                    userId: userId,
                    paidCourseIds: courseIds
                })
            });

            if (response.ok) {
                document.getElementById("confirmStatus").innerText = "Đã lưu khóa học thành công!";
                localStorage.removeItem("selectedCourseIds");
            } else {
                document.getElementById("confirmStatus").innerText = "Lỗi khi lưu khóa học.";
            }
        } catch (error) {
            console.error("Lỗi khi gửi request xác nhận:", error);
            document.getElementById("confirmStatus").innerText = "Gặp lỗi kỹ thuật.";
        }
    });
</script>
 *@
 @model JapaneseLearningWeb.Models.MoMo.MomoExecuteResponseModel

@{
    var currentUrl = Context.Request?.Path + Context.Request?.QueryString;
    var isSuccess = !currentUrl.ToString().Contains("message=Bad", StringComparison.OrdinalIgnoreCase);
    ViewData["Title"] = isSuccess ? "Kết quả thanh toán thành công" : "Thanh toán thất bại";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded-4 mx-auto" style="max-width: 700px;">
        <div class="card-body text-center p-5">
            @if (isSuccess)
            {
                <div class="text-success mb-3">
                    <i class="bi bi-check-circle-fill" style="font-size: 3rem;"></i>
                    <h3 class="mt-3">Thanh toán thành công</h3>
                </div>
            }
            else
            {
                <div class="text-danger mb-3">
                    <i class="bi bi-x-circle-fill" style="font-size: 3rem;"></i>
                    <h3 class="mt-3">Thanh toán thất bại</h3>
                </div>
            }

            <!-- Only Show Payment Result, No Additional Details -->
            <div class="mt-4">
                <a asp-controller="Account" asp-action="History" class="btn btn-outline-primary btn-lg">
                    <i class="bi bi-clock-history me-2"></i> Xem lịch sử đơn hàng
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", async () => {
        const url = window.location.href;
        if (url.includes("message=Bad")) {
            return; // Do nothing for failure case as we are already showing the error message above.
        }

        try {
            const userId = localStorage.getItem("userId");
            const courseIds = JSON.parse(localStorage.getItem("selectedCourseIds") || "[]");

            if (!userId || courseIds.length === 0) {
                return; // No need to process if essential information is missing.
            }

            const response = await fetch("/Account/ConfirmPaidCourses", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({
                    userId: userId,
                    paidCourseIds: courseIds
                })
            });

            // Optionally handle success/failure responses
            if (response.ok) {
                localStorage.removeItem("selectedCourseIds");
            }
        } catch (error) {
            console.error("Lỗi khi gửi request xác nhận:", error);
        }
    });
</script>
