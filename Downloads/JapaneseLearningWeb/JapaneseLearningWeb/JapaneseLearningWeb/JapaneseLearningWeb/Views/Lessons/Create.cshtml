@model JapaneseLearningWeb.Models.Lesson

@{
    ViewData["Title"] = "Tạo bài học mới";
}

@section Styles {
    <style>
        :root {
            --teal: #17b6b7;
            --teal-hover: #0ba0a1;
            --bg-soft: #f8fefe;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            background: var(--bg-soft);
            color: #334155;
            font-size: 14.5px;
            font-weight: 400;
        }

        .lesson-create-container {
            max-width: 900px;
            margin: 32px auto;
        }

        .card {
            border: none;
            border-radius: 20px;
            box-shadow: 0 6px 24px rgba(23,182,183,0.12);
        }

        .card-header {
            background: var(--teal);
            color: #fff;
            border-radius: 20px 20px 0 0;
            padding: 18px 24px;
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 1.2rem;
            font-weight: 600;
        }

        .card-body {
            padding: 28px;
        }

        .form-label {
            font-weight: 600;
            color: var(--teal);
            margin-bottom: 6px;
        }

        .form-control,
        .form-select,
        textarea.form-control {
            border-radius: 12px;
            padding: 10px 14px;
            font-size: 14.5px;
            border: 1.5px solid var(--teal);
            background: #fff;
        }

            .form-control:focus,
            .form-select:focus,
            textarea.form-control:focus {
                border-color: var(--teal-hover);
                box-shadow: 0 0 0 0.15rem rgba(23,182,183,.25);
            }

        .btn-primary {
            background: var(--teal);
            border: none;
            border-radius: 30px;
            padding: 10px 28px;
            font-weight: 600;
            font-size: 14.5px;
        }

            .btn-primary:hover {
                background: var(--teal-hover);
            }

        .btn-secondary {
            border-radius: 30px;
            padding: 10px 28px;
            font-weight: 600;
            font-size: 14.5px;
        }

        .alert-danger {
            font-size: 14px;
            font-weight: 500;
        }

        @@media (max-width: 576px) {
            .card-body {
                padding: 20px;
            }
        }
    </style>
}

<div class="lesson-create-container">
    <div class="card">

        <!-- HEADER -->
        <div class="card-header">
            <i class="fas fa-book-open"></i>
            Tạo bài học mới
        </div>

        <!-- BODY -->
        <div class="card-body">

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger mb-3">
                    @TempData["Error"]
                </div>
            }

            <form asp-action="Create" method="post" novalidate>
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- Tiêu đề -->
                <div class="mb-3">
                    <label asp-for="Title" class="form-label">Tiêu đề</label>
                    <input asp-for="Title" class="form-control" placeholder="Nhập tiêu đề bài học" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <!-- Nội dung -->
                <div class="mb-3">
                    <label asp-for="Content" class="form-label">Nội dung</label>
                    <textarea asp-for="Content" class="form-control" rows="6"
                              placeholder="Nhập nội dung chi tiết cho bài học"></textarea>
                    <span asp-validation-for="Content" class="text-danger"></span>
                </div>

                <!-- Khóa học -->
                <div class="mb-3">
                    <label asp-for="CourseId" class="form-label">Khóa học</label>
                    <select asp-for="CourseId"
                            class="form-select"
                            asp-items="@(ViewBag.Courses != null
                                ? new SelectList(ViewBag.Courses, "CourseId", "Title")
                                : Enumerable.Empty<SelectListItem>())">
                        <option value="">-- Chọn khóa học --</option>
                    </select>
                    <span asp-validation-for="CourseId" class="text-danger"></span>
                </div>

                <!-- Thứ tự -->
                <div class="mb-4">
                    <label asp-for="OrderInCourse" class="form-label">Thứ tự trong khóa học</label>
                    <input asp-for="OrderInCourse" type="number" min="1"
                           class="form-control"
                           placeholder="Ví dụ: 1" />
                    <span asp-validation-for="OrderInCourse" class="text-danger"></span>
                </div>

                <!-- ACTIONS -->
                <div class="d-flex justify-content-center gap-3">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i> Tạo
                    </button>

                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Quay lại
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
