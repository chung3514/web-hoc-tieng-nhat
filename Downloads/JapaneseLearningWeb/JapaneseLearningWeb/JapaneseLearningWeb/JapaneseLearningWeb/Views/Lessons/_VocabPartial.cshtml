@model IEnumerable<JapaneseLearningWeb.Models.Vocabulary>


@if (Model == null || !Model.Any())
{
	<p>Không có từ vựng nào trong bài học này.</p>
}
else
{
	<table class="table table-bordered table-striped table-sm">
		<thead class="table-info">
			<tr>
				<th>Kanji</th>
				<th>Hiragana</th>
				<th>Romaji</th>
				<th>Nghĩa</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var vocab in Model)
			{
				<tr>
					<td>@vocab.Kanji</td>
					<td>@vocab.Hiragana</td>
					<td>@vocab.Romaji</td>
					<td>@vocab.Meaning</td>
				</tr>
			}
		</tbody>
	</table>
}