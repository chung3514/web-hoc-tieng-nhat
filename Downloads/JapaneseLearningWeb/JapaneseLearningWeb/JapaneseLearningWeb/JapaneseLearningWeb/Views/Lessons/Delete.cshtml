@model JapaneseLearningWeb.Models.Lesson

@{
    ViewData["Title"] = "Xóa bài học";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="card shadow-sm border-0 rounded-4">

                <!-- HEADER -->
                <div class="card-header bg-teal text-white d-flex align-items-center gap-2">
                    <i class="fas fa-trash-alt fa-lg"></i>
                    <h3 class="card-title mb-0">Xóa bài học</h3>
                </div>

                <!-- BODY -->
                <div class="card-body">

                    <!-- WARNING -->
                    <div class="alert alert-warning" role="alert">
                        Bạn có chắc chắn muốn xóa bài học
                        <strong>@Model.Title</strong>?
                        Hành động này <strong>không thể hoàn tác</strong>.
                    </div>

                    <!-- INFO -->
                    <h4 class="text-teal mb-3">Thông tin bài học</h4>

                    <dl class="row">
                        <dt class="col-sm-4 text-muted">Lesson ID</dt>
                        <dd class="col-sm-8">@Model.LessonId</dd>

                        <dt class="col-sm-4 text-muted">Tiêu đề</dt>
                        <dd class="col-sm-8 fw-bold text-teal">@Model.Title</dd>

                        <dt class="col-sm-4 text-muted">Nội dung</dt>
                        <dd class="col-sm-8">@Model.Content</dd>

                        <dt class="col-sm-4 text-muted">Khóa học</dt>
                        <dd class="col-sm-8">
                            @(Model.Course?.Title ?? "Không có khóa học")
                        </dd>

                        <dt class="col-sm-4 text-muted">Thứ tự</dt>
                        <dd class="col-sm-8">@Model.OrderInCourse</dd>

                        <dt class="col-sm-4 text-muted">Ngày tạo</dt>
                        <dd class="col-sm-8">
                            @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                        </dd>
                    </dl>

                    <!-- ACTIONS -->
                    <form asp-action="Delete" method="post"
                          class="mt-4 d-flex justify-content-end gap-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="LessonId" />

                        <button type="submit" class="btn btn-teal px-4 fw-semibold">
                            <i class="fas fa-trash-alt me-1"></i> Xóa
                        </button>

                        <a asp-action="Index" class="btn btn-secondary px-4">
                            <i class="fas fa-arrow-left me-1"></i> Quay lại
                        </a>
                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

<style>
    :root {
        --teal: #17b6b7;
        --teal-hover: #0ba0a1;
    }

    .bg-teal {
        background: var(--teal) !important;
    }

    .text-teal {
        color: var(--teal) !important;
    }

    .btn-teal {
        background: var(--teal) !important;
        color: #fff !important;
        border: none;
        border-radius: 30px;
        font-weight: 600;
        transition: background .2s ease;
    }

        .btn-teal:hover,
        .btn-teal:focus {
            background: var(--teal-hover) !important;
            color: #fff !important;
        }

    .alert-warning {
        background-color: #ffe3e3;
        color: #b52c3b;
        border-color: #dc3545;
    }
</style>
