@model JapaneseLearningWeb.Models.Lesson

@{
    ViewData["Title"] = "Chỉnh sửa bài học";
}

<style>
    :root {
        --teal: #17b6b7;
        --teal-hover: #0ba0a1;
        --teal-light: #e0f7f7;
    }

    body {
        background-color: #f5fafa;
    }

    .edit-container {
        max-width: 900px;
        margin: 2rem auto;
    }

    /* CARD */
    .card {
        border-radius: 18px;
        border: none;
        box-shadow: 0 10px 28px rgba(23, 182, 183, 0.18);
        transition: transform .25s ease, box-shadow .25s ease;
    }

        .card:hover {
            transform: translateY(-4px);
            box-shadow: 0 14px 34px rgba(23, 182, 183, 0.28);
        }

    /* HEADER */
    .card-header {
        background-color: var(--teal);
        color: white;
        border-radius: 18px 18px 0 0;
        padding: 1.25rem 1.5rem;
        display: flex;
        align-items: center;
        gap: 12px;
        font-weight: 600;
    }

        .card-header h3 {
            margin: 0;
            font-weight: 700;
        }

    /* BODY */
    .card-body {
        background-color: var(--teal-light);
        padding: 2rem;
    }

    /* LABEL */
    .form-label {
        font-weight: 600;
        color: var(--teal);
    }

    /* INPUT / SELECT */
    .form-control,
    .form-select {
        border-radius: 10px;
        border: 1.5px solid var(--teal);
        background-color: #f6ffff;
        padding: 12px 14px;
        font-size: 1.05rem;
        transition: all 0.25s ease;
    }

        .form-control:focus,
        .form-select:focus {
            background-color: #ffffff;
            border-color: var(--teal-hover);
            box-shadow: 0 0 0 0.2rem rgba(23, 182, 183, 0.25);
            outline: none;
        }

    /* PRIMARY BUTTON */
    .btn-primary {
        background-color: var(--teal);
        border: none;
        border-radius: 30px;
        padding: 12px 36px;
        font-weight: 700;
        font-size: 1.15rem;
        box-shadow: 0 4px 14px rgba(23, 182, 183, 0.45);
        transition: all 0.3s ease;
    }

        .btn-primary:hover,
        .btn-primary:focus {
            background-color: var(--teal-hover);
            box-shadow: 0 6px 20px rgba(11, 160, 161, 0.65);
            color: white;
        }

    /* SECONDARY BUTTON */
    .btn-secondary {
        border-radius: 30px;
        padding: 12px 36px;
        font-weight: 700;
        font-size: 1.15rem;
        background-color: #6c757d;
        border: none;
        color: white;
        box-shadow: 0 4px 14px rgba(108, 117, 125, 0.35);
    }

        .btn-secondary:hover,
        .btn-secondary:focus {
            background-color: #565e64;
            color: white;
        }

    @@media (max-width: 576px) {
        .card-body {
            padding: 1.25rem;
        }
    }
</style>

<div class="edit-container">
    <div class="card">
        <!-- HEADER -->
        <div class="card-header">
            <i class="fas fa-edit fa-lg"></i>
            <h3>Chỉnh sửa bài học</h3>
        </div>

        <!-- BODY -->
        <div class="card-body">
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["Error"]
                </div>
            }

            <form asp-action="Edit" method="post" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="LessonId" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label">Tiêu đề bài học</label>
                    <input asp-for="Title" class="form-control"
                           placeholder="Nhập tiêu đề bài học" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Content" class="form-label">Nội dung bài học</label>
                    <textarea asp-for="Content" class="form-control" rows="8"
                              placeholder="Nhập nội dung chi tiết cho bài học"></textarea>
                    <span asp-validation-for="Content" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="CourseId" class="form-label">Khóa học</label>
                        <select asp-for="CourseId" class="form-select"
                                asp-items="@(new SelectList(ViewBag.Courses, "CourseId", "Title"))">
                            <option value="">-- Chọn khóa học --</option>
                        </select>
                        <span asp-validation-for="CourseId" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="OrderInCourse" class="form-label">Thứ tự trong khóa</label>
                        <input asp-for="OrderInCourse"
                               type="number"
                               min="1"
                               class="form-control"
                               placeholder="Ví dụ: 1" />
                        <span asp-validation-for="OrderInCourse" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="CreatedAt" class="form-label">Ngày tạo</label>
                    <input asp-for="CreatedAt" class="form-control" readonly />
                </div>

                <div class="d-flex justify-content-end gap-3">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i> Lưu
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Quay lại
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
