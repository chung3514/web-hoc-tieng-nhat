@model PagedListViewModel<JapaneseLearningWeb.Models.Lesson>

@{
    ViewData["Title"] = "Danh sách bài học";
    int currentPage = Model.PageNumber;
    int pageSize = Model.PageSize;
    int totalPages = Model.TotalPages;
    var courses = ViewBag.Courses as List<JapaneseLearningWeb.Models.Course>;
    int? selectedCourseId = ViewBag.SelectedCourseId as int?;
}

<style>
    /* ===== CHUẨN GIỐNG GRAMMAR ===== */

    .lesson-container {
        max-width: 1100px;
    }

    body {
        background: #f7fcfd !important;
    }

    .lesson-list-card {
        background: #fff;
        border-radius: 16px;
    }

    .lesson-header {
        background: #17b6b7 !important;
        color: #fff !important;
        border-radius: 16px 16px 0 0;
        font-weight: 700;
        font-size: 1.15rem;
    }

    .search-bar-lesson {
        background: #eafafc;
    }

    .lesson-item-card {
        background: #fcfdff;
        border-radius: 14px;
        min-height: 230px;
    }

    .card-title {
        font-size: 1.15rem;
        color: #17b6b7 !important;
    }

    .btn-outline-info,
    .btn-outline-warning,
    .btn-outline-danger {
        min-width: 80px;
        font-weight: 600;
        border-width: 2px;
    }

    .pagination .page-link {
        margin: 0 6px;
        border-radius: 10px;
        font-weight: 600;
    }

    .pagination .active .page-link {
        background: #17b6b7 !important;
        color: #fff !important;
        border: none;
    }

    @@media (max-width: 768px) {
        .lesson-item-card {
            min-height: 170px;
        }
    }
</style>

<div class="container lesson-container my-4">

    <!-- HEADER CARD -->
    <div class="card shadow-sm mb-4 lesson-list-card">
        <div class="card-header d-flex justify-content-between align-items-center lesson-header">
            <h5 class="mb-0">
                <i class="fas fa-chalkboard-teacher me-2"></i>@ViewData["Title"]
            </h5>

            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Create" class="btn btn-light btn-sm">
                    <i class="fas fa-plus-circle me-1"></i> Tạo bài học mới
                </a>
            }
        </div>
    </div>

    <!-- COURSE FILTER -->
    <form method="get" asp-action="Index" class="mb-4">
        <select name="courseId"
                class="form-select"
                onchange="this.form.submit()">
            <option value="">-- Chọn khóa học --</option>
            @foreach (var course in courses)
            {
                <option value="@course.CourseId"
                        selected="@(selectedCourseId == course.CourseId ? "selected" : null)">
                    @course.Title @(course.IsFree ? "(Miễn phí)" : "")
                </option>
            }
        </select>
    </form>

    @if (selectedCourseId != null)
    {
        <!-- SEARCH -->
        <form asp-action="Index" method="get" class="mb-4">
            <input type="hidden" name="courseId" value="@selectedCourseId" />

            <div class="input-group search-bar-lesson">
                <span class="input-group-text bg-white border-0">
                    <i class="fas fa-search text-info"></i>
                </span>
                <input type="text"
                       name="keyword"
                       value="@Model.Keyword"
                       class="form-control border-0"
                       placeholder="Tìm kiếm theo tiêu đề hoặc nội dung..." />
                <button type="submit" class="btn btn-info text-white">
                    Tìm kiếm
                </button>
            </div>
        </form>

        <!-- LESSON CARDS -->
        <div class="row g-4">
            @if (Model.Items.Any())
            {
                @foreach (var lesson in Model.Items)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 shadow-sm border-0 lesson-item-card">
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title text-center fw-semibold">
                                    @lesson.Title
                                </h5>

                                <div class="mb-2">
                                    <strong>Khóa học:</strong> @(lesson.Course?.Title ?? "—")
                                </div>

                                <div class="mb-3">
                                    <strong>Thứ tự:</strong> @lesson.OrderInCourse
                                </div>

                                <div class="mt-auto text-center">
                                    <a asp-action="Details"
                                       asp-route-id="@lesson.LessonId"
                                       class="btn btn-outline-info btn-sm">
                                        Chi tiết
                                    </a>

                                    @if (User.IsInRole("Admin") || User.IsInRole("Employee"))
                                    {
                                        <a asp-action="Edit"
                                           asp-route-id="@lesson.LessonId"
                                           class="btn btn-outline-warning btn-sm">
                                            Sửa
                                        </a>
                                    }

                                    @if (User.IsInRole("Admin"))
                                    {
                                        <a asp-action="Delete"
                                           asp-route-id="@lesson.LessonId"
                                           class="btn btn-outline-danger btn-sm">
                                            Xóa
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-5 text-muted">
                    Không tìm thấy bài học nào.
                </div>
            }
        </div>

        <!-- PAGINATION -->
        @if (totalPages > 1)
        {
            <nav class="mt-5">
                <ul class="pagination justify-content-center">
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link"
                               asp-route-courseId="@selectedCourseId"
                               asp-route-pageNumber="@i"
                               asp-route-pageSize="@pageSize"
                               asp-route-keyword="@Model.Keyword">
                                @i
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        }

        <div class="text-center mt-4 text-muted">
            Tổng cộng: @Model.TotalItems bài học
        </div>
    }
</div>
