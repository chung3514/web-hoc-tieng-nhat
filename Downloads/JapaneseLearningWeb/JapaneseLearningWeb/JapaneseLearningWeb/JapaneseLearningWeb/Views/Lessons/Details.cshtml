@model JapaneseLearningWeb.Models.Lesson

@{
    ViewData["Title"] = "Chi tiết bài học";
}

<style>
    :root {
        --teal: #17b6b7;
        --teal-bg: #e3f7fb;
        --teal-hover: #0ba0a1;
    }

    .lesson-detail-container {
        max-width: 1100px;
    }

    .card {
        border: none;
        border-radius: 16px;
        box-shadow: 0 4px 18px rgba(0,0,0,0.06);
    }

    .card-header {
        background: var(--teal);
        color: #fff;
        border-radius: 16px 16px 0 0;
        padding: 18px 24px;
    }

    .section-title {
        color: var(--teal);
        font-weight: 700;
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    dt {
        font-weight: 600;
        color: var(--teal);
    }

    .table thead th {
        background: #f8f9fa;
        font-weight: 600;
        font-size: 0.95rem;
    }

    .table tbody tr:hover {
        background: var(--teal-bg);
    }

    .btn-back {
        background: var(--teal);
        color: #fff;
        font-weight: 600;
        border-radius: 30px;
        padding: 8px 26px;
    }

        .btn-back:hover {
            background: var(--teal-hover);
            color: #fff;
        }
</style>

<div class="container lesson-detail-container my-4">
    <div class="card">

        <!-- HEADER -->
        <div class="card-header d-flex align-items-center gap-3">
            <i class="fas fa-file-alt fa-2x"></i>
            <h4 class="mb-0">Chi tiết bài học</h4>
        </div>

        <!-- BODY -->
        <div class="card-body">

            <!-- THÔNG TIN CHÍNH -->
            <div class="mb-5">
                <h5 class="section-title">
                    <i class="fas fa-info-circle"></i> Thông tin chính
                </h5>

                <dl class="row mb-0">
                    <dt class="col-sm-3">Lesson ID</dt>
                    <dd class="col-sm-9">@Model.LessonId</dd>

                    <dt class="col-sm-3">Tiêu đề</dt>
                    <dd class="col-sm-9 fw-semibold">@Model.Title</dd>

                    <dt class="col-sm-3">Nội dung</dt>
                    <dd class="col-sm-9">@Html.Raw(Model.Content)</dd>

                    <dt class="col-sm-3">Khóa học</dt>
                    <dd class="col-sm-9">@Model.Course?.Title ?? "Không có khóa học"</dd>

                    <dt class="col-sm-3">Thứ tự</dt>
                    <dd class="col-sm-9">@Model.OrderInCourse</dd>

                    <dt class="col-sm-3">Ngày tạo</dt>
                    <dd class="col-sm-9">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd>
                </dl>
            </div>

            <!-- KANJI -->
            <div class="mb-5">
                <h5 class="section-title">
                    <i class="fas fa-language"></i> Kanji
                </h5>

                @if (Model.Kanjis != null && Model.Kanjis.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>Kanji</th>
                                    <th>Âm On</th>
                                    <th>Âm Kun</th>
                                    <th>Nghĩa</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var k in Model.Kanjis)
                                {
                                    <tr>
                                        <td class="fw-bold text-danger fs-5">@k.Character</td>
                                        <td>@(string.IsNullOrEmpty(k.OnYomi) ? "—" : k.OnYomi)</td>
                                        <td>@(string.IsNullOrEmpty(k.KunYomi) ? "—" : k.KunYomi)</td>
                                        <td>@k.Meaning</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted fst-italic">Không có Kanji nào.</p>
                }
            </div>

            <!-- TỪ VỰNG -->
            <div class="mb-5">
                <h5 class="section-title">
                    <i class="fas fa-book-open"></i> Từ vựng
                </h5>

                @if (Model.Vocabularies != null && Model.Vocabularies.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>Kanji</th>
                                    <th>Hiragana</th>
                                    <th>Romaji</th>
                                    <th>Nghĩa</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var v in Model.Vocabularies)
                                {
                                    <tr>
                                        <td class="text-danger fw-semibold">@v.Kanji</td>
                                        <td>@v.Hiragana</td>
                                        <td>@v.Romaji</td>
                                        <td>@v.Meaning</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted fst-italic">Không có từ vựng nào.</p>
                }
            </div>

            <!-- NGỮ PHÁP -->
            <div>
                <h5 class="section-title">
                    <i class="fas fa-book-reader"></i> Ngữ pháp
                </h5>

                @if (Model.Grammars != null && Model.Grammars.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>Quy tắc</th>
                                    <th>Ví dụ</th>
                                    <th>Cấp độ</th>
                                    <th>Ghi chú</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var g in Model.Grammars)
                                {
                                    <tr>
                                        <td>@g.Rule</td>
                                        <td>@(string.IsNullOrEmpty(g.Example) ? "—" : g.Example)</td>
                                        <td>@(string.IsNullOrEmpty(g.Level) ? "—" : g.Level)</td>
                                        <td>@(string.IsNullOrEmpty(g.Notes) ? "—" : g.Notes)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted fst-italic">Không có ngữ pháp nào.</p>
                }
            </div>

        </div>

        <!-- FOOTER -->
        <div class="card-footer bg-white text-end">
            <a asp-action="Index" class="btn btn-back">
                <i class="fas fa-arrow-left me-1"></i> Quay lại danh sách
            </a>
        </div>
    </div>
</div>
