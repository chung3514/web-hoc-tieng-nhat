@model IEnumerable<JapaneseLearningWeb.Models.Course>

@{
    ViewData["Title"] = "Chọn khóa học";
}

<div class="container my-5">
    <h2 class="text-center text-info mb-4"><i class="fas fa-book-reader me-2"></i>Chọn một khóa học</h2>

    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var course in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 rounded-4">
                    <div class="card-body text-center">
                        <h5 class="card-title text-primary">@course.Title</h5>
                        <p class="card-text text-muted">@course.Description</p>
                        <a asp-action="Index" asp-route-courseId="@course.CourseId" class="btn btn-info text-white rounded-pill mt-2 px-4">
                            <i class="fas fa-arrow-right me-1"></i>Xem bài học
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
