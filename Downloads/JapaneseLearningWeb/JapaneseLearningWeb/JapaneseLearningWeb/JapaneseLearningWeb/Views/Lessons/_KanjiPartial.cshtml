@model IEnumerable<JapaneseLearningWeb.Models.Kanji>

@if (Model == null || !Model.Any())
{
    <p>Không có chữ Kanji nào trong bài học này.</p>
}
else
{
    <table class="table table-bordered table-striped table-sm">
        <thead class="table-warning">
            <tr>
                <th>Kanji</th>
                <th>Bộ thủ</th>
                <th>Âm On</th>
                <th>Âm Kun</th>
                <th>Ý nghĩa</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var k in Model)
            {
                var radicalInfoHtml = (k.KanjiKanjiRadicals != null && k.KanjiKanjiRadicals.Any())
                ? string.Join("<br>", k.KanjiKanjiRadicals.Select(r => $"{r.KanjiRadical.RadicalKanji} → {r.KanjiRadical.RadicalHanjaMeaning}"))
                : "Không có bộ thủ";

                <tr onclick="showKanjiDetail(
                                '@k.Character',
                                '@k.OnYomi',
                                '@k.KunYomi',
                                '@k.Meaning',
                                '@k.HanjaMeaning',
                                `@Html.Raw(radicalInfoHtml.Replace("`", "\\`"))`);"
                    style="cursor: pointer;">
                    <td class="text-center fs-4 text-primary">
                        @k.Character
                    </td>
                    <td>
                        @if (k.KanjiKanjiRadicals != null && k.KanjiKanjiRadicals.Any())
                        {
                            <ul class="mb-0">
                                @foreach (var item in k.KanjiKanjiRadicals)
                                {
                                    <li>
                                        <strong>@item.KanjiRadical.RadicalKanji</strong> →
                                        @item.KanjiRadical.RadicalHanjaMeaning
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <span>Không có bộ thủ</span>
                        }
                    </td>
                    <td>@k.OnYomi</td>
                    <td>@k.KunYomi</td>
                    <td>@k.Meaning</td>
                </tr>
            }
        </tbody>
    </table>
}

<hr />

<div id="kanjiDetail" style="display: none;">
    <h5>Thông tin chữ Kanji</h5>

    <p>
        <strong>Kanji:</strong>
        <span id="kanjiChar" class="fs-4 text-danger"></span> -
        <span id="kanjiHanjaMeaning"></span>
    </p>

    <p><strong>Ý nghĩa:</strong> <span id="kanjiMean"></span></p>
    <p><strong>Âm On:</strong> <span id="kanjiOn"></span></p>
    <p><strong>Âm Kun:</strong> <span id="kanjiKun"></span></p>
    <p>
        <strong>Bộ:</strong><br>
        <span id="kanjiRadicalInfo"></span>
    </p>

    <div class="p-2 border rounded text-center" style="min-width: 220px; background-color: #f9f9f9;">
        <h6 class="text-secondary mb-2">Cách viết</h6>

        <svg id="kanjiSvg" width="200" height="200"
             style="border: 1px solid #ccc; background: white; display: block; margin: auto;">
        </svg>

        <button class="btn btn-sm btn-outline-primary mt-2" onclick="resetStrokeAnimation()">
            🔁 Xem lại cách viết
        </button>
    </div>
</div>

