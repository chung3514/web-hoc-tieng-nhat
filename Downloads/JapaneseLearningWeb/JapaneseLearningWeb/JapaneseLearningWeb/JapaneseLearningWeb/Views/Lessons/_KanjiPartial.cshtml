<script>
    async function showKanjiDetail(character, on, kun, meaning, hanjaMeaning, radicalHtml) {
        document.getElementById("kanjiDetail").style.display = "block";
        document.getElementById("kanjiChar").innerText = character;
        document.getElementById("kanjiOn").innerText = on;
        document.getElementById("kanjiKun").innerText = kun;
        document.getElementById("kanjiMean").innerText = meaning;
        document.getElementById("kanjiHanjaMeaning").innerText = hanjaMeaning;
        document.getElementById("kanjiRadicalInfo").innerHTML = radicalHtml;

        const res = await fetch(`/KanjiStroke/GetStrokeData?character=${character}`);
        const json = await res.json();

        const svg = document.getElementById("kanjiSvg");
        svg.innerHTML = "";

        // Vẽ hai đường tâm để căn nét
        const centerLineH = document.createElementNS("http://www.w3.org/2000/svg", "line");
        centerLineH.setAttribute("x1", "0");
        centerLineH.setAttribute("y1", "100");
        centerLineH.setAttribute("x2", "200");
        centerLineH.setAttribute("y2", "100");
        centerLineH.setAttribute("stroke", "#ddd");
        centerLineH.setAttribute("stroke-width", "1");

        const centerLineV = document.createElementNS("http://www.w3.org/2000/svg", "line");
        centerLineV.setAttribute("x1", "100");
        centerLineV.setAttribute("y1", "0");
        centerLineV.setAttribute("x2", "100");
        centerLineV.setAttribute("y2", "200");
        centerLineV.setAttribute("stroke", "#ddd");
        centerLineV.setAttribute("stroke-width", "1");

        svg.appendChild(centerLineH);
        svg.appendChild(centerLineV);

        if (!json.success) {
            svg.innerHTML += "<text x='10' y='50' fill='red'>Không có dữ liệu nét viết.</text>";
            return;
        }

        const group = document.createElementNS("http://www.w3.org/2000/svg", "g");
        const textElements = [];

        json.data.strokes.forEach((stroke, index) => {
            const path = document.createElementNS("http://www.w3.org/2000/svg", "path");
            path.setAttribute("d", stroke.d);
            path.setAttribute("stroke", stroke.color || "#000");
            path.setAttribute("fill", "none");
            path.setAttribute("stroke-width", "2");
            path.setAttribute("stroke-linecap", "round");
            path.setAttribute("stroke-linejoin", "round");

            const length = path.getTotalLength();
            path.style.strokeDasharray = length;
            path.style.strokeDashoffset = length;
            path.style.transition = "stroke-dashoffset 0.6s ease";

            group.appendChild(path);

            const start = getStartPoint(stroke.d);
            const text = document.createElementNS("http://www.w3.org/2000/svg", "text");
            text.setAttribute("x", start.x);
            text.setAttribute("y", start.y);
            text.setAttribute("fill", "red");
            text.setAttribute("font-size", "5");
            text.setAttribute("font-family", "Arial");
            text.textContent = (index + 1).toString();

            text.style.opacity = "0"; // ẩn ban đầu
            group.appendChild(text);
            textElements.push(text);
        });

        svg.appendChild(group);

        // Căn nhóm stroke vào giữa SVG
        requestAnimationFrame(() => {
            const bbox = group.getBBox();
            const offsetX = 100 - (bbox.x + bbox.width / 2);
            const offsetY = 100 - (bbox.y + bbox.height / 2);
            group.setAttribute("transform", `translate(${offsetX}, ${offsetY})`);

            animateStrokes(group, textElements);
        });

        // Lưu tham chiếu để reset animation có thể dùng
        window.currentKanjiAnimation = { group, textElements };
    }

    function getStartPoint(d) {
        const match = d.match(/M\s*([\d.]+)[,\s]+([\d.]+)/i);
        if (match) {
            return {
                x: parseFloat(match[1]),
                y: parseFloat(match[2])
            };
        }
        return { x: 5, y: 5 };
    }

    function animateStrokes(group, textElements) {
        const paths = group.querySelectorAll("path");

        // Reset tất cả path
        paths.forEach(path => {
            const length = path.getTotalLength();
            path.style.transition = "none";
            path.style.strokeDasharray = length;
            path.style.strokeDashoffset = length;
        });

        // Ẩn số thứ tự
        textElements.forEach(t => t.style.opacity = "0");

        void group.offsetWidth; // force reflow

        // Chạy animation vẽ từng nét theo thứ tự
        let delay = 0;
        paths.forEach((path, i) => {
            setTimeout(() => {
                path.style.transition = "stroke-dashoffset 0.6s ease";
                path.style.strokeDashoffset = "0";

                // Hiện số thứ tự nét
                textElements[i].style.opacity = "1";
            }, delay);
            delay += 700;
        });
    }

    function resetStrokeAnimation() {
        if (window.currentKanjiAnimation) {
            const { group, textElements } = window.currentKanjiAnimation;
            animateStrokes(group, textElements);
        }
    }
</script>
